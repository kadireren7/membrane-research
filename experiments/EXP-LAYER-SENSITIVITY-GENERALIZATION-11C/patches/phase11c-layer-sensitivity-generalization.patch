+# ---------------------------------------------------------------------
+# Phase 11C: layer-sensitivity generalization (research)
+# ---------------------------------------------------------------------
+V11C_DIR = REPO_ROOT / "results" / "phase11" / "generalization"
+_V11C_CACHE = {}
+
