+def _load_v11c(name):
+	key = name
+	if key not in _V11C_CACHE:
+		path = V11C_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V11C_CACHE[key] = rows
+		else:
+			_V11C_CACHE[key] = json.loads(path.read_text())
+	return _V11C_CACHE[key]
+
+
+def _v11c_ablation_layers(raw_rows):
+	"""Returns the set of layer indices covered by ablate_layer_N rows."""
+	layers = set()
+	for row in raw_rows:
+		name = row.get("_config_name", "")
+		if name.startswith("ablate_layer_"):
+			layers.add(int(name.replace("ablate_layer_", "")))
+	return layers
+
+
+@check("Phase 11C: manifest.json exists, valid JSON, schema_version 1, "
+	"all 18 files listed actually exist")
