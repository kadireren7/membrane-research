+@check("Phase 11C: pareto.json's claimed Pareto-optimal sets are "
+	"independently reproducible (non-dominance recomputed from the raw "
+	"points, not just trusted)")
+def _c83():
+	pareto = _load_v11c("pareto.json")
+	points = pareto["all_points"]
+
+	def frontier(pts, quality_key, higher_is_better=True):
+		n = len(pts)
+		result = []
+		for i in range(n):
+			dominated = False
+			for j in range(n):
+				if j == i:
+					continue
+				bi, qi = pts[i]["bytes"], pts[i][quality_key]
+				bj, qj = pts[j]["bytes"], pts[j][quality_key]
+				if not higher_is_better:
+					qi, qj = -qi, -qj
+				if bj <= bi and qj >= qi and (bj < bi or qj > qi):
+					dominated = True
+					break
+			result.append(pts[i]["config"] if not dominated else None)
+		return {c for c in result if c is not None}
+
+	recomputed_top1 = frontier(points, "top1")
+	recomputed_rel_l2 = frontier(points, "rel_l2", higher_is_better=False)
+	claimed_top1 = set(pareto["pareto_by_top1"])
+	claimed_rel_l2 = set(pareto["pareto_by_rel_l2"])
+	bad = []
+	if recomputed_top1 != claimed_top1:
+		bad.append(f"top1 frontier mismatch: recomputed={recomputed_top1} vs claimed={claimed_top1}")
+	if recomputed_rel_l2 != claimed_rel_l2:
+		bad.append(f"rel_l2 frontier mismatch: recomputed={recomputed_rel_l2} vs claimed={claimed_rel_l2}")
+	return len(bad) == 0, "; ".join(bad) if bad else "both Pareto frontiers reproduce exactly from raw points"
