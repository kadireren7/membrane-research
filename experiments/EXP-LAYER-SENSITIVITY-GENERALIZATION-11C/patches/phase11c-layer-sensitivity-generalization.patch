+		return False, f"{V11C_DIR}/manifest.json does not exist"
+	m = _load_v11c("manifest.json")
+	bad = []
+	if m.get("schema_version") != 1:
+		bad.append(f"schema_version={m.get('schema_version')!r}")
+	for fname in m.get("files", {}):
+		if not (V11C_DIR / fname).exists():
+			bad.append(f"listed file missing: {fname}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(m.get('files', {}))} files listed, all present"
+
