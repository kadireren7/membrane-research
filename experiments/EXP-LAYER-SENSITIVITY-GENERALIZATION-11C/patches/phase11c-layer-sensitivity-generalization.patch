+#include "sensitivity_analysis.h"
+#include "mixed_layer_policy.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct s_idx_val
+{
+	double	val;
+	int32_t	idx;
+}	idx_val_t;
+
+static double	sqrt_(double x);
+
+static int	cmp_idx_val(const void *a, const void *b)
+{
+	double	da = ((const idx_val_t *)a)->val;
+	double	db = ((const idx_val_t *)b)->val;
+
+	if (da < db)
+		return (-1);
+	if (da > db)
+		return (1);
+	return (0);
+}
+
+/* Average-rank transform (1-indexed), ties share the mean of the
+ * positions they occupy -- the standard Spearman convention. */
+static int	rank_transform(const double *x, int32_t n, double *out_rank)
+{
+	idx_val_t	*sorted;
+	int32_t		i;
+	int32_t		j;
+	double		avg;
+
+	sorted = (idx_val_t *)malloc(sizeof(idx_val_t) * (size_t)n);
+	if (sorted == NULL)
+		return (0);
+	for (i = 0; i < n; i++)
+	{
+		sorted[i].val = x[i];
+		sorted[i].idx = i;
+	}
+	qsort(sorted, (size_t)n, sizeof(idx_val_t), cmp_idx_val);
+	i = 0;
+	while (i < n)
+	{
+		j = i;
+		while (j + 1 < n && sorted[j + 1].val == sorted[i].val)
+			j++;
+		avg = ((double)(i + 1) + (double)(j + 1)) / 2.0;
+		while (i <= j)
+		{
+			out_rank[sorted[i].idx] = avg;
+			i++;
+		}
+	}
+	free(sorted);
+	return (1);
+}
+
+static int	pearson(const double *a, const double *b, int32_t n, double *out)
+{
+	double	mean_a;
+	double	mean_b;
+	double	cov;
+	double	var_a;
+	double	var_b;
+	int32_t	i;
+
+	mean_a = 0.0;
+	mean_b = 0.0;
+	for (i = 0; i < n; i++)
+	{
+		mean_a += a[i];
+		mean_b += b[i];
+	}
+	mean_a /= n;
+	mean_b /= n;
+	cov = 0.0;
+	var_a = 0.0;
+	var_b = 0.0;
+	for (i = 0; i < n; i++)
+	{
+		cov += (a[i] - mean_a) * (b[i] - mean_b);
+		var_a += (a[i] - mean_a) * (a[i] - mean_a);
+		var_b += (b[i] - mean_b) * (b[i] - mean_b);
+	}
+	if (var_a <= 0.0 || var_b <= 0.0)
+		return (0);
+	*out = cov / (sqrt_(var_a) * sqrt_(var_b));
+	return (1);
+}
+
+/* Avoid pulling in <math.h> solely for sqrt() in a header-free way --
+ * this project's other llama-free modules already link libm
+ * transitively via the C++ tools, but this module stays pure C with
+ * no extra link requirement by using a tiny Newton's-method sqrt. */
+static double	sqrt_(double x)
+{
+	double	guess;
+	int		i;
+
+	if (x <= 0.0)
+		return (0.0);
+	guess = x;
+	i = 0;
+	while (i < 64)
+	{
+		guess = 0.5 * (guess + x / guess);
+		i++;
+	}
+	return (guess);
+}
+
+int	membrane_spearman_rho(const double *a, const double *b, int32_t n,
+		double *out)
+{
+	double	*rank_a;
+	double	*rank_b;
+	int		ok;
+
+	if (out == NULL)
+		return (0);
+	*out = 0.0;
+	if (a == NULL || b == NULL || n < 2)
+		return (0);
+	rank_a = (double *)malloc(sizeof(double) * (size_t)n);
+	rank_b = (double *)malloc(sizeof(double) * (size_t)n);
+	ok = rank_a != NULL && rank_b != NULL;
+	ok = ok && rank_transform(a, n, rank_a) && rank_transform(b, n, rank_b);
+	ok = ok && pearson(rank_a, rank_b, n, out);
+	free(rank_a);
+	free(rank_b);
+	return (ok);
+}
+
+int	membrane_kendall_tau(const double *a, const double *b, int32_t n,
+		double *out)
+{
+	int64_t	concordant;
+	int64_t	discordant;
+	int64_t	tied_a;
+	int64_t	tied_b;
+	int32_t	i;
+	int32_t	j;
+	double	da;
+	double	db;
+	double	denom;
+
+	if (out == NULL)
+		return (0);
+	*out = 0.0;
+	if (a == NULL || b == NULL || n < 2)
+		return (0);
+	concordant = 0;
+	discordant = 0;
+	tied_a = 0;
+	tied_b = 0;
+	i = 0;
+	while (i < n)
+	{
+		j = i + 1;
+		while (j < n)
+		{
+			da = a[i] - a[j];
+			db = b[i] - b[j];
+			if (da == 0.0 && db == 0.0)
+				; /* tied on both -- excluded from all three counts */
+			else if (da == 0.0)
+				tied_a++;
+			else if (db == 0.0)
+				tied_b++;
+			else if ((da > 0.0) == (db > 0.0))
+				concordant++;
+			else
+				discordant++;
+			j++;
+		}
+		i++;
+	}
+	denom = sqrt_((double)(concordant + discordant + tied_a))
+		* sqrt_((double)(concordant + discordant + tied_b));
+	if (denom <= 0.0)
+		return (0);
+	*out = (double)(concordant - discordant) / denom;
+	return (1);
+}
+
+int	membrane_normalized_depth(int32_t layer_index, int32_t n_layer,
+		double *out)
+{
+	double	v;
+
+	if (out == NULL)
+		return (0);
+	*out = 0.0;
+	if (n_layer <= 1 || layer_index < 0 || layer_index >= n_layer)
+		return (0);
+	v = (double)layer_index / (double)(n_layer - 1);
+	if (v < 0.0)
+		v = 0.0;
+	if (v > 1.0)
+		v = 1.0;
+	*out = v;
+	return (1);
+}
+
+static uint32_t	xorshift32(uint32_t *state)
+{
+	*state ^= *state << 13;
+	*state ^= *state >> 17;
+	*state ^= *state << 5;
+	return (*state);
+}
+
+int	membrane_deterministic_random_layers(uint32_t seed, int32_t n_layer,
+		int32_t q8_count, int *out_type_map, int32_t *scratch_indices)
+{
+	uint32_t	state;
+	int32_t		i;
+	int32_t		j;
+	int32_t		tmp;
+
+	if (out_type_map == NULL || scratch_indices == NULL || n_layer <= 0)
+		return (0);
+	if (q8_count < 0)
+		q8_count = 0;
+	if (q8_count > n_layer)
+		q8_count = n_layer;
+	state = seed == 0 ? 1u : seed;	/* xorshift32 is undefined at seed 0 */
+	i = 0;
+	while (i < n_layer)
+	{
+		scratch_indices[i] = i;
+		out_type_map[i] = MEMBRANE_MIXED_LAYER_Q5;
+		i++;
+	}
+	/* Partial Fisher-Yates: only need the first q8_count picks. */
+	i = 0;
+	while (i < q8_count)
+	{
+		j = i + (int32_t)(xorshift32(&state) % (uint32_t)(n_layer - i));
+		tmp = scratch_indices[i];
+		scratch_indices[i] = scratch_indices[j];
+		scratch_indices[j] = tmp;
+		out_type_map[scratch_indices[i]] = MEMBRANE_MIXED_LAYER_Q8;
+		i++;
+	}
+	return (1);
+}
+
+int	membrane_pareto_frontier(const uint64_t *bytes, const double *quality,
+		int32_t n, int *out_is_pareto)
+{
+	int32_t	i;
+	int32_t	j;
+	int		dominated;
+
+	if (bytes == NULL || quality == NULL || out_is_pareto == NULL || n <= 0)
+		return (0);
+	i = 0;
+	while (i < n)
+	{
+		dominated = 0;
+		j = 0;
+		while (j < n && !dominated)
+		{
+			if (j != i && bytes[j] <= bytes[i] && quality[j] >= quality[i]
+				&& (bytes[j] < bytes[i] || quality[j] > quality[i]))
+				dominated = 1;
+			j++;
+		}
+		out_is_pareto[i] = dominated ? 0 : 1;
+		i++;
+	}
+	return (1);
+}
diff --git a/tools/membrane-kv-mixed-layer/sensitivity_analysis.h b/tools/membrane-kv-mixed-layer/sensitivity_analysis.h
new file mode 100644
index 0000000..4f9b941
--- /dev/null
+++ b/tools/membrane-kv-mixed-layer/sensitivity_analysis.h
@@ -0,0 +1,83 @@
+#ifndef MEMBRANE_KV_MIXED_LAYER_SENSITIVITY_ANALYSIS_H
+# define MEMBRANE_KV_MIXED_LAYER_SENSITIVITY_ANALYSIS_H
+
+# include <stddef.h>
+# include <stdint.h>
+
+# ifdef __cplusplus
+extern "C" {
+# endif
+
+/*
+ * Phase 11C: llama-free (no ggml/llama header) pure arithmetic for
+ * analyzing per-layer sensitivity data already gathered by
+ * membrane-kv-mixed-layer (main.cpp) -- RESEARCH ONLY, experiment
+ * branch only. Every function here operates on plain double/int
+ * arrays the caller already has; none of it touches a model, a
+ * prompt, or a file.
+ */
+
+/*
+ * Spearman rank correlation of two equal-length real-valued series
+ * (e.g. per-layer sensitivity scores from two different prompts).
+ * Internally rank-transforms both series (average rank on ties) and
+ * computes Pearson correlation of the ranks -- the standard
+ * definition. n must be >= 2. Returns 1 (out set, in [-1, 1]) on
+ * success, 0 (out left at 0) for n < 2, NULL inputs, or a
+ * zero-variance series (undefined correlation, not silently reported
+ * as 0 or 1).
+ */
+int	membrane_spearman_rho(const double *a, const double *b, int32_t n,
+		double *out);
+
+/*
+ * Kendall's tau-b rank correlation (handles ties) of two equal-length
+ * real-valued series. Returns 1 (out set, in [-1, 1]) on success, 0
+ * (out left at 0) for n < 2, NULL inputs, or a degenerate (zero
+ * concordant+discordant+tied) comparison set.
+ */
+int	membrane_kendall_tau(const double *a, const double *b, int32_t n,
+		double *out);
+
+/*
+ * normalized_layer_position = layer_index / (n_layer - 1), the exact
+ * formula Section 11 specifies -- clamped to [0, 1] and rejecting a
+ * degenerate n_layer <= 1 (undefined depth for a single-layer model).
+ * Returns 1 (out set) on success, 0 otherwise.
+ */
+int	membrane_normalized_depth(int32_t layer_index, int32_t n_layer,
+		double *out);
+
+/*
+ * Deterministic seeded PRNG-based layer selection: fills out_type_map
+ * (n_layer entries) by choosing exactly q8_count DISTINCT layer
+ * indices for MEMBRANE_MIXED_LAYER_Q8 (see mixed_layer_policy.h),
+ * every other layer MEMBRANE_MIXED_LAYER_Q5 -- a Fisher-Yates partial
+ * shuffle driven by a plain xorshift32 PRNG seeded from `seed`, so
+ * identical (seed, n_layer, q8_count) inputs always produce an
+ * identical map (required for a reproducible "random" baseline, not
+ * a different one every run). q8_count is clamped to [0, n_layer].
+ * Returns 1 on success, 0 for n_layer <= 0 or a NULL out_type_map/
+ * scratch buffer.
+ */
+int	membrane_deterministic_random_layers(uint32_t seed, int32_t n_layer,
+		int32_t q8_count, int *out_type_map, int32_t *scratch_indices);
+
+/*
+ * Pareto non-dominance check over a set of (bytes, quality) points --
+ * quality is assumed HIGHER-IS-BETTER (e.g. top1_preservation, or a
+ * negated loss metric the caller already flipped). Point i is
+ * dominated iff some other point j in the same set has
+ * bytes[j] <= bytes[i] AND quality[j] >= quality[i], with at least
+ * one strict inequality. Fills out_is_pareto (n entries, 1 = non-
+ * dominated/on the frontier, 0 = dominated). Returns 1 on success, 0
+ * for n <= 0 or NULL inputs.
+ */
+int	membrane_pareto_frontier(const uint64_t *bytes, const double *quality,
+		int32_t n, int *out_is_pareto);
+
+# ifdef __cplusplus
+}
+# endif
+
+#endif
diff --git a/tools/membrane-kv-mixed-layer/test_sensitivity_analysis.c b/tools/membrane-kv-mixed-layer/test_sensitivity_analysis.c
new file mode 100644
index 0000000..987a0bd
--- /dev/null
+++ b/tools/membrane-kv-mixed-layer/test_sensitivity_analysis.c
@@ -0,0 +1,267 @@
+#include <string.h>
+
+#include "sensitivity_analysis.h"
+#include "mixed_layer_policy.h"
+#include "test_helpers.h"
+
+static void	test_spearman_perfect_positive(void)
+{
+	double	a[5] = {1, 2, 3, 4, 5};
+	double	b[5] = {10, 20, 30, 40, 50};
+	double	rho;
+
+	TEST_ASSERT(membrane_spearman_rho(a, b, 5, &rho) == 1,
+		"perfect positive correlation resolves");
+	TEST_ASSERT(rho > 0.999, "identical rank order gives rho ~= 1.0");
+}
+
+static void	test_spearman_perfect_negative(void)
+{
+	double	a[5] = {1, 2, 3, 4, 5};
+	double	b[5] = {50, 40, 30, 20, 10};
+	double	rho;
+
+	TEST_ASSERT(membrane_spearman_rho(a, b, 5, &rho) == 1,
+		"perfect negative correlation resolves");
+	TEST_ASSERT(rho < -0.999, "reversed rank order gives rho ~= -1.0");
+}
+
+static void	test_spearman_with_ties(void)
+{
+	double	a[6] = {1, 1, 2, 3, 3, 3};
+	double	b[6] = {1, 1, 2, 3, 3, 3};
+	double	rho;
+
+	TEST_ASSERT(membrane_spearman_rho(a, b, 6, &rho) == 1,
+		"tied values still resolve via average-rank transform");
+	TEST_ASSERT(rho > 0.999,
+		"identical series with ties still gives rho ~= 1.0");
+}
+
+static void	test_spearman_zero_variance_fails_closed(void)
+{
+	double	a[4] = {5, 5, 5, 5};
+	double	b[4] = {1, 2, 3, 4};
+	double	rho = -99.0;
+
+	TEST_ASSERT(membrane_spearman_rho(a, b, 4, &rho) == 0,
+		"a constant series has undefined correlation -- fails closed, "
+		"not silently 0 or 1");
+	TEST_ASSERT(rho == 0.0, "out is reset to 0.0 on failure");
+}
+
+static void	test_spearman_degenerate_inputs(void)
+{
+	double	a[2] = {1, 2};
+	double	rho;
+
+	TEST_ASSERT(membrane_spearman_rho(NULL, a, 2, &rho) == 0,
+		"NULL series fails closed");
+	TEST_ASSERT(membrane_spearman_rho(a, a, 1, &rho) == 0,
+		"n < 2 fails closed (correlation undefined)");
+	TEST_ASSERT(membrane_spearman_rho(a, a, 2, NULL) == 0,
+		"NULL out pointer fails closed, not a crash");
+}
+
+static void	test_kendall_perfect_positive(void)
+{
+	double	a[5] = {1, 2, 3, 4, 5};
+	double	b[5] = {10, 20, 30, 40, 50};
+	double	tau;
+
+	TEST_ASSERT(membrane_kendall_tau(a, b, 5, &tau) == 1,
+		"perfect positive concordance resolves");
+	TEST_ASSERT(tau > 0.999, "every pair concordant gives tau ~= 1.0");
+}
+
+static void	test_kendall_perfect_negative(void)
+{
+	double	a[5] = {1, 2, 3, 4, 5};
+	double	b[5] = {50, 40, 30, 20, 10};
+	double	tau;
+
+	TEST_ASSERT(membrane_kendall_tau(a, b, 5, &tau) == 1,
+		"perfect discordance resolves");
+	TEST_ASSERT(tau < -0.999, "every pair discordant gives tau ~= -1.0");
+}
+
+static void	test_kendall_no_relationship(void)
+{
+	/* A hand-picked series with an equal split of concordant and
+	 * discordant pairs -- tau should land near 0, not just "not 1". */
+	double	a[4] = {1, 2, 3, 4};
+	double	b[4] = {2, 1, 4, 3};
+	double	tau;
+
+	TEST_ASSERT(membrane_kendall_tau(a, b, 4, &tau) == 1,
+		"mixed concordance resolves");
+	TEST_ASSERT(tau > -0.5 && tau < 0.5,
+		"a roughly balanced concordant/discordant split gives a tau "
+		"well short of +-1");
+}
+
+static void	test_normalized_depth_endpoints(void)
+{
+	double	v;
+
+	TEST_ASSERT(membrane_normalized_depth(0, 30, &v) == 1,
+		"layer 0 resolves");
+	TEST_ASSERT(v == 0.0, "layer 0 of 30 has normalized depth 0.0");
+	TEST_ASSERT(membrane_normalized_depth(29, 30, &v) == 1,
+		"last layer resolves");
+	TEST_ASSERT(v == 1.0, "last layer of 30 has normalized depth 1.0");
+	TEST_ASSERT(membrane_normalized_depth(15, 31, &v) == 1,
+		"middle layer resolves");
+	TEST_ASSERT(v > 0.49 && v < 0.51,
+		"layer 15 of 31 (0-indexed) is close to the midpoint");
+}
+
+static void	test_normalized_depth_degenerate(void)
+{
+	double	v;
+
+	TEST_ASSERT(membrane_normalized_depth(0, 1, &v) == 0,
+		"a single-layer model has undefined depth -- fails closed");
+	TEST_ASSERT(membrane_normalized_depth(-1, 30, &v) == 0,
+		"a negative layer index fails closed");
+	TEST_ASSERT(membrane_normalized_depth(30, 30, &v) == 0,
+		"an out-of-range layer index (== n_layer) fails closed");
+}
+
+static void	test_deterministic_random_reproducible(void)
+{
+	int		map1[30];
+	int		map2[30];
+	int32_t	scratch[30];
+
+	TEST_ASSERT(membrane_deterministic_random_layers(42, 30, 15, map1,
+			scratch) == 1, "resolves for seed 42");
+	TEST_ASSERT(membrane_deterministic_random_layers(42, 30, 15, map2,
+			scratch) == 1, "resolves again for the same seed");
+	TEST_ASSERT(memcmp(map1, map2, sizeof(map1)) == 0,
+		"identical (seed, n_layer, q8_count) always produces an "
+		"identical map -- a real reproducible baseline, not a "
+		"different one every run");
+}
+
+static void	test_deterministic_random_different_seeds_differ(void)
+{
+	int		map1[30];
+	int		map2[30];
+	int32_t	scratch[30];
+	int		differs;
+	int		i;
+
+	membrane_deterministic_random_layers(1, 30, 15, map1, scratch);
+	membrane_deterministic_random_layers(2, 30, 15, map2, scratch);
+	differs = 0;
+	for (i = 0; i < 30; i++)
+		if (map1[i] != map2[i])
+			differs = 1;
+	TEST_ASSERT(differs, "different seeds produce different maps (not "
+		"a constant/degenerate generator)");
+}
+
+static void	test_deterministic_random_exact_q8_count(void)
+{
+	int		map[30];
+	int32_t	scratch[30];
+	int		q8;
+	int		i;
+
+	membrane_deterministic_random_layers(7, 30, 12, map, scratch);
+	q8 = 0;
+	for (i = 0; i < 30; i++)
+		if (map[i] == MEMBRANE_MIXED_LAYER_Q8)
+			q8++;
+	TEST_ASSERT(q8 == 12, "exactly the requested q8_count of layers "
+		"are marked Q8 -- no more, no fewer");
+}
+
+static void	test_deterministic_random_clamped_and_degenerate(void)
+{
+	int		map[10];
+	int32_t	scratch[10];
+
+	TEST_ASSERT(membrane_deterministic_random_layers(1, 10, 99, map,
+			scratch) == 1, "an over-large q8_count is clamped, not "
+		"rejected");
+	TEST_ASSERT(membrane_deterministic_random_layers(1, 0, 5, map,
+			scratch) == 0, "n_layer <= 0 fails closed");
+	TEST_ASSERT(membrane_deterministic_random_layers(1, 10, 5, NULL,
+			scratch) == 0, "NULL out_type_map fails closed");
+}
+
+static void	test_pareto_frontier_basic(void)
+{
+	/* Points: (bytes, quality) -- lower bytes and higher quality are
+	 * both better. Point 0 is dominated by point 1 (same quality,
+	 * fewer bytes doesn't exist here -- constructed so point 0 is
+	 * strictly worse on both axes than point 1). Point 2 is on the
+	 * frontier (cheapest). Point 3 is on the frontier (best quality). */
+	uint64_t	bytes[4] = {100, 80, 50, 120};
+	double		quality[4] = {0.5, 0.6, 0.4, 0.9};
+	int			is_pareto[4];
+
+	TEST_ASSERT(membrane_pareto_frontier(bytes, quality, 4, is_pareto)
+			== 1, "resolves");
+	TEST_ASSERT(is_pareto[0] == 0,
+		"point 0 (100 bytes, 0.5 quality) is dominated by point 1 "
+		"(80 bytes, 0.6 quality -- cheaper AND better)");
+	TEST_ASSERT(is_pareto[1] == 1,
+		"point 1 is non-dominated (nothing is both cheaper and at "
+		"least as good)");
+	TEST_ASSERT(is_pareto[2] == 1,
+		"point 2 (50 bytes, cheapest) is on the frontier");
+	TEST_ASSERT(is_pareto[3] == 1,
+		"point 3 (0.9 quality, best) is on the frontier despite "
+		"costing the most bytes");
+}
+
+static void	test_pareto_frontier_identical_points_both_survive(void)
+{
+	uint64_t	bytes[2] = {100, 100};
+	double		quality[2] = {0.5, 0.5};
+	int			is_pareto[2];
+
+	TEST_ASSERT(membrane_pareto_frontier(bytes, quality, 2, is_pareto)
+			== 1, "resolves");
+	TEST_ASSERT(is_pareto[0] == 1 && is_pareto[1] == 1,
+		"two identical points do not dominate each other (dominance "
+		"requires at least one STRICT improvement)");
+}
+
+static void	test_pareto_frontier_degenerate(void)
+{
+	uint64_t	bytes[1] = {10};
+	double		quality[1] = {0.5};
+	int			is_pareto[1];
+
+	TEST_ASSERT(membrane_pareto_frontier(NULL, quality, 1, is_pareto)
+			== 0, "NULL bytes fails closed");
+	TEST_ASSERT(membrane_pareto_frontier(bytes, quality, 0, is_pareto)
+			== 0, "n <= 0 fails closed");
+}
+
+int	main(void)
+{
+	test_spearman_perfect_positive();
+	test_spearman_perfect_negative();
+	test_spearman_with_ties();
+	test_spearman_zero_variance_fails_closed();
+	test_spearman_degenerate_inputs();
+	test_kendall_perfect_positive();
+	test_kendall_perfect_negative();
+	test_kendall_no_relationship();
+	test_normalized_depth_endpoints();
+	test_normalized_depth_degenerate();
+	test_deterministic_random_reproducible();
+	test_deterministic_random_different_seeds_differ();
+	test_deterministic_random_exact_q8_count();
+	test_deterministic_random_clamped_and_degenerate();
+	test_pareto_frontier_basic();
+	test_pareto_frontier_identical_points_both_survive();
+	test_pareto_frontier_degenerate();
+	printf("test_sensitivity_analysis: all tests passed\n");
+	return (0);
+}
