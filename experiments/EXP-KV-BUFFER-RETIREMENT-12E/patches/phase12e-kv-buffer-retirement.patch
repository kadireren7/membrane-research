+V12E_DIR = REPO_ROOT / "results" / "phase12" / "buffer-retirement"
+_V12E_CACHE = {}
+
+
+def _load_v12e(name):
+	key = name
+	if key not in _V12E_CACHE:
+		path = V12E_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V12E_CACHE[key] = rows
+		elif name.endswith(".txt"):
+			_V12E_CACHE[key] = path.read_text()
+		else:
+			_V12E_CACHE[key] = json.loads(path.read_text())
+	return _V12E_CACHE[key]
+
+
+@check("Phase 12E: manifest.json exists, valid JSON, schema_version 1, "
+	"lists every actual file in the directory (json/jsonl/txt, including "
+	"itself) and no others")
+def _c100():
+	if not (V12E_DIR / "manifest.json").exists():
+		return False, f"{V12E_DIR}/manifest.json does not exist"
+	m = _load_v12e("manifest.json")
+	bad = []
+	if m.get("schema_version") != 1:
+		bad.append(f"schema_version={m.get('schema_version')!r}")
+	listed = set(m.get("files", {}).keys())
+	actual = {p.name for p in V12E_DIR.glob("*") if p.suffix in (".json", ".jsonl", ".txt")}
+	if listed != actual:
+		bad.append(f"listed-vs-actual mismatch: missing={actual - listed}, extra={listed - actual}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(listed)} files listed, exact match with directory contents"
+
+
