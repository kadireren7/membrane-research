+	cpy_get_v_text = _load_v12e("raw_cpy_get_v_trace.txt")
+	bad = []
+	if "cache_v_l4" not in trace_text:
+		bad.append("raw_failing_tensor_trace_excerpt.txt does not contain 'cache_v_l4'")
+	if len(trace_text.strip().splitlines()) < 10:
+		bad.append("raw_failing_tensor_trace_excerpt.txt suspiciously short")
+	if "bufname=CPU" not in cpy_get_v_text or "bufname=Vulkan1" not in cpy_get_v_text:
+		bad.append("raw_cpy_get_v_trace.txt does not show both a CPU and a Vulkan1 placement (expected: prompt on CPU, post-relocation-1 on GPU)")
+	n_calls = len([l for l in cpy_get_v_text.splitlines() if l.strip()])
+	if n_calls < 2:
+		bad.append(f"only {n_calls} cpy_v/get_v trace lines, expected multiple")
+	return len(bad) == 0, "; ".join(bad) if bad else "failing_tensor_trace.json's raw evidence is present, non-empty, and contains the claimed tensor/placement transition"
+
