++bool llama_kv_cache::retire_layer_backing(int32_t il) {
++    const auto it = map_layer_ids.find(il);
++    if (it == map_layer_ids.end()) {
++        return false;
++    }
++    const int32_t ikv = it->second;
++
++    const auto pit = pending_retirement.find(ikv);
++    if (pit == pending_retirement.end()) {
++        return false;
++    }
++    ggml_backend_buffer_t old_buf = pit->second;
++
++    bool old_buf_still_referenced = false;
++    for (const auto & other_layer : layers) {
++        if (other_layer.k->buffer == old_buf || (other_layer.v && other_layer.v->buffer == old_buf)) {
++            old_buf_still_referenced = true;
++            break;
++        }
++    }
++    if (old_buf_still_referenced) {
++        return false; // fail closed -- never free a buffer still in use
++    }
++
++    bool freed = false;
++    for (auto jt = ctxs_bufs.begin(); jt != ctxs_bufs.end(); ++jt) {
++        if (jt->second.get() == old_buf) {
++            ctxs_bufs.erase(jt);
++            freed = true;
++            break;
++        }
++    }
++    pending_retirement.erase(pit);
++    return freed;
++}
