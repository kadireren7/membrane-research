+	if b.get("explicit_q8", {}).get("exit_code") != 5:
+		bad.append(f"explicit_q8 exit_code={b.get('explicit_q8', {}).get('exit_code')!r}, expected 5")
+	if b.get("adaptive", {}).get("selected_kv") != "q5":
+		bad.append(f"adaptive selected_kv={b.get('adaptive', {}).get('selected_kv')!r}, expected q5")
