@@ -0,0 +1,57 @@
+#ifndef MEMBRANE_KV_CONSTRAINED_POLICY_SIM_H
+# define MEMBRANE_KV_CONSTRAINED_POLICY_SIM_H
+
+# include <stdint.h>
+
+# ifdef __cplusplus
+extern "C" {
+# endif
+
+/*
+ * Phase 11E, Section 21/23: llama-free (no ggml/llama header) pure
+ * arithmetic for the OFFLINE, research-only Q8 -> mixed -> Q5 -> fail
+ * hierarchy simulation and the Q8-layer-count boundary search this
+ * phase used. RESEARCH ONLY -- never linked into membrane-run;
+ * product --kv adaptive (tools/membrane-run/adaptive_kv_policy.*) is
+ * untouched by this phase and this module.
+ */
+
+# define MEMBRANE_CONSTRAINED_MODE_Q8			0
+# define MEMBRANE_CONSTRAINED_MODE_MIXED		1
+# define MEMBRANE_CONSTRAINED_MODE_Q5			2
+# define MEMBRANE_CONSTRAINED_MODE_FAIL_CLOSED	3
+
+/*
+ * Mirrors results/phase11/constrained-mixed-vs-q5/future_policy_
+ * simulation.json's policy_pseudocode exactly:
+ *   if Q8 full-resides: Q8
+ *   elif mixed profile available and safe: mixed
+ *   elif Q5 safe: Q5
+ *   else: fail closed
+ * profile_available must be 0 whenever the caller has no validated
+ * profile for this model -- mixed is never selected without one
+ * (Section 22: missing/wrong profile fails closed, never silently
+ * falls back to a naive layout).
+ */
+int	membrane_constrained_policy_select(int q8_full_resides,
+		int profile_available, int mixed_safe, int q5_safe);
+
+/*
+ * Section 5's boundary search, generalized: given a list of
+ * (q8_count, succeeded) pairs NOT necessarily sorted or contiguous,
+ * finds the largest q8_count with succeeded=1 such that every
+ * smaller tested q8_count in the list also succeeded (a monotonic
+ * safe boundary). Returns 1 and sets *out_boundary if the list is
+ * well-formed and monotonic (once a count fails, no larger tested
+ * count is recorded as succeeding); returns 0 (fails closed, *out_
+ * boundary set to -1) if the data is non-monotonic (a real anomaly
+ * worth flagging, not silently averaged over) or n_entries <= 0.
+ */
+int	membrane_safe_q8_count_boundary(const int32_t *q8_counts,
+		const int *succeeded, int n_entries, int32_t *out_boundary);
+
+# ifdef __cplusplus
+}
+# endif
+
+#endif
