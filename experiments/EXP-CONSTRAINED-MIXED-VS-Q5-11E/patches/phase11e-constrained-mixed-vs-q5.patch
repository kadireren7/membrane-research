+def _load_v11e(name):
+	key = name
+	if key not in _V11E_CACHE:
+		path = V11E_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V11E_CACHE[key] = rows
+		else:
+			_V11E_CACHE[key] = json.loads(path.read_text())
+	return _V11E_CACHE[key]
+
