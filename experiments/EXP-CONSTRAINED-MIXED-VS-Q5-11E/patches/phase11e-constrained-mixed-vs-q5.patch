+++ b/tools/membrane-kv-mixed-layer/sequential_compare.cpp
@@ -0,0 +1,547 @@
+/*
+ * Phase 11E, Section 9: sequential (never-two-contexts) quality
+ * comparison for regimes where even a single F16 reference context
+ * cannot safely fit (Point B's ctx=180000 -- an F16 KV cache there
+ * would need roughly 2x Q8's bytes, which already fails). The
+ * existing membrane-kv-mixed-layer probe holds ref_ctx (F16) and
+ * cand_ctx open SIMULTANEOUSLY in one process -- safe at Phase 11B/
+ * 11C's smaller test contexts, unsafe here.
+ *
+ * This tool splits that into two SEPARATE process invocations, never
+ * holding more than one context at a time:
+ *
+ *   --mode dump: creates ONE context (a whole-cache reference config,
+ *     e.g. Q5_1 -- the real product fallback this phase is measuring
+ *     against, NOT F16/Q8 which cannot fit at Point B), free-runs
+ *     generation, writes its own tokens + per-step logits to a file,
+ *     exits (context freed before this process even exits).
+ *
+ *   --mode compare: creates ONE context (the candidate -- a mixed
+ *     Q8/Q5 layer map, or another whole-cache config for a sanity
+ *     self-check), teacher-forces over the DUMPED reference's own
+ *     token sequence, and reports the same top1_preservation/
+ *     logit_rel_l2/delta_nll trio every other MEMBRANE Q8/Q5 tool
+ *     reports -- comparing candidate's logits against the dumped
+ *     reference's logits at each position, plus a free-running
+ *     candidate pass for genuine (unforced) token_identity/
+ *     first_divergence, matching the existing probe's own
+ *     methodology exactly, just without ever needing two live
+ *     contexts.
+ *
+ * This is NOT a claim of a Q8/F16 "ground truth" reference -- the
+ * reference here is explicitly whichever whole-cache config --mode
+ * dump was run with (Q5_1 for this phase's primary comparison), and
+ * every artifact that consumes this tool's output must say so.
+ */
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "llama.h"
+#include "runtime_core.h"
+
+static int	die(const char *msg)
+{
+	fprintf(stderr, "membrane-kv-sequential-compare: %s\n", msg);
+	return (0);
+}
+
+static std::string	read_file(const char *path)
+{
+	FILE		*f;
+	std::string	s;
+	char		buf[4096];
+	size_t		n;
+
+	f = fopen(path, "rb");
+	if (f == NULL)
+		return (s);
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		s.append(buf, n);
+	fclose(f);
+	return (s);
+}
+
+static bool	tokenize_prompt(const llama_vocab *vocab, const std::string &text,
+				std::vector<llama_token> *out)
+{
+	int	n;
+
+	out->resize(text.size() + 8);
+	n = llama_tokenize(vocab, text.c_str(), (int32_t)text.size(),
+			out->data(), (int32_t)out->size(), true, false);
+	if (n < 0)
+		return (die("tokenization failed"), false);
+	out->resize(n);
+	return (true);
+}
+
+static ggml_type	layer_map_cb(int32_t il, bool is_v, void *user_data)
+{
+	std::vector<ggml_type>	*map;
+
+	(void)is_v;
+	map = (std::vector<ggml_type> *)user_data;
+	if (il < 0 || (size_t)il >= map->size())
+		return (GGML_TYPE_F16);
+	return ((*map)[(size_t)il]);
+}
+
+static llama_context	*make_context(llama_model *model, int n_ctx,
+						ggml_type type_k, ggml_type type_v,
+						ggml_type (*override_cb)(int32_t, bool, void *),
+						void *override_ud)
+{
+	llama_context_params	cp;
+
+	cp = llama_context_default_params();
+	cp.n_ctx = (uint32_t)n_ctx;
+	cp.n_batch = 256;
+	cp.n_threads = 4;
+	cp.n_threads_batch = 4;
+	cp.type_k = type_k;
+	cp.type_v = type_v;
+	cp.no_perf = true;
+	cp.kv_type_override = override_cb;
+	cp.kv_type_override_ud = override_ud;
+	if (type_k != GGML_TYPE_F16 || type_v != GGML_TYPE_F16
+			|| override_cb != NULL)
+		cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+	return (llama_init_from_model(model, cp));
+}
+
+static bool	decode_prompt(llama_context *ctx,
+				const std::vector<llama_token> &tokens, int n_batch)
+{
+	size_t	off;
+	size_t	n;
+
+	off = 0;
+	while (off < tokens.size())
+	{
+		n = tokens.size() - off;
+		if (n > (size_t)n_batch)
+			n = (size_t)n_batch;
+		if (llama_decode(ctx,
+				llama_batch_get_one((llama_token *)tokens.data() + off,
+					(int32_t)n)) != 0)
+			return (die("llama_decode (prompt) failed"), false);
+		off += n;
+	}
+	return (true);
+}
+
+static int	argmax(const float *v, int n)
+{
+	int	best;
+	int	i;
+
+	best = 0;
+	for (i = 1; i < n; i++)
+		if (v[i] > v[best])
+			best = i;
+	return (best);
+}
+
+typedef struct s_pass_result
+{
+	std::vector<llama_token>			tokens;
+	std::vector<std::vector<float>>	logits;
+}	pass_result_t;
+
+static bool	run_gen(llama_context *ctx, const llama_vocab *vocab,
+				int gen_steps, const std::vector<llama_token> *forced,
+				pass_result_t *out)
+{
+	llama_token	tok;
+	const float	*logits;
+	int32_t		n_vocab;
+	int			i;
+
+	n_vocab = llama_vocab_n_tokens(vocab);
+	i = 0;
+	while (i < gen_steps)
+	{
+		logits = llama_get_logits_ith(ctx, -1);
+		if (logits == NULL)
+			return (die("llama_get_logits_ith failed"), false);
+		out->logits.emplace_back(logits, logits + n_vocab);
+		if (forced != NULL && i < (int)forced->size())
+			tok = (*forced)[i];
+		else
+			tok = argmax(logits, n_vocab);
+		out->tokens.push_back(tok);
+		if (llama_decode(ctx, llama_batch_get_one(&tok, 1)) != 0)
+			return (die("llama_decode (gen) failed"), false);
+		i++;
+	}
+	return (true);
+}
+
+/* Dump file format (all little-endian, native host byte order -- this
+ * tool only ever reads what it itself wrote, on the same host):
+ *   int32 n_vocab
+ *   int32 n_prompt_tokens
+ *   int32 n_gen_tokens
+ *   int32[n_prompt_tokens] prompt_tokens
+ *   int32[n_gen_tokens]    gen_tokens (the reference's own free-run choices)
+ *   float[n_gen_tokens * n_vocab] gen_logits (row-major, one row per step)
+ */
+static bool	write_dump(const char *path, const std::vector<llama_token> &prompt_tokens,
+				const pass_result_t &free_pass, int32_t n_vocab)
+{
+	FILE	*f;
+	int32_t	np;
+	int32_t	ng;
+
+	f = fopen(path, "wb");
+	if (f == NULL)
+		return (die("cannot open dump file for writing"), false);
+	np = (int32_t)prompt_tokens.size();
+	ng = (int32_t)free_pass.tokens.size();
+	fwrite(&n_vocab, sizeof(int32_t), 1, f);
+	fwrite(&np, sizeof(int32_t), 1, f);
+	fwrite(&ng, sizeof(int32_t), 1, f);
+	fwrite(prompt_tokens.data(), sizeof(llama_token), (size_t)np, f);
+	fwrite(free_pass.tokens.data(), sizeof(llama_token), (size_t)ng, f);
+	for (int32_t i = 0; i < ng; i++)
+		fwrite(free_pass.logits[(size_t)i].data(), sizeof(float),
+			(size_t)n_vocab, f);
+	fclose(f);
+	return (true);
+}
+
+typedef struct s_dump_data
+{
+	int32_t							n_vocab;
+	std::vector<llama_token>		prompt_tokens;
+	std::vector<llama_token>		gen_tokens;
+	std::vector<std::vector<float>>	gen_logits;
+}	dump_data_t;
+
+static bool	read_dump(const char *path, dump_data_t *out)
+{
+	FILE	*f;
+	int32_t	np;
+	int32_t	ng;
+
+	f = fopen(path, "rb");
+	if (f == NULL)
+		return (die("cannot open dump file for reading"), false);
+	if (fread(&out->n_vocab, sizeof(int32_t), 1, f) != 1
+			|| fread(&np, sizeof(int32_t), 1, f) != 1
+			|| fread(&ng, sizeof(int32_t), 1, f) != 1)
+		return (fclose(f), die("dump file truncated (header)"), false);
+	out->prompt_tokens.resize((size_t)np);
+	out->gen_tokens.resize((size_t)ng);
+	if (fread(out->prompt_tokens.data(), sizeof(llama_token), (size_t)np, f)
+				!= (size_t)np
+			|| fread(out->gen_tokens.data(), sizeof(llama_token), (size_t)ng, f)
+				!= (size_t)ng)
+		return (fclose(f), die("dump file truncated (tokens)"), false);
+	out->gen_logits.resize((size_t)ng);
+	for (int32_t i = 0; i < ng; i++)
+	{
+		out->gen_logits[(size_t)i].resize((size_t)out->n_vocab);
+		if (fread(out->gen_logits[(size_t)i].data(), sizeof(float),
+				(size_t)out->n_vocab, f) != (size_t)out->n_vocab)
+			return (fclose(f), die("dump file truncated (logits)"), false);
+	}
+	fclose(f);
+	return (true);
+}
+
+typedef struct s_prompt_metrics
+{
+	double	top1_preservation;
+	double	logit_rel_l2;
+	double	delta_nll;
+	bool	token_identity;
+	int32_t	first_divergence;
+}	prompt_metrics_t;
+
+static bool	compare_against_dump(const dump_data_t &ref,
+				const pass_result_t &cand_free, const pass_result_t &cand_forced,
+				prompt_metrics_t *out)
+{
+	membrane_runtime_behavior_accum_t		*acc;
+	membrane_runtime_behavior_summary_t	summary;
+	membrane_runtime_step_logit_diff_t		diff;
+	size_t									n;
+	size_t									i;
+	double									nll_ref;
+	double									nll_cand;
+	bool									identical;
+
+	n = ref.gen_logits.size() < cand_forced.logits.size()
+		? ref.gen_logits.size() : cand_forced.logits.size();
+	acc = membrane_runtime_behavior_create();
+	if (acc == NULL)
+		return (false);
+	identical = true;
+	out->first_divergence = -1;
+	i = 0;
+	while (i < ref.gen_tokens.size() && i < cand_free.tokens.size())
+	{
+		if (identical && cand_free.tokens[i] != ref.gen_tokens[i])
+		{
+			identical = false;
+			out->first_divergence = (int32_t)i;
+		}
+		i++;
+	}
+	i = 0;
+	while (i < n)
+	{
+		membrane_runtime_compare_logits(ref.gen_logits[i].data(),
+			cand_forced.logits[i].data(), ref.n_vocab, 5, &diff);
+		nll_ref = membrane_runtime_nll(ref.gen_logits[i].data(), ref.n_vocab,
+				ref.gen_tokens[i]);
+		nll_cand = membrane_runtime_nll(cand_forced.logits[i].data(),
+				ref.n_vocab, ref.gen_tokens[i]);
+		membrane_runtime_behavior_add_step(acc, &diff, nll_ref, nll_cand);
+		i++;
+	}
+	membrane_runtime_behavior_finalize(acc, &summary);
+	membrane_runtime_behavior_destroy(acc);
+	out->logit_rel_l2 = summary.logit_rel_l2_mean;
+	out->top1_preservation = summary.top1_preservation_rate;
+	out->delta_nll = summary.delta_nll;
+	out->token_identity = identical;
+	return (true);
+}
+
+typedef struct s_opts
+{
+	const char					*mode;	/* "dump" or "compare" */
+	const char					*model_path;
+	const char					*prompt_path;
+	const char					*file_path;	/* --out for dump, --in for compare */
+	int							n_ctx;
+	int							gen_tokens;
+	std::vector<int32_t>		q8_layers;
+	const char					*kv_type;	/* "native"|"q5"|"q8", whole-cache,
+											 * used by BOTH dump (reference
+											 * config) and compare (candidate
+											 * self-check config when
+											 * q8_layers is empty) */
+	int32_t						gpu_layers;
+	bool						want_json;
+}	opts_t;
+
+static int	parse_int_list(const char *s, std::vector<int32_t> *out)
+{
+	std::string	item;
+	const char	*p;
+
+	out->clear();
+	if (s == NULL || s[0] == '\0')
+		return (0);
+	p = s;
+	while (*p != '\0')
+	{
+		item.clear();
+		while (*p != '\0' && *p != ',')
+			item.push_back(*p++);
+		if (!item.empty())
+			out->push_back((int32_t)strtol(item.c_str(), NULL, 10));
+		if (*p == ',')
+			p++;
+	}
+	return (0);
+}
+
+static int	parse_args(int argc, char **argv, opts_t *o)
+{
+	int	i;
+
+	o->mode = NULL;
+	o->model_path = NULL;
+	o->prompt_path = NULL;
+	o->file_path = NULL;
+	o->n_ctx = 2048;
+	o->gen_tokens = 32;
+	o->kv_type = "q5";
+	o->gpu_layers = 0;
+	o->want_json = false;
+	i = 1;
+	while (i < argc)
+	{
+		if (strcmp(argv[i], "--mode") == 0 && i + 1 < argc)
+			o->mode = argv[++i];
+		else if (strcmp(argv[i], "--model") == 0 && i + 1 < argc)
+			o->model_path = argv[++i];
+		else if (strcmp(argv[i], "--prompt") == 0 && i + 1 < argc)
+			o->prompt_path = argv[++i];
+		else if (strcmp(argv[i], "--out") == 0 && i + 1 < argc)
+			o->file_path = argv[++i];
+		else if (strcmp(argv[i], "--in") == 0 && i + 1 < argc)
+			o->file_path = argv[++i];
+		else if (strcmp(argv[i], "--ctx") == 0 && i + 1 < argc)
+			o->n_ctx = atoi(argv[++i]);
+		else if (strcmp(argv[i], "--gen-tokens") == 0 && i + 1 < argc)
+			o->gen_tokens = atoi(argv[++i]);
+		else if (strcmp(argv[i], "--q8-layers") == 0 && i + 1 < argc)
+			parse_int_list(argv[++i], &o->q8_layers);
+		else if (strcmp(argv[i], "--kv-type") == 0 && i + 1 < argc)
+			o->kv_type = argv[++i];
+		else if (strcmp(argv[i], "--gpu-layers") == 0 && i + 1 < argc)
+		{
+			++i;
+			o->gpu_layers = strcmp(argv[i], "all") == 0
+				? -1 : (int32_t)atoi(argv[i]);
+		}
+		else if (strcmp(argv[i], "--json") == 0)
+			o->want_json = true;
+		else
+			return (die("unknown or malformed option"), 1);
+		i++;
+	}
+	if (o->mode == NULL || o->model_path == NULL || o->file_path == NULL)
+		return (die("--mode, --model, and --out/--in are required"), 1);
+	if (strcmp(o->mode, "dump") == 0 && o->prompt_path == NULL)
+		return (die("--mode dump requires --prompt"), 1);
+	if (strcmp(o->mode, "compare") != 0 && strcmp(o->mode, "dump") != 0)
+		return (die("--mode must be dump or compare"), 1);
+	return (0);
+}
+
+static void	kv_type_for_name(const char *name, ggml_type *out)
+{
+	if (strcmp(name, "q8") == 0)
+		*out = GGML_TYPE_Q8_0;
+	else if (strcmp(name, "q5") == 0)
+		*out = GGML_TYPE_Q5_1;
+	else
+		*out = GGML_TYPE_F16;
+}
+
+int	main(int argc, char **argv)
+{
+	opts_t	o;
+
+	if (parse_args(argc, argv, &o) != 0)
+		return (2);
+	llama_backend_init();
+	llama_model_params	mp = llama_model_default_params();
+	mp.n_gpu_layers = o.gpu_layers;
+	llama_model	*model = llama_model_load_from_file(o.model_path, mp);
+	if (model == NULL)
+		return (die("model load failed"), llama_backend_free(), 3);
+	const llama_vocab	*vocab = llama_model_get_vocab(model);
+	int32_t				n_vocab = llama_vocab_n_tokens(vocab);
+	int32_t				n_layer = llama_model_n_layer(model);
+
+	if (strcmp(o.mode, "dump") == 0)
+	{
+		std::string					text = read_file(o.prompt_path);
+		std::vector<llama_token>	tokens;
+		pass_result_t				free_pass;
+		ggml_type					t;
+
+		if (text.empty() || !tokenize_prompt(vocab, text, &tokens))
+			return (llama_model_free(model), llama_backend_free(), 4);
+		kv_type_for_name(o.kv_type, &t);
+		llama_context	*ctx = make_context(model, o.n_ctx, t, t, NULL, NULL);
+		if (ctx == NULL)
+			return (die("reference context creation failed"),
+				llama_model_free(model), llama_backend_free(), 5);
+		if (!decode_prompt(ctx, tokens, 256)
+				|| !run_gen(ctx, vocab, o.gen_tokens, NULL, &free_pass))
+			return (llama_free(ctx), llama_model_free(model),
+				llama_backend_free(), 4);
+		if (!write_dump(o.file_path, tokens, free_pass, n_vocab))
+			return (llama_free(ctx), llama_model_free(model),
+				llama_backend_free(), 6);
+		if (o.want_json)
+			printf("{\"schema_version\":1,\"mode\":\"dump\",\"kv_type\":\"%s\","
+				"\"ctx\":%d,\"n_prompt_tokens\":%zu,\"n_gen_tokens\":%d,"
+				"\"n_vocab\":%d,\"out\":\"%s\"}\n",
+				o.kv_type, o.n_ctx, tokens.size(), o.gen_tokens, n_vocab,
+				o.file_path);
+		llama_free(ctx);
+		llama_model_free(model);
+		llama_backend_free();
+		return (0);
+	}
+
+	/* --mode compare */
+	dump_data_t	ref;
+
+	if (!read_dump(o.file_path, &ref))
+		return (llama_model_free(model), llama_backend_free(), 6);
+	if (ref.n_vocab != n_vocab)
+		return (die("dump file n_vocab does not match this model"),
+			llama_model_free(model), llama_backend_free(), 7);
+
+	std::vector<ggml_type>	type_map;
+	ggml_type				(*override_cb)(int32_t, bool, void *) = NULL;
+	void					*override_ud = NULL;
+	ggml_type				whole_type = GGML_TYPE_Q5_1;
+
+	if (!o.q8_layers.empty())
+	{
+		type_map.assign((size_t)n_layer, GGML_TYPE_Q5_1);
+		for (int32_t idx : o.q8_layers)
+		{
+			if (idx < 0 || idx >= n_layer)
+				return (die("--q8-layers index out of range"),
+					llama_model_free(model), llama_backend_free(), 2);
+			type_map[(size_t)idx] = GGML_TYPE_Q8_0;
+		}
+		override_cb = layer_map_cb;
+		override_ud = &type_map;
+	}
+	else
+		kv_type_for_name(o.kv_type, &whole_type);
+
+	llama_context	*cctx;
+
+	if (override_cb != NULL)
+		cctx = make_context(model, o.n_ctx, GGML_TYPE_F16, GGML_TYPE_F16,
+				override_cb, override_ud);
+	else
+		/* whole-cache candidate self-check path -- type_k/type_v must
+		 * be the requested uniform type directly (no override
+		 * callback needed for a uniform cache). */
+		cctx = make_context(model, o.n_ctx, whole_type, whole_type, NULL,
+				NULL);
+	if (cctx == NULL)
+		return (die("candidate context creation failed"),
+			llama_model_free(model), llama_backend_free(), 5);
+
+	pass_result_t	cand_free;
+	pass_result_t	cand_forced;
+
+	if (!decode_prompt(cctx, ref.prompt_tokens, 256)
+			|| !run_gen(cctx, vocab, (int)ref.gen_tokens.size(), NULL,
+				&cand_free))
+		return (llama_free(cctx), llama_model_free(model),
+			llama_backend_free(), 4);
+	llama_memory_seq_rm(llama_get_memory(cctx), 0, -1, -1);
+	if (!decode_prompt(cctx, ref.prompt_tokens, 256)
+			|| !run_gen(cctx, vocab, (int)ref.gen_tokens.size(),
+				&ref.gen_tokens, &cand_forced))
+		return (llama_free(cctx), llama_model_free(model),
+			llama_backend_free(), 4);
+
+	prompt_metrics_t	pm;
+
+	if (!compare_against_dump(ref, cand_free, cand_forced, &pm))
+		return (llama_free(cctx), llama_model_free(model),
+			llama_backend_free(), 4);
+	if (o.want_json)
+		printf("{\"schema_version\":1,\"mode\":\"compare\","
+			"\"q8_layer_count\":%zu,\"top1_preservation\":%.6f,"
+			"\"logit_rel_l2\":%.6f,\"delta_nll\":%.6f,"
+			"\"token_identity\":%s,\"first_divergence\":%d}\n",
+			o.q8_layers.size(), pm.top1_preservation, pm.logit_rel_l2,
+			pm.delta_nll, pm.token_identity ? "true" : "false",
+			pm.first_divergence);
+	llama_free(cctx);
+	llama_model_free(model);
+	llama_backend_free();
+	return (0);
+}
diff --git a/tools/membrane-kv-mixed-layer/test_constrained_policy_sim.c b/tools/membrane-kv-mixed-layer/test_constrained_policy_sim.c
new file mode 100644
index 0000000..2389684
