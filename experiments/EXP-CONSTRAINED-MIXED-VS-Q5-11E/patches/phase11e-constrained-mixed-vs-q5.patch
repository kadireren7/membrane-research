+@check("Phase 11E: q8_count_sweep.json's safe-boundary claim (top-8 "
+	"succeeds, top-9 fails) is exactly reproducible from "
+	"raw_q8_budget_search_180k.jsonl")
+def _c98():
+	sweep = _load_v11e("q8_count_sweep.json")
+	raw = _load_v11e("raw_q8_budget_search_180k.jsonl")
+	succeeded = {r["q8_count"]: r["raw"]["context_creation_succeeded"] for r in raw}
+	ok_counts = sorted(c for c, ok in succeeded.items() if ok)
+	fail_counts = sorted(c for c, ok in succeeded.items() if not ok)
+	recomputed_last_ok = max(ok_counts) if ok_counts else -1
+	recomputed_first_fail = min(fail_counts) if fail_counts else None
+	claimed = sweep.get("boundary", {})
+	bad = []
+	if recomputed_last_ok != claimed.get("last_succeeding_q8_count"):
+		bad.append(f"recomputed last_succeeding={recomputed_last_ok} != claimed {claimed.get('last_succeeding_q8_count')}")
