+		bad.append(f"recomputed first_failing={recomputed_first_fail} != claimed {claimed.get('first_failing_q8_count')}")
+	if any(c > recomputed_last_ok for c in ok_counts if c < (recomputed_first_fail or 1 << 30)):
+		pass  # monotonic within tested range implicitly checked by the two comparisons above
+	return len(bad) == 0, "; ".join(bad) if bad else f"boundary (last_ok={recomputed_last_ok}, first_fail={recomputed_first_fail}) reproduces exactly from raw data"
