@@ -0,0 +1,50 @@
+#include <stddef.h>
+
+#include "constrained_policy_sim.h"
+
+int	membrane_constrained_policy_select(int q8_full_resides,
+		int profile_available, int mixed_safe, int q5_safe)
+{
+	if (q8_full_resides)
+		return (MEMBRANE_CONSTRAINED_MODE_Q8);
+	if (profile_available && mixed_safe)
+		return (MEMBRANE_CONSTRAINED_MODE_MIXED);
+	if (q5_safe)
+		return (MEMBRANE_CONSTRAINED_MODE_Q5);
+	return (MEMBRANE_CONSTRAINED_MODE_FAIL_CLOSED);
+}
+
+int	membrane_safe_q8_count_boundary(const int32_t *q8_counts,
+		const int *succeeded, int n_entries, int32_t *out_boundary)
+{
+	int		i;
+	int		j;
+	int32_t	best;
+	int		have_best;
+
+	*out_boundary = -1;
+	if (n_entries <= 0 || q8_counts == NULL || succeeded == NULL)
+		return (0);
+	have_best = 0;
+	best = -1;
+	for (i = 0; i < n_entries; i++)
+	{
+		if (!succeeded[i])
+			continue;
+		for (j = 0; j < n_entries; j++)
+			if (q8_counts[j] < q8_counts[i] && !succeeded[j])
+				return (0);
+		if (!have_best || q8_counts[i] > best)
+		{
+			best = q8_counts[i];
+			have_best = 1;
+		}
+	}
+	if (!have_best)
+	{
+		*out_boundary = -1;
+		return (1);
+	}
+	*out_boundary = best;
+	return (1);
+}
