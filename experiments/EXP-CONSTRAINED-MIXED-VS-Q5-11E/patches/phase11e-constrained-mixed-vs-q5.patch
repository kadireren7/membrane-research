+#include <string.h>
+
+#include "constrained_policy_sim.h"
+#include "test_helpers.h"
+
+static void	test_select_q8_when_full_resides(void)
+{
+	TEST_ASSERT(membrane_constrained_policy_select(1, 1, 1, 1)
+		== MEMBRANE_CONSTRAINED_MODE_Q8,
+		"Q8 wins whenever it full-resides, regardless of mixed/Q5 state");
+	TEST_ASSERT(membrane_constrained_policy_select(1, 0, 0, 0)
+		== MEMBRANE_CONSTRAINED_MODE_Q8,
+		"Q8 wins even with no profile and Q5 unsafe -- Q8 full residency "
+		"alone is sufficient");
+}
+
+static void	test_select_mixed_only_with_profile(void)
+{
+	TEST_ASSERT(membrane_constrained_policy_select(0, 1, 1, 1)
+		== MEMBRANE_CONSTRAINED_MODE_MIXED,
+		"mixed selected when Q8 fails but profile+mixed are both safe");
+	TEST_ASSERT(membrane_constrained_policy_select(0, 0, 1, 1)
+		== MEMBRANE_CONSTRAINED_MODE_Q5,
+		"mixed_safe=1 alone is not enough -- no profile means mixed is "
+		"never selected (Section 22: missing profile fails closed to Q5, "
+		"never a silent naive layout)");
+}
+
+static void	test_select_q5_fallback(void)
+{
+	TEST_ASSERT(membrane_constrained_policy_select(0, 1, 0, 1)
+		== MEMBRANE_CONSTRAINED_MODE_Q5,
+		"Q5 selected when mixed is unsafe but Q5 is safe");
+	TEST_ASSERT(membrane_constrained_policy_select(0, 0, 0, 1)
+		== MEMBRANE_CONSTRAINED_MODE_Q5,
+		"Q5 selected with no profile at all, as long as Q5 itself is safe");
+}
+
+static void	test_select_fail_closed(void)
+{
+	TEST_ASSERT(membrane_constrained_policy_select(0, 1, 0, 0)
+		== MEMBRANE_CONSTRAINED_MODE_FAIL_CLOSED,
+		"fails closed when nothing is safe, even with a valid profile");
+	TEST_ASSERT(membrane_constrained_policy_select(0, 0, 0, 0)
+		== MEMBRANE_CONSTRAINED_MODE_FAIL_CLOSED,
+		"fails closed, never silently native/uncompressed");
+}
+
+static void	test_boundary_matches_phase11e_measurement(void)
+{
+	/* results/phase11/constrained-mixed-vs-q5/q8_count_sweep.json,
+	 * PRIMARY POINT B (ctx=180000): counts 0,1,2,4,6,7,8 succeed,
+	 * 9 and 10 fail. */
+	int32_t	counts[9] = {0, 1, 2, 4, 6, 7, 8, 9, 10};
+	int		ok[9] = {1, 1, 1, 1, 1, 1, 1, 0, 0};
+	int32_t	boundary;
+
+	TEST_ASSERT(membrane_safe_q8_count_boundary(counts, ok, 9, &boundary)
+		== 1, "well-formed monotonic sweep resolves");
+	TEST_ASSERT(boundary == 8,
+		"recovers the exact measured boundary (top-8 succeeds, top-9 "
+		"fails) from this phase's own raw data shape");
+}
+
+static void	test_boundary_all_fail(void)
+{
+	int32_t	counts[3] = {0, 1, 2};
+	int		ok[3] = {0, 0, 0};
+	int32_t	boundary;
+
+	TEST_ASSERT(membrane_safe_q8_count_boundary(counts, ok, 3, &boundary)
+		== 1, "all-fail sweep still resolves (well-formed, trivially "
+		"monotonic)");
+	TEST_ASSERT(boundary == -1,
+		"no safe count reported when every tested count failed, not a "
+		"silent 0");
+}
+
+static void	test_boundary_non_monotonic_fails_closed(void)
+{
+	/* count=1 fails but count=2 (a LARGER count) reports success --
+	 * this cannot happen with real KV-byte monotonicity and must be
+	 * flagged, not silently trusted. */
+	int32_t	counts[3] = {0, 1, 2};
+	int		ok[3] = {1, 0, 1};
+	int32_t	boundary;
+
+	TEST_ASSERT(membrane_safe_q8_count_boundary(counts, ok, 3, &boundary)
+		== 0, "non-monotonic sweep data is rejected, not silently "
+		"resolved to some value");
+	TEST_ASSERT(boundary == -1, "out_boundary left at -1 on rejection");
+}
+
+static void	test_boundary_degenerate_inputs(void)
+{
+	int32_t	boundary;
+	int32_t	one_count[1] = {0};
+	int		one_ok[1] = {1};
+
+	TEST_ASSERT(membrane_safe_q8_count_boundary(NULL, NULL, 0, &boundary)
+		== 0, "n_entries<=0 fails closed");
+	TEST_ASSERT(boundary == -1, "out_boundary set to -1 on failure");
+	TEST_ASSERT(membrane_safe_q8_count_boundary(one_count, one_ok, 1,
+			&boundary) == 1, "single-entry sweep resolves");
+	TEST_ASSERT(boundary == 0, "single succeeding entry is its own boundary");
+}
+
+static void	test_select_deterministic_repeated_calls(void)
+{
+	int	a;
+	int	b;
+
+	a = membrane_constrained_policy_select(0, 1, 1, 1);
+	b = membrane_constrained_policy_select(0, 1, 1, 1);
+	TEST_ASSERT(a == b, "identical inputs produce identical mode across "
+		"calls");
+}
+
+int	main(void)
+{
+	test_select_q8_when_full_resides();
+	test_select_mixed_only_with_profile();
+	test_select_q5_fallback();
+	test_select_fail_closed();
+	test_boundary_matches_phase11e_measurement();
+	test_boundary_all_fail();
+	test_boundary_non_monotonic_fails_closed();
+	test_boundary_degenerate_inputs();
+	test_select_deterministic_repeated_calls();
+	printf("test_constrained_policy_sim: all tests passed\n");
+	return (0);
+}
