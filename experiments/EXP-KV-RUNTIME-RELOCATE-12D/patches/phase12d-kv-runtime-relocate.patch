+/* ---------- mode: latency (N-layer group relocate timing) ---------- */
+
+static int	cmd_latency(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, const char *direction, int reps,
+			const std::vector<int32_t> &layers)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+
+	bool	to_gpu = strcmp(direction, "to_gpu") == 0;
+	ggml_backend_dev_t	dst = dev_for(to_gpu ? "gpu" : "cpu");
+	ggml_backend_dev_t	back = dev_for(to_gpu ? "cpu" : "gpu");
+	if (!dst)
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	for (int r = 0; r < reps; r++)
+	{
+		double	t0 = now_ms();
+		bool	ok = true;
+		for (int32_t layer : layers)
+		{
+			llama_synchronize(l.ctx);
+			ok = ok && llama_kv_cache_relocate_layer(l.mem, layer, dst);
+		}
+		double	t1 = now_ms();
+		printf("{\"rep\":%d,\"direction\":\"%s\",\"n_layers\":%d,\"ok\":%s,"
+			"\"total_ms\":%.4f}\n",
+			r, direction, (int)layers.size(), ok ? "true" : "false", t1 - t0);
+		/* relocate back so the next rep measures the same direction
+		 * from the same starting placement. */
+		for (int32_t layer : layers)
+		{
+			llama_synchronize(l.ctx);
+			llama_kv_cache_relocate_layer(l.mem, layer, back);
+		}
+	}
+	free_loaded(&l);
+	return (0);
+}
