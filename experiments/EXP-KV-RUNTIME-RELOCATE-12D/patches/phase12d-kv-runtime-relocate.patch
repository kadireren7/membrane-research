++// [MEMBRANE] Phase 12D: see llama-kv-cache.h for the contract.
++bool llama_kv_cache::relocate_layer(int32_t il, ggml_backend_buffer_type_t new_buft,
++        bool retain_old_backing_for_research) {
++    if (!new_buft) {
++        return false;
++    }
++
++    const auto it = map_layer_ids.find(il);
++    if (it == map_layer_ids.end()) {
++        return false;
++    }
++    const int32_t ikv = it->second;
++
++    kv_layer & layer = layers[ikv];
++
++    ggml_tensor * old_k = layer.k;
++    ggml_tensor * old_v = layer.v;
++    if (!old_k) {
++        return false;
++    }
++
++    // dedicated ggml_context for exactly this layer's new K/V (+ stream
++    // views) -- never shared with any other layer, so a future
++    // relocation of THIS layer can always tell whether the buffer it is
++    // leaving is safe to free (see the scan below).
++    ggml_init_params ip = {
++        /*.mem_size   =*/ size_t(2u*(1 + n_stream)*ggml_tensor_overhead()),
++        /*.mem_buffer =*/ nullptr,
++        /*.no_alloc   =*/ true,
++    };
++    ggml_context_ptr new_ctx { ggml_init(ip) };
++    if (!new_ctx) {
++        return false;
++    }
++
++    ggml_tensor * new_k = ggml_new_tensor(new_ctx.get(), old_k->type, GGML_MAX_DIMS, old_k->ne);
++    ggml_format_name(new_k, "cache_k_l%d", il);
++
++    ggml_tensor * new_v = nullptr;
++    if (old_v) {
++        new_v = ggml_new_tensor(new_ctx.get(), old_v->type, GGML_MAX_DIMS, old_v->ne);
++        ggml_format_name(new_v, "cache_v_l%d", il);
++    }
++
++    std::vector<ggml_tensor *> new_k_stream;
++    std::vector<ggml_tensor *> new_v_stream;
++    for (uint32_t s = 0; s < n_stream; ++s) {
++        new_k_stream.push_back(ggml_view_2d(new_ctx.get(), new_k, new_k->ne[0], new_k->ne[1], new_k->nb[1], s*new_k->nb[2]));
++        new_v_stream.push_back(new_v ? ggml_view_2d(new_ctx.get(), new_v, new_v->ne[0], new_v->ne[1], new_v->nb[1], s*new_v->nb[2]) : nullptr);
++    }
++
++    // step 5/8: allocate destination backend buffer -- any failure here
++    // leaves the original layer completely untouched (fail-closed).
++    ggml_backend_buffer_t new_buf_raw = ggml_backend_alloc_ctx_tensors_from_buft(new_ctx.get(), new_buft);
++    if (!new_buf_raw) {
++        return false;
++    }
++    ggml_backend_buffer_ptr new_buf { new_buf_raw };
++
++    // steps 6/7: copy live K then V. ggml_backend_tensor_copy handles
++    // cross-device (CPU<->GPU) copies via the destination backend's
++    // set_tensor/get_tensor path; any failure leaves layer untouched.
++    ggml_backend_tensor_copy(old_k, new_k);
++    if (old_v) {
++        ggml_backend_tensor_copy(old_v, new_v);
++    }
++
++    // step 9: the caller contract (see header) requires the backend to
++    // already be synchronized before calling relocate_layer, so no
++    // additional sync is issued here -- ggml_backend_tensor_copy itself
++    // is synchronous (blocks until the copy completes).
++
++    ggml_backend_buffer_t old_buf = old_k->buffer;
++
++    // step 10: switch persistent references only now, after the copy
++    // has fully succeeded.
++    layer.k = new_k;
++    layer.v = new_v;
++    layer.k_stream = std::move(new_k_stream);
++    layer.v_stream = std::move(new_v_stream);
++
++    ctxs_bufs.emplace_back(std::move(new_ctx), std::move(new_buf));
++
++    // step 12: release source backing only if safe -- scan every layer
++    // (including this one's NEW tensors, which no longer point at
++    // old_buf) for any remaining reference to old_buf. If none remain,
++    // old_buf is not the shared construction-time bulk buffer for any
++    // still-live layer and can be physically freed now.
++    bool old_buf_still_referenced = false;
++    for (const auto & other_layer : layers) {
++        if (other_layer.k->buffer == old_buf || (other_layer.v && other_layer.v->buffer == old_buf)) {
++            old_buf_still_referenced = true;
++            break;
++        }
++    }
++    if (!old_buf_still_referenced && !retain_old_backing_for_research) {
++        for (auto jt = ctxs_bufs.begin(); jt != ctxs_bufs.end(); ++jt) {
++            if (jt->second.get() == old_buf) {
++                ctxs_bufs.erase(jt);
++                break;
++            }
++        }
++    }
++
++    return true;
++}
++
