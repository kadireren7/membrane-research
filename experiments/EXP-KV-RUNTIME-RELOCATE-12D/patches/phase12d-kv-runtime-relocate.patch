+V12D_DIR = REPO_ROOT / "results" / "phase12" / "runtime-relocate"
+_V12D_CACHE = {}
+
+
+def _load_v12d(name):
+	key = name
+	if key not in _V12D_CACHE:
+		path = V12D_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V12D_CACHE[key] = rows
+		elif name.endswith(".txt"):
+			_V12D_CACHE[key] = path.read_text()
+		else:
+			_V12D_CACHE[key] = json.loads(path.read_text())
+	return _V12D_CACHE[key]
+
+
+@check("Phase 12D: manifest.json exists, valid JSON, schema_version 1, "
+	"lists every actual file in the directory (json/jsonl/txt, including "
+	"itself) and no others")
+def _c88():
+	if not (V12D_DIR / "manifest.json").exists():
+		return False, f"{V12D_DIR}/manifest.json does not exist"
+	m = _load_v12d("manifest.json")
+	bad = []
+	if m.get("schema_version") != 1:
+		bad.append(f"schema_version={m.get('schema_version')!r}")
+	listed = set(m.get("files", {}).keys())
+	actual = {p.name for p in V12D_DIR.glob("*") if p.suffix in (".json", ".jsonl", ".txt")}
+	if listed != actual:
+		bad.append(f"listed-vs-actual mismatch: missing={actual - listed}, extra={listed - actual}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(listed)} files listed, exact match with directory contents"
+
+
