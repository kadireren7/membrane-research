new file mode 100644
index 0000000..a5912a3
--- /dev/null
+++ b/tools/membrane-kv-runtime-relocate/relocate_probe.cpp
@@ -0,0 +1,1117 @@
+/*
+ * Phase 12D: real llama-enabled probe for the new
+ * llama_kv_cache_relocate_layer() primitive
+ * (patches/llama.cpp-membrane-kv-runtime-relocate.patch), built on top
+ * of the Phase 12B kv_dev_override patch. Deterministic/manual calls
+ * only -- no adaptive policy, no product CLI exposure. RESEARCH ONLY,
+ * experiment/kv-runtime-relocate branch only.
+ *
+ * Unlike Phase 12C's promotion_probe.cpp (which only proved BYTE
+ * COPIES work, via scratch tensors the live decode graph never read),
+ * every mode here calls the REAL relocate_layer() primitive, which
+ * switches llama_kv_cache's own persistent layers[il].k/.v references.
+ * The poison test below poisons the OLD (now-unreferenced but often
+ * still-allocated) source tensor DIRECTLY -- if generation is
+ * unaffected, decode is provably reading the NEW tensor.
+ *
+ * Modes needing a real model (mp.n_gpu_layers=-1, weights always fully
+ * GPU-resident, kv_dev_override splits initial KV placement only):
+ *   info                MODEL n_ctx kv_type split
+ *   relocate            MODEL n_ctx kv_type split layer target[cpu|gpu] [poison]
+ *   roundtrip           MODEL n_ctx kv_type split layer
+ *   cycle               MODEL n_ctx kv_type split layer cycles
+ *   multi               MODEL n_ctx kv_type split direction[to_gpu|to_cpu] layer...
+ *   weights_table       MODEL n_ctx kv_type split relocate_layer
+ *   latency             MODEL n_ctx kv_type split direction[to_gpu|to_cpu] reps layer...
+ *   state_save          MODEL n_ctx kv_type split layer
+ *   repro2              MODEL n_ctx kv_type split layer retain|noretain
+ *                       (root-cause reproducer: same layer CPU->GPU->CPU,
+ *                       ground-truth poison test; retain leaks old backing
+ *                       instead of freeing it -- see relocate_state.h)
+ *   failure             MODEL n_ctx kv_type split case[invalid_layer|invalid_dev|same_dev|duplicate]
+ */
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "ggml-backend.h"
+#include "llama.h"
+#include "relocate_state.h"
+
+/* ---------- shared plumbing (mirrors promotion_probe.cpp) ---------- */
+
+struct capture_ctx_t
+{
+	int32_t						n_layer;
+	std::vector<ggml_tensor *>	k_leaf;
+	std::vector<ggml_tensor *>	v_leaf;
+};
+
+static bool	layer_from_name(const char *name, const char *prefix, int32_t *out)
+{
+	size_t	plen = strlen(prefix);
+	char	*end;
+	long	v;
+
+	if (strncmp(name, prefix, plen) != 0)
+		return (false);
+	v = strtol(name + plen, &end, 10);
+	if (end == name + plen || v < 0)
+		return (false);
+	*out = (int32_t)v;
+	return (true);
+}
+
+static bool	capture_cb(struct ggml_tensor *t, bool ask, void *ud)
+{
+	capture_ctx_t	*c = static_cast<capture_ctx_t *>(ud);
+	int32_t			layer;
+
+	if (ask)
+		return (true);
+	if (layer_from_name(t->name, "cache_k_l", &layer) && layer < c->n_layer)
+		c->k_leaf[layer] = t->view_src != nullptr ? t->view_src : t;
+	else if (layer_from_name(t->name, "cache_v_l", &layer) && layer < c->n_layer)
+		c->v_leaf[layer] = t->view_src != nullptr ? t->view_src : t;
+	return (true);
+}
+
+struct split_ctx_t
+{
+	int32_t	split;
+};
+
+static ggml_backend_dev_t	split_kv_dev_override(int32_t il,
+				ggml_backend_dev_t default_dev, void *ud)
+{
+	split_ctx_t	*s = static_cast<split_ctx_t *>(ud);
+
+	if (il < s->split)
+		return (ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+	return (default_dev);
+}
+
+static uint64_t	read_rss_kb(void)
+{
+	std::ifstream	f("/proc/self/status");
+	std::string		line;
+
+	while (std::getline(f, line))
+	{
+		if (line.compare(0, 6, "VmRSS:") == 0)
+			return ((uint64_t)strtoull(line.c_str() + 6, nullptr, 10));
+	}
+	return (0);
+}
+
+static long	nvidia_smi_used_mib(void)
+{
+	FILE	*p = popen(
+		"nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null",
+		"r");
+	char	buf[64];
+	long	v = -1;
+
+	if (p == nullptr)
+		return (-1);
+	if (fgets(buf, sizeof(buf), p) != nullptr)
+		v = strtol(buf, nullptr, 10);
+	pclose(p);
+	return (v);
+}
+
+static double	now_ms(void)
+{
+	auto	t = std::chrono::steady_clock::now();
+
+	return (std::chrono::duration<double, std::milli>(
+		t.time_since_epoch()).count());
+}
+
+static const char	*kv_type_name(const char *s)
+{
+	if (strcmp(s, "q8") == 0)
+		return ("Q8_0");
+	if (strcmp(s, "q5") == 0)
+		return ("Q5_1");
+	return ("F16");
+}
+
+static uint64_t	fnv1a(const uint8_t *p, size_t n)
+{
+	uint64_t	h = 1469598103934665603ULL;
+
+	for (size_t i = 0; i < n; i++)
+	{
+		h ^= p[i];
+		h *= 1099511628211ULL;
+	}
+	return (h);
+}
+
+struct loaded_t
+{
+	llama_model			*model;
+	llama_context		*ctx;
+	llama_memory_t		mem;
+	capture_ctx_t		cap;
+	int32_t				n_layer;
+	const llama_vocab	*vocab;
+};
+
+static bool	load_ctx(const char *model_path, int32_t n_ctx,
+			const char *kv_type_str, int32_t split, loaded_t *out)
+{
+	llama_model_params	mp = llama_model_default_params();
+
+	mp.n_gpu_layers = -1;
+	out->model = llama_model_load_from_file(model_path, mp);
+	if (out->model == nullptr)
+		return (false);
+	out->n_layer = llama_model_n_layer(out->model);
+	out->vocab = llama_model_get_vocab(out->model);
+	out->cap.n_layer = out->n_layer;
+	out->cap.k_leaf.assign(out->n_layer, nullptr);
+	out->cap.v_leaf.assign(out->n_layer, nullptr);
+
+	static split_ctx_t	split_ctx;
+	split_ctx.split = split;
+
+	ggml_type	kvt = strcmp(kv_type_str, "q8") == 0 ? GGML_TYPE_Q8_0
+		: strcmp(kv_type_str, "q5") == 0 ? GGML_TYPE_Q5_1 : GGML_TYPE_F16;
+
+	llama_context_params	cp = llama_context_default_params();
+	cp.n_ctx = n_ctx;
+	cp.type_k = kvt;
+	cp.type_v = kvt;
+	cp.cb_eval = capture_cb;
+	cp.cb_eval_user_data = &out->cap;
+	if (split >= 0)
+	{
+		cp.kv_dev_override = split_kv_dev_override;
+		cp.kv_dev_override_ud = &split_ctx;
+	}
+	out->ctx = llama_init_from_model(out->model, cp);
+	if (out->ctx == nullptr)
+		return (false);
+	out->mem = llama_get_memory(out->ctx);
+	return (true);
+}
+
+static void	free_loaded(loaded_t *l)
+{
+	if (l->ctx)
+		llama_free(l->ctx);
+	if (l->model)
+		llama_model_free(l->model);
+	l->ctx = nullptr;
+	l->model = nullptr;
+}
+
+static bool	decode_prompt(loaded_t *l, const char *prompt)
+{
+	std::vector<llama_token>	tokens(256);
+	int	n = llama_tokenize(l->vocab, prompt, (int32_t)strlen(prompt),
+			tokens.data(), (int32_t)tokens.size(), true, false);
+
+	if (n < 0)
+		return (false);
+	tokens.resize(n);
+	llama_batch	batch = llama_batch_get_one(tokens.data(), (int32_t)tokens.size());
+	return (llama_decode(l->ctx, batch) == 0);
+}
+
+static bool	generate_greedy(loaded_t *l, int gen_tokens,
+			std::vector<llama_token> *out)
+{
+	int32_t	n_vocab = llama_vocab_n_tokens(l->vocab);
+
+	out->clear();
+	for (int i = 0; i < gen_tokens; i++)
+	{
+		const float	*logits = llama_get_logits_ith(l->ctx, -1);
+		int	best = 0;
+
+		for (int j = 1; j < n_vocab; j++)
+			if (logits[j] > logits[best])
+				best = j;
+		llama_token	tok = (llama_token)best;
+		out->push_back(tok);
+		llama_batch	b1 = llama_batch_get_one(&tok, 1);
+		if (llama_decode(l->ctx, b1) != 0)
+			return (false);
+	}
+	return (true);
+}
+
+static void	print_tokens(FILE *fp, const std::vector<llama_token> &v)
+{
+	for (size_t i = 0; i < v.size(); i++)
+		fprintf(fp, "%s%d", i == 0 ? "" : ",", v[i]);
+}
+
+static ggml_backend_dev_t	dev_for(const char *name)
+{
+	if (strcmp(name, "gpu") == 0)
+		return (ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU));
+	return (ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+}
+
+static bool	layer_is_cpu(ggml_tensor *k)
+{
+	return (k && strstr(ggml_backend_buffer_name(k->buffer), "CPU") != nullptr);
+}
+
+/* ---------- mode: info ---------- */
+
+static int	cmd_info(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "load failed\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "load ok but prompt decode failed\n");
+		free_loaded(&l);
+		return (13);
+	}
+	printf("{\"schema_version\":1,\"mode\":\"info\",\"model\":\"%s\","
+		"\"n_layer\":%d,\"n_ctx\":%d,\"kv_type\":\"%s\",\"split\":%d,"
+		"\"layers\":[", model, l.n_layer, n_ctx, kv_type_name(kvt), split);
+	int	n_cpu_kv = 0, n_gpu_kv = 0;
+	for (int32_t i = 0; i < l.n_layer; i++)
+	{
+		uint64_t	kb = l.cap.k_leaf[i] ? ggml_nbytes(l.cap.k_leaf[i]) : 0;
+		uint64_t	vb = l.cap.v_leaf[i] ? ggml_nbytes(l.cap.v_leaf[i]) : 0;
+		const char	*kbuf = l.cap.k_leaf[i] ? ggml_backend_buffer_name(l.cap.k_leaf[i]->buffer) : "MISSING";
+		bool	kv_cpu = layer_is_cpu(l.cap.k_leaf[i]);
+
+		if (kv_cpu)
+			n_cpu_kv++;
+		else
+			n_gpu_kv++;
+		printf("%s{\"layer\":%d,\"k_bytes\":%llu,\"v_bytes\":%llu,"
+			"\"kv_device\":\"%s\"}",
+			i == 0 ? "" : ",", i,
+			(unsigned long long)kb, (unsigned long long)vb, kbuf);
+	}
+	printf("],\"n_cpu_kv_layers\":%d,\"n_gpu_kv_layers\":%d,"
+		"\"vram_used_mib\":%ld}\n",
+		n_cpu_kv, n_gpu_kv, nvidia_smi_used_mib());
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: relocate ---------- */
+
+static int	cmd_relocate(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, int32_t layer, const char *target, bool poison)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+	if (layer < 0 || layer >= l.n_layer)
+	{
+		printf("{\"schema_version\":1,\"mode\":\"relocate\",\"layer\":%d,"
+			"\"ok\":false,\"error\":\"invalid_layer\"}\n", layer);
+		free_loaded(&l);
+		return (10);
+	}
+
+	ggml_tensor	*old_k = l.cap.k_leaf[layer];
+	ggml_tensor	*old_v = l.cap.v_leaf[layer];
+	uint64_t	kb = ggml_nbytes(old_k);
+	uint64_t	vb = ggml_nbytes(old_v);
+	std::vector<uint8_t>	old_kbuf(kb), old_vbuf(vb);
+
+	ggml_backend_tensor_get(old_k, old_kbuf.data(), 0, kb);
+	ggml_backend_tensor_get(old_v, old_vbuf.data(), 0, vb);
+	uint64_t	src_hash_k = fnv1a(old_kbuf.data(), kb);
+	uint64_t	src_hash_v = fnv1a(old_vbuf.data(), vb);
+
+	ggml_backend_dev_t	dst_dev = dev_for(target);
+	if (!dst_dev)
+	{
+		printf("{\"schema_version\":1,\"mode\":\"relocate\",\"layer\":%d,"
+			"\"ok\":false,\"error\":\"backend_unavailable\"}\n", layer);
+		free_loaded(&l);
+		return (20);
+	}
+
+	long	vram_before = nvidia_smi_used_mib();
+	uint64_t	rss_before = read_rss_kb();
+	double	t0 = now_ms();
+	llama_synchronize(l.ctx);
+	bool	ok = llama_kv_cache_relocate_layer(l.mem, layer, dst_dev);
+	double	t1 = now_ms();
+	long	vram_after_relocate = nvidia_smi_used_mib();
+	uint64_t	rss_after_relocate = read_rss_kb();
+
+	if (!ok)
+	{
+		printf("{\"schema_version\":1,\"mode\":\"relocate\",\"layer\":%d,"
+			"\"ok\":false,\"error\":\"relocate_call_failed\"}\n", layer);
+		free_loaded(&l);
+		return (14);
+	}
+
+	/* re-run decode so cb_eval repopulates cap.k_leaf/v_leaf with
+	 * whatever layers[ikv].k/.v CURRENTLY point to -- if relocate
+	 * really switched the persistent reference, this MUST be a
+	 * different tensor object than old_k/old_v. */
+	if (!decode_prompt(&l, "and then a second sentence"))
+	{
+		fprintf(stderr, "{\"error\":\"post_relocate_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+	ggml_tensor	*new_k = l.cap.k_leaf[layer];
+	ggml_tensor	*new_v = l.cap.v_leaf[layer];
+	bool	pointer_changed = (new_k != old_k) && (new_v != old_v);
+	const char	*new_device = ggml_backend_buffer_name(new_k->buffer);
+	bool	device_matches_target = (strcmp(target, "gpu") == 0)
+		== (strstr(new_device, "CPU") == nullptr);
+
+	std::vector<uint8_t>	new_kbuf(kb), new_vbuf(vb);
+	(void)new_kbuf;
+	(void)new_vbuf;
+
+	/* generated_control: this context (l), no poisoning -- always
+	 * produced, at THIS exact sequence position (right after the
+	 * post-relocate decode above). */
+	std::vector<llama_token>	gen_control;
+	generate_greedy(&l, 8, &gen_control);
+
+	bool	poison_ran = false;
+	bool	poison_had_no_effect = false;
+	std::vector<llama_token>	gen_poisoned;
+	if (poison)
+	{
+		/* Apples-to-apples poison test: an INDEPENDENT fresh context
+		 * (l2) follows the IDENTICAL schedule (load, prompt, relocate,
+		 * "second sentence") to reach the exact same sequence position
+		 * as gen_control above, then poisons the OLD source tensor
+		 * (still a valid, writable ggml_tensor -- its ggml_context was
+		 * only freed if relocate's cleanup logic found nothing else
+		 * referencing its buffer, which is never true on a layer's
+		 * FIRST relocation away from the shared construction-time bulk
+		 * buffer, since other layers still reference it) BEFORE
+		 * generating. Comparing gen_poisoned to gen_control (same
+		 * position, same schedule, only the poison differs) is the
+		 * correct apples-to-apples test -- generating twice on the
+		 * SAME context (as an earlier version of this probe did) would
+		 * compare two DIFFERENT sequence positions and is not valid. */
+		loaded_t	l2{};
+		load_ctx(model, n_ctx, kvt, split, &l2);
+		decode_prompt(&l2, "The quick brown fox jumps over the lazy dog");
+		ggml_tensor	*old_k2 = l2.cap.k_leaf[layer];
+		ggml_tensor	*old_v2 = l2.cap.v_leaf[layer];
+		std::vector<uint8_t>	poison_k(kb, 0xAA), poison_v(vb, 0xAA);
+		llama_synchronize(l2.ctx);
+		llama_kv_cache_relocate_layer(l2.mem, layer, dst_dev);
+		decode_prompt(&l2, "and then a second sentence");
+		ggml_backend_tensor_set(old_k2, poison_k.data(), 0, kb);
+		ggml_backend_tensor_set(old_v2, poison_v.data(), 0, vb);
+		poison_ran = true;
+		generate_greedy(&l2, 8, &gen_poisoned);
+		poison_had_no_effect = (gen_poisoned == gen_control);
+		free_loaded(&l2);
+	}
+
+	printf("{\"schema_version\":1,\"mode\":\"relocate\",\"model\":\"%s\","
+		"\"layer\":%d,\"n_ctx\":%d,\"kv_type\":\"%s\",\"split\":%d,"
+		"\"target\":\"%s\",\"ok\":true,\"k_bytes\":%llu,\"v_bytes\":%llu,"
+		"\"relocate_ms\":%.4f,\"pointer_changed\":%s,"
+		"\"device_matches_target\":%s,\"new_device\":\"%s\","
+		"\"src_hash_k\":%llu,\"src_hash_v\":%llu,"
+		"\"vram_before_mib\":%ld,\"vram_after_relocate_mib\":%ld,"
+		"\"rss_before_kb\":%llu,\"rss_after_relocate_kb\":%llu,"
+		"\"generated_control\":[",
+		model, layer, n_ctx, kv_type_name(kvt), split, target,
+		(unsigned long long)kb, (unsigned long long)vb, t1 - t0,
+		pointer_changed ? "true" : "false",
+		device_matches_target ? "true" : "false", new_device,
+		(unsigned long long)src_hash_k, (unsigned long long)src_hash_v,
+		vram_before, vram_after_relocate,
+		(unsigned long long)rss_before, (unsigned long long)rss_after_relocate);
+	print_tokens(stdout, gen_control);
+	printf("],\"poison_ran\":%s,\"generated_poisoned\":[",
+		poison_ran ? "true" : "false");
+	print_tokens(stdout, gen_poisoned);
+	printf("],\"poison_had_no_effect_on_output\":%s,"
+		"\"interpretation\":\"poison_had_no_effect_on_output==true means "
+		"decode is reading the NEW relocated tensor, not the poisoned "
+		"old one -- live rebind confirmed (classification A)\"}\n",
+		poison_had_no_effect ? "true" : "false");
+
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: roundtrip (CPU -> GPU -> CPU, one live context) ---------- */
+
+static int	cmd_roundtrip(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, int32_t layer)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+	if (!layer_is_cpu(l.cap.k_leaf[layer]))
+	{
+		printf("{\"schema_version\":1,\"mode\":\"roundtrip\",\"ok\":false,"
+			"\"error\":\"layer_not_initially_cpu\"}\n");
+		free_loaded(&l);
+		return (11);
+	}
+
+	ggml_backend_dev_t	gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+	ggml_backend_dev_t	cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+	if (!gpu_dev)
+	{
+		printf("{\"schema_version\":1,\"mode\":\"roundtrip\",\"ok\":false,"
+			"\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	printf("{\"schema_version\":1,\"mode\":\"roundtrip\",\"layer\":%d,"
+		"\"steps\":[", layer);
+
+	/* step 1: CPU (shared bulk buffer) -> GPU (new dedicated buffer) */
+	long	vram_0 = nvidia_smi_used_mib();
+	ggml_tensor	*old_k_step1 = l.cap.k_leaf[layer];
+	ggml_tensor	*old_v_step1 = l.cap.v_leaf[layer];
+	uint64_t	kb = ggml_nbytes(old_k_step1), vb = ggml_nbytes(old_v_step1);
+	llama_synchronize(l.ctx);
+	bool	ok1 = llama_kv_cache_relocate_layer(l.mem, layer, gpu_dev);
+	decode_prompt(&l, "second sentence");
+	std::vector<llama_token>	gen1;
+	bool	gen1_ok = ok1 && generate_greedy(&l, 4, &gen1);
+	long	vram_1 = nvidia_smi_used_mib();
+	bool	step1_now_gpu = !layer_is_cpu(l.cap.k_leaf[layer]);
+
+	printf("{\"step\":1,\"direction\":\"cpu_to_gpu\",\"ok\":%s,"
+		"\"now_gpu\":%s,\"decode_ok\":%s,\"vram_before_mib\":%ld,"
+		"\"vram_after_mib\":%ld}",
+		ok1 ? "true" : "false", step1_now_gpu ? "true" : "false",
+		gen1_ok ? "true" : "false", vram_0, vram_1);
+
+	/* step 2: GPU (dedicated, from step 1) -> CPU (new dedicated). The
+	 * step-1 GPU buffer is dedicated to this one layer, so this
+	 * relocation's cleanup MUST physically free it -- real external
+	 * VRAM drop expected. */
+	llama_synchronize(l.ctx);
+	bool	ok2 = llama_kv_cache_relocate_layer(l.mem, layer, cpu_dev);
+	decode_prompt(&l, "third sentence");
+	std::vector<llama_token>	gen2;
+	bool	gen2_ok = ok2 && generate_greedy(&l, 4, &gen2);
+	long	vram_2 = nvidia_smi_used_mib();
+	bool	step2_now_cpu = layer_is_cpu(l.cap.k_leaf[layer]);
+
+	printf(",{\"step\":2,\"direction\":\"gpu_to_cpu\",\"ok\":%s,"
+		"\"now_cpu\":%s,\"decode_ok\":%s,\"vram_before_mib\":%ld,"
+		"\"vram_after_mib\":%ld,\"vram_delta_mib\":%ld,"
+		"\"kv_bytes_relocated\":%llu}",
+		ok2 ? "true" : "false", step2_now_cpu ? "true" : "false",
+		gen2_ok ? "true" : "false", vram_1, vram_2, vram_1 - vram_2,
+		(unsigned long long)(kb + vb));
+
+	printf("],\"ok\":%s}\n",
+		(ok1 && ok2 && gen1_ok && gen2_ok && step1_now_gpu && step2_now_cpu)
+			? "true" : "false");
+
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: cycle (repeated CPU <-> GPU relocate) ---------- */
+
+static int	cmd_cycle(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, int32_t layer, int cycles)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+
+	ggml_backend_dev_t	gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+	ggml_backend_dev_t	cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+	if (!gpu_dev)
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+	bool	cur_is_cpu = layer_is_cpu(l.cap.k_leaf[layer]);
+
+	for (int c = 0; c < cycles; c++)
+	{
+		ggml_backend_dev_t	target = cur_is_cpu ? gpu_dev : cpu_dev;
+		llama_synchronize(l.ctx);
+		bool	ok = llama_kv_cache_relocate_layer(l.mem, layer, target);
+		bool	decode_ok = ok && decode_prompt(&l, "x");
+		bool	now_cpu = layer_is_cpu(l.cap.k_leaf[layer]);
+		bool	correct_side = (now_cpu == !cur_is_cpu);
+		const char	*buf_name = l.cap.k_leaf[layer]
+			? ggml_backend_buffer_name(l.cap.k_leaf[layer]->buffer) : "NULL";
+		cur_is_cpu = now_cpu;
+
+		printf("{\"cycle\":%d,\"ok\":%s,\"decode_ok\":%s,"
+			"\"correct_side\":%s,\"buf_name\":\"%s\",\"tensor_ptr\":\"%p\","
+			"\"rss_kb\":%llu,\"vram_used_mib\":%ld}\n",
+			c, ok ? "true" : "false", decode_ok ? "true" : "false",
+			correct_side ? "true" : "false", buf_name,
+			(void *)l.cap.k_leaf[layer],
+			(unsigned long long)read_rss_kb(), nvidia_smi_used_mib());
+		if (!ok || !decode_ok || !correct_side)
+		{
+			free_loaded(&l);
+			return (18);
+		}
+	}
+	free_loaded(&l);
+	return (0);
+}
