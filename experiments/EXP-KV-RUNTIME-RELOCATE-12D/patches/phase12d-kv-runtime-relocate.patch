+/* ---------- mode: multi (deterministic group relocation) ---------- */
+
+static int	cmd_multi(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, const char *direction,
+			const std::vector<int32_t> &layers)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+
+	ggml_backend_dev_t	dst = dev_for(strcmp(direction, "to_gpu") == 0 ? "gpu" : "cpu");
+	if (!dst)
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	printf("{\"schema_version\":1,\"mode\":\"multi\",\"direction\":\"%s\","
+		"\"n_layers\":%d,\"steps\":[", direction, (int)layers.size());
+	bool	first = true;
+	bool	all_ok = true;
+	for (int32_t layer : layers)
+	{
+		double	t0 = now_ms();
+		llama_synchronize(l.ctx);
+		bool	ok = llama_kv_cache_relocate_layer(l.mem, layer, dst);
+		double	t1 = now_ms();
+		long	vram = nvidia_smi_used_mib();
+		all_ok = all_ok && ok;
+		printf("%s{\"layer\":%d,\"ok\":%s,\"relocate_ms\":%.4f,"
+			"\"vram_used_mib\":%ld}",
+			first ? "" : ",", layer, ok ? "true" : "false", t1 - t0, vram);
+		first = false;
+	}
+	decode_prompt(&l, "second sentence");
+	std::vector<llama_token>	gen;
+	bool	gen_ok = generate_greedy(&l, 8, &gen);
+	printf("],\"all_relocations_ok\":%s,\"post_relocate_generation_ok\":%s,"
+		"\"post_relocate_tokens\":[", all_ok ? "true" : "false",
+		gen_ok ? "true" : "false");
+	print_tokens(stdout, gen);
+	printf("]}\n");
+	free_loaded(&l);
+	return (0);
+}
