+/* ---------- mode: state_save ---------- */
+
+static int	cmd_state_save(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, int32_t layer)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+
+	ggml_backend_dev_t	gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+	if (!gpu_dev)
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+	llama_synchronize(l.ctx);
+	bool	reloc_ok = llama_kv_cache_relocate_layer(l.mem, layer, gpu_dev);
+
+	size_t	need = llama_state_seq_get_size(l.ctx, 0);
+	std::vector<uint8_t>	buf(need);
+	size_t	got = llama_state_seq_get_data(l.ctx, buf.data(), buf.size(), 0);
+
+	/* restore into a fresh context (same config, same initial split)
+	 * to prove the serialized bytes are valid post-relocation and that
+	 * placement metadata (not serialized) does not corrupt restore. */
+	loaded_t	l2{};
+	load_ctx(model, n_ctx, kvt, split, &l2);
+	decode_prompt(&l2, "The quick brown fox jumps over the lazy dog");
+	size_t	set = llama_state_seq_set_data(l2.ctx, buf.data(), got, 0);
+
+	std::vector<llama_token>	gen_orig, gen_restored;
+	generate_greedy(&l, 8, &gen_orig);
+	generate_greedy(&l2, 8, &gen_restored);
+
+	printf("{\"schema_version\":1,\"mode\":\"state_save\",\"layer\":%d,"
+		"\"relocate_ok\":%s,\"state_size_needed\":%zu,"
+		"\"state_bytes_written\":%zu,\"state_bytes_read\":%zu,"
+		"\"generated_orig\":[", layer, reloc_ok ? "true" : "false",
+		need, got, set);
+	print_tokens(stdout, gen_orig);
+	printf("],\"generated_restored\":[");
+	print_tokens(stdout, gen_restored);
+	printf("],\"tokens_match\":%s}\n",
+		gen_orig == gen_restored ? "true" : "false");
+
+	free_loaded(&l);
+	free_loaded(&l2);
+	return (0);
+}
+
+/* ---------- mode: repro2 (root-cause reproducer for repeated relocation
+ * of the SAME layer -- Section 1 of the follow-up investigation) ---------- */
+
+static int	cmd_repro2(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, int32_t layer, bool retain, int settle_decodes)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+
+	/* A: initial state */
+	ggml_tensor	*a_k = l.cap.k_leaf[layer];
+	printf("{\"schema_version\":1,\"mode\":\"repro2\","
+		"\"retain_old_backing_for_research\":%s,\"layer\":%d,\"points\":{"
+		"\"A_initial\":{\"tensor_ptr\":\"%p\",\"buffer_ptr\":\"%p\","
+		"\"buffer_name\":\"%s\",\"data_ptr\":\"%p\"}",
+		retain ? "true" : "false", layer, (void *)a_k, (void *)a_k->buffer,
+		ggml_backend_buffer_name(a_k->buffer), a_k->data);
+
+	ggml_backend_dev_t	gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+	ggml_backend_dev_t	cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+	if (!gpu_dev)
+	{
+		printf("}}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	/* B: relocation #1 (CPU -> GPU) */
+	llama_synchronize(l.ctx);
+	bool	ok1 = llama_kv_cache_relocate_layer(l.mem, layer, gpu_dev, retain);
+	printf(",\"B_after_reloc1_call\":{\"ok\":%s}", ok1 ? "true" : "false");
+
+	/* C: graph build after relocation #1 */
+	decode_prompt(&l, "second sentence");
+	ggml_tensor	*c_k = l.cap.k_leaf[layer];
+	ggml_tensor	*c_v = l.cap.v_leaf[layer];
+	uint64_t	kb = ggml_nbytes(c_k), vb = ggml_nbytes(c_v);
+	printf(",\"C_graph_after_reloc1\":{\"tensor_ptr\":\"%p\",\"buffer_ptr\":\"%p\","
+		"\"buffer_name\":\"%s\",\"data_ptr\":\"%p\",\"pointer_changed_from_A\":%s}",
+		(void *)c_k, (void *)c_k->buffer, ggml_backend_buffer_name(c_k->buffer),
+		c_k->data, (c_k != a_k) ? "true" : "false");
+
+	/* Settling window: N additional ordinary decode steps at the
+	 * relocation-#1 placement before attempting relocation #2 --
+	 * testing whether the crash is specifically about relocating
+	 * again "too soon" after the previous relocation (this is exactly
+	 * what mode=roundtrip does differently from the settle_decodes=0
+	 * case below, and roundtrip does NOT crash). */
+	std::vector<llama_token>	settle_tokens;
+	if (settle_decodes > 0)
+		generate_greedy(&l, settle_decodes, &settle_tokens);
+	printf(",\"settle_decodes\":%d", settle_decodes);
+
+	/* D: relocation #2 (GPU -> CPU), same layer. If retain==false (the
+	 * real default/production behavior), this is where the old GPU
+	 * dedicated buffer from relocation #1 gets physically freed -- and
+	 * the FOLLOWING decode_prompt call is where the documented crash
+	 * (GGML_ASSERT(buffer != nullptr) in ggml-vulkan.cpp) occurs. This
+	 * probe intentionally does NOT try to catch that -- the crash/exit
+	 * code IS the release_failure.json evidence, captured by the
+	 * invoking shell. */
+	llama_synchronize(l.ctx);
+	bool	ok2 = llama_kv_cache_relocate_layer(l.mem, layer, cpu_dev, retain);
+	printf(",\"D_after_reloc2_call\":{\"ok\":%s}", ok2 ? "true" : "false");
+	fflush(stdout);
+
+	/* E: graph build after relocation #2 */
+	decode_prompt(&l, "third sentence");
+	ggml_tensor	*e_k = l.cap.k_leaf[layer];
+	printf(",\"E_graph_after_reloc2\":{\"tensor_ptr\":\"%p\",\"buffer_ptr\":\"%p\","
+		"\"buffer_name\":\"%s\",\"data_ptr\":\"%p\","
+		"\"pointer_changed_from_C\":%s,\"pointer_identical_to_A\":%s}",
+		(void *)e_k, (void *)e_k->buffer, ggml_backend_buffer_name(e_k->buffer),
+		e_k->data, (e_k != c_k) ? "true" : "false",
+		(e_k == a_k) ? "true" : "false");
+
+	/* Ground-truth test: does decode ACTUALLY still read C's (relocation
+	 * #1's destination, the GPU tensor) tensor content, regardless of
+	 * what cb_eval's capture claims? Poison C's tensor DIRECTLY (still
+	 * a valid, allocated ggml_tensor -- this probe run has the source-
+	 * release erase/free step disabled so it is guaranteed unfreed) and
+	 * see whether generation changes. This is ground truth; the pointer
+	 * observations above are diagnostic only. */
+	/* Apples-to-apples: poison c_k/c_v on l BEFORE generating anything
+	 * post-relocation-2 (not after, which would compare two different
+	 * sequence positions -- the earlier version of this probe made
+	 * exactly that mistake). Compare against an INDEPENDENT fresh
+	 * context (l2) that follows the identical schedule (prompt,
+	 * relocate #1, "second sentence", relocate #2, "third sentence")
+	 * with NO poisoning, generating at the exact same position. */
+	std::vector<uint8_t>	poison_k(kb, 0xAA), poison_v(vb, 0xAA);
+	ggml_backend_tensor_set(c_k, poison_k.data(), 0, kb);
+	ggml_backend_tensor_set(c_v, poison_v.data(), 0, vb);
+	std::vector<llama_token>	gen_poisoned;
+	generate_greedy(&l, 8, &gen_poisoned);
+
+	loaded_t	l2{};
+	load_ctx(model, n_ctx, kvt, split, &l2);
+	decode_prompt(&l2, "The quick brown fox jumps over the lazy dog");
+	llama_synchronize(l2.ctx);
+	llama_kv_cache_relocate_layer(l2.mem, layer, gpu_dev, retain);
+	decode_prompt(&l2, "second sentence");
+	if (settle_decodes > 0)
+	{
+		std::vector<llama_token>	settle_tokens2;
+		generate_greedy(&l2, settle_decodes, &settle_tokens2);
+	}
+	llama_synchronize(l2.ctx);
+	llama_kv_cache_relocate_layer(l2.mem, layer, cpu_dev, retain);
+	decode_prompt(&l2, "third sentence");
+	std::vector<llama_token>	gen_clean;
+	generate_greedy(&l2, 8, &gen_clean);
+
+	bool	poison_of_reloc1_dest_had_no_effect =
+		(gen_poisoned == gen_clean);
+
+	printf(",\"ground_truth_poison_test\":{"
+		"\"poisoned_tensor_was_relocation1_destination\":true,"
+		"\"generated_after_poisoning_reloc1_dest\":[");
+	print_tokens(stdout, gen_poisoned);
+	printf("],\"independent_clean_reference_same_position\":[");
+	print_tokens(stdout, gen_clean);
+	printf("],\"control_matches_clean_reference\":%s,"
+		"\"interpretation\":\"if control_matches_clean_reference is true, "
+		"decode after 2 relocations is producing CORRECT output "
+		"(ground truth) even if the pointer-identity diagnostics above "
+		"look stale -- the staleness would then be a capture/cb_eval "
+		"artifact, not a real decode-correctness bug. If false, decode "
+		"is genuinely broken after a second relocation of the same "
+		"layer.\"}",
+		poison_of_reloc1_dest_had_no_effect ? "true" : "false");
+
+	printf("}}\n");
+	free_loaded(&l);
+	free_loaded(&l2);
+	return (0);
+}
+
+/* ---------- mode: failure (Section 23) ---------- */
+
+static int	cmd_failure(const char *model, int32_t n_ctx, const char *kvt,
+			int32_t split, const char *fcase)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+
+	ggml_tensor	*before_k = l.cap.k_leaf[0];
+	ggml_backend_dev_t	gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+	bool	ok;
+
+	if (strcmp(fcase, "invalid_layer") == 0)
+	{
+		llama_synchronize(l.ctx);
+		ok = llama_kv_cache_relocate_layer(l.mem, 99999, gpu_dev);
+	}
+	else if (strcmp(fcase, "invalid_dev") == 0)
+	{
+		llama_synchronize(l.ctx);
+		ok = llama_kv_cache_relocate_layer(l.mem, 0, nullptr);
+	}
+	else if (strcmp(fcase, "same_dev") == 0)
+	{
+		ggml_backend_dev_t	same = layer_is_cpu(before_k)
+			? ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU)
+			: gpu_dev;
+		llama_synchronize(l.ctx);
+		ok = llama_kv_cache_relocate_layer(l.mem, 0, same);
+	}
+	else if (strcmp(fcase, "duplicate") == 0)
+	{
+		/* not concurrently -- Section 26 forbids concurrent calls; this
+		 * checks that two SEQUENTIAL calls to the same layer both
+		 * still work and leave a consistent, decodable state (the
+		 * closest safe approximation of "duplicate" this contract
+		 * allows probing). */
+		llama_synchronize(l.ctx);
+		bool	ok1 = gpu_dev && llama_kv_cache_relocate_layer(l.mem, 0, gpu_dev);
+		llama_synchronize(l.ctx);
+		bool	ok2 = ok1 && llama_kv_cache_relocate_layer(l.mem, 0,
+				ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+		ok = ok1 && ok2;
+	}
+	else
+	{
+		fprintf(stderr, "unknown case %s\n", fcase);
+		free_loaded(&l);
+		return (2);
+	}
+
+	ggml_tensor	*after_k = l.cap.k_leaf[0];
+	bool	layer0_untouched = (before_k == after_k);
+	bool	decode_ok = decode_prompt(&l, "still works");
+
+	printf("{\"schema_version\":1,\"mode\":\"failure\",\"case\":\"%s\","
+		"\"relocate_returned_ok\":%s,\"layer0_pointer_untouched\":%s,"
+		"\"decode_still_works\":%s}\n",
+		fcase, ok ? "true" : "false", layer0_untouched ? "true" : "false",
+		decode_ok ? "true" : "false");
+	free_loaded(&l);
+	return (0);
+}
+
+int	main(int argc, char **argv)
+{
+	llama_backend_init();
+	if (argc < 2)
+	{
+		fprintf(stderr, "usage: %s <mode> ...\n", argv[0]);
+		llama_backend_free();
+		return (2);
+	}
+	std::string	mode = argv[1];
+	int	rc = 2;
+
+	if (mode == "info" && argc >= 6)
+		rc = cmd_info(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]));
+	else if (mode == "relocate" && argc >= 7)
+		rc = cmd_relocate(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]), argv[7], argc >= 9 && std::string(argv[8]) == "poison");
+	else if (mode == "roundtrip" && argc >= 7)
+		rc = cmd_roundtrip(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]));
+	else if (mode == "cycle" && argc >= 8)
+		rc = cmd_cycle(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]), atoi(argv[7]));
+	else if (mode == "multi" && argc >= 7)
+	{
+		std::vector<int32_t>	layers;
+		for (int i = 7; i < argc; i++)
+			layers.push_back(atoi(argv[i]));
+		rc = cmd_multi(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			argv[6], layers);
+	}
+	else if (mode == "weights_table" && argc >= 7)
+		rc = cmd_weights_table(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]));
+	else if (mode == "latency" && argc >= 8)
+	{
+		std::vector<int32_t>	layers;
+		for (int i = 8; i < argc; i++)
+			layers.push_back(atoi(argv[i]));
+		rc = cmd_latency(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			argv[6], atoi(argv[7]), layers);
+	}
+	else if (mode == "state_save" && argc >= 7)
+		rc = cmd_state_save(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]));
+	else if (mode == "repro2" && argc >= 8)
+		rc = cmd_repro2(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]), std::string(argv[7]) == "retain",
+			argc >= 9 ? atoi(argv[8]) : 0);
+	else if (mode == "failure" && argc >= 6)
+		rc = cmd_failure(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]), argv[6]);
+	else
+	{
+		fprintf(stderr, "unknown mode or missing args: %s\n", mode.c_str());
+		rc = 2;
+	}
+	llama_backend_free();
+	return (rc);
+}
diff --git a/tools/membrane-kv-runtime-relocate/relocate_state.c b/tools/membrane-kv-runtime-relocate/relocate_state.c
new file mode 100644
index 0000000..17350df
--- /dev/null
+++ b/tools/membrane-kv-runtime-relocate/relocate_state.c
@@ -0,0 +1,76 @@
+#include <stddef.h>
+
+#include "relocate_state.h"
+
+int	membrane_relocate_init(struct s_membrane_relocate_unit *u,
+		int32_t initial_dev, uint64_t bytes)
+{
+	if (u == NULL || bytes == 0)
+		return (0);
+	u->state = MEMBRANE_RELOCATE_STATE_RESIDENT;
+	u->current_dev = initial_dev;
+	u->pending_dev = initial_dev;
+	u->bytes = bytes;
+	u->relocation_count = 0;
+	u->backing_is_dedicated = 0;
+	return (1);
+}
+
+int	membrane_relocate_validate_target(
+		const struct s_membrane_relocate_unit *u,
+		int32_t target_dev, int32_t n_devices)
+{
+	if (u == NULL)
+		return (0);
+	if (target_dev < 0 || target_dev >= n_devices)
+		return (0);
+	if (target_dev == u->current_dev)
+		return (0);
+	return (1);
+}
+
+int	membrane_relocate_begin(struct s_membrane_relocate_unit *u,
+		int32_t target_dev)
+{
+	if (u == NULL || u->state != MEMBRANE_RELOCATE_STATE_RESIDENT)
+		return (0);
+	u->state = MEMBRANE_RELOCATE_STATE_IN_PROGRESS;
+	u->pending_dev = target_dev;
+	return (1);
+}
+
+int	membrane_relocate_commit(struct s_membrane_relocate_unit *u)
+{
+	if (u == NULL || u->state != MEMBRANE_RELOCATE_STATE_IN_PROGRESS)
+		return (0);
+	u->state = MEMBRANE_RELOCATE_STATE_RESIDENT;
+	u->current_dev = u->pending_dev;
+	u->relocation_count++;
+	u->backing_is_dedicated = 1;
+	return (1);
+}
+
+int	membrane_relocate_rollback(struct s_membrane_relocate_unit *u)
+{
+	if (u == NULL || u->state != MEMBRANE_RELOCATE_STATE_IN_PROGRESS)
+		return (0);
+	u->state = MEMBRANE_RELOCATE_STATE_RESIDENT;
+	u->pending_dev = u->current_dev;
+	return (1);
+}
+
+int	membrane_relocate_fail(struct s_membrane_relocate_unit *u)
+{
+	if (u == NULL || u->state != MEMBRANE_RELOCATE_STATE_IN_PROGRESS)
+		return (0);
+	u->state = MEMBRANE_RELOCATE_STATE_ERROR;
+	return (1);
+}
+
+int	membrane_relocate_call_allowed(const struct s_membrane_relocate_unit *u,
+		int decode_in_flight)
+{
+	if (u == NULL || decode_in_flight)
+		return (0);
+	return (u->state == MEMBRANE_RELOCATE_STATE_RESIDENT);
+}
diff --git a/tools/membrane-kv-runtime-relocate/relocate_state.h b/tools/membrane-kv-runtime-relocate/relocate_state.h
new file mode 100644
index 0000000..52999b6
--- /dev/null
+++ b/tools/membrane-kv-runtime-relocate/relocate_state.h
@@ -0,0 +1,119 @@
+#ifndef MEMBRANE_KV_RUNTIME_RELOCATE_RELOCATE_STATE_H
+# define MEMBRANE_KV_RUNTIME_RELOCATE_RELOCATE_STATE_H
+
+# include <stdint.h>
+
+# ifdef __cplusplus
+extern "C" {
+# endif
+
+/*
+ * Phase 12D, Section 30: llama-free (no ggml/llama header) research
+ * state machine + transaction bookkeeping for ONE relocatable KV
+ * layer unit. Unlike Phase 12C's ownership_state.h (which modeled an
+ * IDEALIZED system independent of what the real probe could achieve),
+ * this machine models what tools/membrane-kv-runtime-relocate's real
+ * probe actually does with the real llama_kv_cache_relocate_layer()
+ * primitive: current_dev is an opaque, caller-defined device id (e.g.
+ * 0 = CPU, 1 = GPU) -- this module has no notion of backends at all.
+ * RESEARCH ONLY, experiment/kv-runtime-relocate branch only.
+ */
+
+enum e_membrane_relocate_state
+{
+	MEMBRANE_RELOCATE_STATE_RESIDENT = 0,
+	MEMBRANE_RELOCATE_STATE_IN_PROGRESS,
+	MEMBRANE_RELOCATE_STATE_ERROR
+};
+
+struct s_membrane_relocate_unit
+{
+	enum e_membrane_relocate_state	state;
+	int32_t							current_dev;
+	int32_t							pending_dev;
+	uint64_t						bytes;
+	uint64_t						relocation_count;
+	/* true once the unit's CURRENT backing is a dedicated buffer (i.e.
+	 * it arrived at current_dev via at least one prior successful
+	 * relocation) -- see llama_kv_cache::relocate_layer's contract:
+	 * every relocation destination is dedicated, but the ORIGINAL
+	 * construction-time placement is shared with other layers and is
+	 * therefore never released on the layer's first move away from it. */
+	int								backing_is_dedicated;
+};
+
+/*
+ * Resets *u to RESIDENT at initial_dev, relocation_count == 0,
+ * backing_is_dedicated == 0 (the original construction-time placement
+ * is always shared, never dedicated). bytes must be > 0. Returns 1 on
+ * success, 0 (u untouched) if u is NULL or bytes == 0.
+ */
+int	membrane_relocate_init(struct s_membrane_relocate_unit *u,
+		int32_t initial_dev, uint64_t bytes);
+
+/*
+ * Section 23 pre-flight validation, called BEFORE membrane_relocate_
+ * begin: rejects an invalid target device id (target_dev < 0 or
+ * target_dev >= n_devices) or a no-op relocation (target_dev ==
+ * u->current_dev, i.e. source == destination). Returns 1 if the
+ * target is valid and different from the current device, 0 otherwise.
+ * Does not mutate *u.
+ */
+int	membrane_relocate_validate_target(
+		const struct s_membrane_relocate_unit *u,
+		int32_t target_dev, int32_t n_devices);
+
+/*
+ * RESIDENT -> IN_PROGRESS. Rejects (returns 0, u unchanged) if u is
+ * already IN_PROGRESS (duplicate relocation while one is in flight)
+ * or in ERROR. pending_dev is recorded but current_dev is NOT changed
+ * yet -- the transaction is not committed until membrane_relocate_
+ * commit succeeds.
+ */
+int	membrane_relocate_begin(struct s_membrane_relocate_unit *u,
+		int32_t target_dev);
+
+/*
+ * IN_PROGRESS -> RESIDENT at pending_dev: the copy succeeded and
+ * ownership has been transferred (matches llama_kv_cache::
+ * relocate_layer switching layers[il].k/.v only after a successful
+ * copy). Increments relocation_count and sets backing_is_dedicated
+ * unconditionally (every real relocate_layer destination is a fresh
+ * dedicated buffer). Rejects (returns 0) if u is not IN_PROGRESS.
+ */
+int	membrane_relocate_commit(struct s_membrane_relocate_unit *u);
+
+/*
+ * IN_PROGRESS -> RESIDENT at the ORIGINAL (pre-begin) current_dev,
+ * unchanged: a validated failure BEFORE any persistent reference was
+ * switched (e.g. destination allocation failed) -- this is the
+ * transaction-rollback path, distinct from an unrecoverable failure.
+ * "No half-rebound state": current_dev is exactly what it was before
+ * begin() was called. Rejects (returns 0) if u is not IN_PROGRESS.
+ */
+int	membrane_relocate_rollback(struct s_membrane_relocate_unit *u);
+
+/*
+ * IN_PROGRESS -> ERROR: an unrecoverable failure (should not occur if
+ * llama_kv_cache::relocate_layer's own fail-closed contract holds --
+ * exists so the probe can flag a real violation of that contract
+ * instead of silently treating it as a normal rollback). Rejects
+ * (returns 0) if u is not IN_PROGRESS.
+ */
+int	membrane_relocate_fail(struct s_membrane_relocate_unit *u);
+
+/*
+ * Section 26 thread/synchronization contract: relocate_layer may only
+ * be called between decode calls with the backend already
+ * synchronized. Returns 1 if calling relocate right now is allowed
+ * (currently RESIDENT, not mid-decode per decode_in_flight), 0
+ * otherwise. Pure predicate, does not mutate *u.
+ */
+int	membrane_relocate_call_allowed(const struct s_membrane_relocate_unit *u,
+		int decode_in_flight);
+
+# ifdef __cplusplus
+}
+# endif
+
+#endif
diff --git a/tools/membrane-kv-runtime-relocate/test_relocate_state.c b/tools/membrane-kv-runtime-relocate/test_relocate_state.c
new file mode 100644
index 0000000..6f08d09
--- /dev/null
+++ b/tools/membrane-kv-runtime-relocate/test_relocate_state.c
@@ -0,0 +1,184 @@
+#include "relocate_state.h"
+#include "test_helpers.h"
+
+static void	test_init_basic(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	TEST_ASSERT(membrane_relocate_init(&u, 0, 1024) == 1, "init succeeds");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_RESIDENT,
+		"starts RESIDENT");
+	TEST_ASSERT(u.current_dev == 0, "current_dev == initial_dev");
+	TEST_ASSERT(u.backing_is_dedicated == 0,
+		"initial construction-time placement is never dedicated");
+	TEST_ASSERT(u.relocation_count == 0, "relocation_count starts at 0");
+}
+
+static void	test_init_rejects_bad_input(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	TEST_ASSERT(membrane_relocate_init(NULL, 0, 1024) == 0,
+		"NULL out pointer fails closed");
+	TEST_ASSERT(membrane_relocate_init(&u, 0, 0) == 0,
+		"zero bytes fails closed");
+}
+
+static void	test_validate_target_rejects_invalid_device(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 1024);
+	TEST_ASSERT(membrane_relocate_validate_target(&u, -1, 2) == 0,
+		"negative target device is invalid");
+	TEST_ASSERT(membrane_relocate_validate_target(&u, 2, 2) == 0,
+		"out-of-range target device is invalid");
+	TEST_ASSERT(membrane_relocate_validate_target(&u, 1, 2) == 1,
+		"in-range, different target device is valid");
+}
+
+static void	test_validate_target_rejects_source_eq_dest(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 1024);
+	TEST_ASSERT(membrane_relocate_validate_target(&u, 0, 2) == 0,
+		"target == current_dev (source == destination) is rejected");
+}
+
+static void	test_full_relocate_commit_cycle(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 4096);
+	TEST_ASSERT(membrane_relocate_begin(&u, 1) == 1,
+		"RESIDENT + begin(1) is legal");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_IN_PROGRESS,
+		"now IN_PROGRESS");
+	TEST_ASSERT(u.current_dev == 0,
+		"current_dev NOT changed until commit (ownership transfer only "
+		"after success)");
+	TEST_ASSERT(membrane_relocate_commit(&u) == 1,
+		"IN_PROGRESS + commit is legal");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_RESIDENT, "now RESIDENT");
+	TEST_ASSERT(u.current_dev == 1, "current_dev updated to pending_dev");
+	TEST_ASSERT(u.relocation_count == 1, "relocation_count incremented");
+	TEST_ASSERT(u.backing_is_dedicated == 1,
+		"backing is dedicated after any successful relocation");
+}
+
+static void	test_rollback_restores_original_dev_no_half_state(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 2048);
+	membrane_relocate_begin(&u, 1);
+	TEST_ASSERT(membrane_relocate_rollback(&u) == 1,
+		"IN_PROGRESS + rollback is legal");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_RESIDENT,
+		"rollback returns to RESIDENT, not ERROR");
+	TEST_ASSERT(u.current_dev == 0,
+		"current_dev unchanged -- no half-rebound state");
+	TEST_ASSERT(u.relocation_count == 0,
+		"rollback does not count as a relocation");
+	TEST_ASSERT(u.backing_is_dedicated == 0,
+		"rollback does not mark backing dedicated");
+}
+
+static void	test_fail_lands_in_error(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 512);
+	membrane_relocate_begin(&u, 1);
+	TEST_ASSERT(membrane_relocate_fail(&u) == 1,
+		"IN_PROGRESS + fail is legal");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_ERROR, "now ERROR");
+}
+
+static void	test_duplicate_relocation_rejected(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 1000);
+	membrane_relocate_begin(&u, 1);
+	TEST_ASSERT(membrane_relocate_begin(&u, 1) == 0,
+		"begin() while already IN_PROGRESS (duplicate relocation) is "
+		"illegal");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_IN_PROGRESS,
+		"rejected event leaves state unchanged");
+}
+
+static void	test_commit_and_rollback_from_resident_rejected(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 64);
+	TEST_ASSERT(membrane_relocate_commit(&u) == 0,
+		"commit from RESIDENT (no transaction in flight) is illegal");
+	TEST_ASSERT(membrane_relocate_rollback(&u) == 0,
+		"rollback from RESIDENT is illegal");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_RESIDENT,
+		"still RESIDENT, unchanged");
+}
+
+static void	test_error_is_terminal(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 64);
+	membrane_relocate_begin(&u, 1);
+	membrane_relocate_fail(&u);
+	TEST_ASSERT(membrane_relocate_begin(&u, 1) == 0,
+		"no event accepted from ERROR");
+	TEST_ASSERT(u.state == MEMBRANE_RELOCATE_STATE_ERROR,
+		"stays in ERROR, never silently recovers");
+}
+
+static void	test_second_relocation_still_dedicated(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 4096);
+	membrane_relocate_begin(&u, 1);
+	membrane_relocate_commit(&u);
+	membrane_relocate_begin(&u, 0);
+	membrane_relocate_commit(&u);
+	TEST_ASSERT(u.current_dev == 0, "round trip back to dev 0");
+	TEST_ASSERT(u.relocation_count == 2, "two relocations counted");
+	TEST_ASSERT(u.backing_is_dedicated == 1,
+		"still dedicated after the round trip -- this predicts the "
+		"NEXT move away from here will be able to release its backing");
+}
+
+static void	test_call_allowed_predicate(void)
+{
+	struct s_membrane_relocate_unit	u;
+
+	membrane_relocate_init(&u, 0, 64);
+	TEST_ASSERT(membrane_relocate_call_allowed(&u, 0) == 1,
+		"RESIDENT + no decode in flight -> allowed");
+	TEST_ASSERT(membrane_relocate_call_allowed(&u, 1) == 0,
+		"decode in flight -> not allowed, regardless of state");
+	membrane_relocate_begin(&u, 1);
+	TEST_ASSERT(membrane_relocate_call_allowed(&u, 0) == 0,
+		"IN_PROGRESS -> not allowed (duplicate relocation guard)");
+}
+
+int	main(void)
+{
+	test_init_basic();
+	test_init_rejects_bad_input();
+	test_validate_target_rejects_invalid_device();
+	test_validate_target_rejects_source_eq_dest();
+	test_full_relocate_commit_cycle();
+	test_rollback_restores_original_dev_no_half_state();
+	test_fail_lands_in_error();
+	test_duplicate_relocation_rejected();
+	test_commit_and_rollback_from_resident_rejected();
+	test_error_is_terminal();
+	test_second_relocation_still_dedicated();
+	test_call_allowed_predicate();
+	printf("test_relocate_state: all tests passed\n");
+	return (0);
+}
