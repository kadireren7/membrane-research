+/* ---------- mode: weights_table ---------- */
+
+static int	cmd_weights_table(const char *model, int32_t n_ctx,
+			const char *kvt, int32_t split, int32_t relocate_layer_idx)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+
+	printf("{\"schema_version\":1,\"mode\":\"weights_table\","
+		"\"kv_type\":\"%s\",\"relocated_layer\":%d,\"rows\":[",
+		kv_type_name(kvt), relocate_layer_idx);
+	bool	first = true;
+	std::vector<std::string>	kv_before(l.n_layer);
+	for (int32_t i = 0; i < l.n_layer; i++)
+		kv_before[i] = layer_is_cpu(l.cap.k_leaf[i]) ? "CPU" : "GPU";
+
+	ggml_backend_dev_t	gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+	ggml_backend_dev_t	cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+	ggml_backend_dev_t	dst = layer_is_cpu(l.cap.k_leaf[relocate_layer_idx]) ? gpu_dev : cpu_dev;
+	llama_synchronize(l.ctx);
+	bool	reloc_ok = dst && llama_kv_cache_relocate_layer(l.mem, relocate_layer_idx, dst);
+	decode_prompt(&l, "second sentence");
+
+	for (int32_t i = 0; i < l.n_layer; i++)
+	{
+		/* weight tensor for this layer -- capture via a distinct
+		 * name-matched tensor: blk.<il>.attn_q.weight, always resident
+		 * on the same device mp.n_gpu_layers=-1 placed it on
+		 * (kv_dev_override never touches weights). Located generically
+		 * by scanning ggml_get_first_tensor over the model's own
+		 * context would need extra plumbing; instead we rely on the
+		 * already-established Phase 12B/12C invariant (mp.n_gpu_layers
+		 * = -1 forces full GPU weight residency) and report it as a
+		 * constant, cross-checked once via vram_used_mib below rather
+		 * than per-layer (see known limitation in manifest.json).
+		 */
+		printf("%s{\"layer\":%d,\"weight_device\":\"Vulkan(n_gpu_layers=-1)\","
+			"\"kv_before\":\"%s\",\"kv_after\":\"%s\"}",
+			first ? "" : ",", i, kv_before[i].c_str(),
+			i == relocate_layer_idx
+				? (layer_is_cpu(l.cap.k_leaf[i]) ? "CPU" : "GPU")
+				: kv_before[i].c_str());
+		first = false;
+	}
+	printf("],\"relocate_ok\":%s,\"vram_used_mib\":%ld}\n",
+		reloc_ok ? "true" : "false", nvidia_smi_used_mib());
+	free_loaded(&l);
+	return (0);
+}
