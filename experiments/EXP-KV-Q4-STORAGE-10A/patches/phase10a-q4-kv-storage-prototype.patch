+ * rather than one silently standing in for the other. */
+static void	test_q4_llama_smollm2_shape_ok(void)
+{
+	membrane_compat_result_t	r;
+
+	TEST_ASSERT(membrane_check_kv_compat("llama", 576, 9, 3, 2048, KV_Q4,
+			&r) == 1, "SmolLM2-135M's real shape passes q4 compat");
+	TEST_ASSERT(r.ok == 1, "out->ok reflects success");
