+static void	test_q4_head_dim_not_block_aligned_rejected(void)
+{
+	membrane_compat_result_t	r;
+
+	/* Same n_embd=640/n_head=8 (head dim 80) case as the q8 test. */
+	TEST_ASSERT(membrane_check_kv_compat("llama", 640, 8, 8, 2048, KV_Q4,
+			&r) == 0, "head dim 80 (not divisible by 32) rejected for q4");
+	TEST_ASSERT(strstr(r.reason, "80") != NULL,
+		"the actual head dimension appears in the reason");
+	TEST_ASSERT(strstr(r.reason, "Q4_0") != NULL,
+		"the reason names Q4_0, not Q8_0, for a q4 check");
+	TEST_ASSERT(strstr(r.reason, "Q8_0") == NULL,
+		"a q4 check's reason never mentions Q8_0");
+}
+
