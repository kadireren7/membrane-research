+		return False, "no CPU context_matrix rows found"
+	for row in rows:
+		vals = {m: row[m]["kv_allocated_bytes"] for m in ("q4", "q5_0", "q5_1", "q8", "native")}
+		if not (vals["q4"] < vals["q5_0"] < vals["q5_1"] < vals["q8"] < vals["native"]):
+			bad.append(f"ctx={row['ctx']}: bytes not strictly ordered "
+				f"q4({vals['q4']}) < q5_0({vals['q5_0']}) < q5_1({vals['q5_1']}) "
