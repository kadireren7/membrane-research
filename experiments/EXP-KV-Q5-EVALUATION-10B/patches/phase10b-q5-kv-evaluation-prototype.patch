+# ---------------------------------------------------------------------
+# Phase 10B: experimental Q5 KV evaluation artifact
+# ---------------------------------------------------------------------
+P10B_ARTIFACT_PATH = REPO_ROOT / "results" / "phase10" / "q5-kv-evaluation.json"
+_P10B_CACHE = {}
+
+
+def _load_p10b_artifact():
+	key = str(P10B_ARTIFACT_PATH)
+	if key not in _P10B_CACHE:
+		_P10B_CACHE[key] = json.loads(P10B_ARTIFACT_PATH.read_text())
+	return _P10B_CACHE[key]
+
+
+@check("Phase 10B artifact exists, is valid JSON, and has schema_version 1")
+def _c51():
+	if not P10B_ARTIFACT_PATH.exists():
+		return False, f"{P10B_ARTIFACT_PATH} does not exist"
+	a = _load_p10b_artifact()
+	ok = a.get("schema_version") == 1
+	return ok, f"schema_version={a.get('schema_version')!r}"
+
+
+@check("Phase 10B artifact: membrane_commit and llama_cpp_commit look "
+	"like real commit SHAs (40 hex chars)")
+def _c52():
+	a = _load_p10b_artifact()
+	bad = []
+	for key in ("membrane_commit", "membrane_base_commit", "llama_cpp_commit"):
+		sha = a.get(key, "")
+		if not re.fullmatch(r"[0-9a-f]{40}", sha):
+			bad.append(f"{key}={sha!r}")
+	return len(bad) == 0, "; ".join(bad) if bad else "all 3 commit fields well-formed"
+
