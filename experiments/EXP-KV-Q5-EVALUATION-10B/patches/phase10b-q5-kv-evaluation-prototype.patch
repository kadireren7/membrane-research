+	return ok, f"q4 artifact verdict={a.get('decision_gate', {}).get('verdict')!r}"
+
+
+@check("Phase 10B artifact: CPU context matrix -- q4 < q5_0 < q5_1 < "
+	"q8 < native bytes at every row (real format ordering)")
+def _c54():
+	a = _load_p10b_artifact()
+	rows = a.get("cpu_validation_135m", {}).get("context_matrix", [])
+	bad = []
