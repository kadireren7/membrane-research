+/* Phase 10A: Q4_0, 32-element blocks, 18 bytes/block (2-byte scale +
+ * 16 bytes packed nibbles) -- a 64-wide head is 2 blocks = 36
+ * bytes/token. */
+static void	test_total_bytes_q4(void)
+{
+	membrane_kv_store_bytes_t	b;
+	uint64_t					total;
+
+	b.n_layer = 30;
+	b.kv_size = 2048;
+	b.bytes_per_token_k = 36;	/* 2 blocks * 18 bytes (Q4_0) */
+	b.bytes_per_token_v = 36;
+	total = membrane_kv_store_total_bytes(&b);
+	TEST_ASSERT(total == 30ULL * 2048ULL * 72ULL,
+		"q4 bytes = n_layer * kv_size * (k_row + v_row)");
+}
+
+/* Phase 10B: Q5_0, 32-element blocks, 22 bytes/block (2-byte scale +
+ * 4-byte qh[] 5th-bit group + 16 bytes packed nibbles) -- a 64-wide
+ * head is 2 blocks = 44 bytes/token. */
+static void	test_total_bytes_q5_0(void)
+{
+	membrane_kv_store_bytes_t	b;
+	uint64_t					total;
+
+	b.n_layer = 30;
+	b.kv_size = 2048;
+	b.bytes_per_token_k = 44;	/* 2 blocks * 22 bytes (Q5_0) */
+	b.bytes_per_token_v = 44;
+	total = membrane_kv_store_total_bytes(&b);
+	TEST_ASSERT(total == 30ULL * 2048ULL * 88ULL,
+		"q5_0 bytes = n_layer * kv_size * (k_row + v_row)");
+}
+
+/* Phase 10B: Q5_1, 32-element blocks, 24 bytes/block (4-byte
+ * scale+min + 4-byte qh[] + 16 bytes packed nibbles) -- a 64-wide
+ * head is 2 blocks = 48 bytes/token. Deliberately a SEPARATE test
+ * from Q5_0's, not a parameterized variant of it -- Section 1's own
+ * instruction is not to assume the two Q5 formats behave identically,
+ * and this file should not silently bake that assumption in either. */
+static void	test_total_bytes_q5_1(void)
+{
+	membrane_kv_store_bytes_t	b;
+	uint64_t					total;
+
+	b.n_layer = 30;
+	b.kv_size = 2048;
+	b.bytes_per_token_k = 48;	/* 2 blocks * 24 bytes (Q5_1) */
+	b.bytes_per_token_v = 48;
+	total = membrane_kv_store_total_bytes(&b);
+	TEST_ASSERT(total == 30ULL * 2048ULL * 96ULL,
+		"q5_1 bytes = n_layer * kv_size * (k_row + v_row)");
+}
+
+/* Phase 10B Section 17: "no accidental Q4/Q8 aliasing" -- proves the
+ * five modes' byte totals are strictly ordered for the exact same
+ * layer/kv_size/head shape, matching each format's real ggml block
+ * cost (4.5/5.5/6/8.5/16 bits per element respectively). A copy-paste
+ * bug that aliased e.g. q5_1's byte-per-token constant to q8's would
+ * be caught here, not just by the individual per-type tests above. */
+static void	test_all_five_modes_strictly_ordered_same_shape(void)
+{
+	membrane_kv_store_bytes_t	shape;
+	uint64_t					native_total;
+	uint64_t					q8_total;
+	uint64_t					q5_1_total;
+	uint64_t					q5_0_total;
+	uint64_t					q4_total;
+
+	shape.n_layer = 30;
+	shape.kv_size = 2048;
+
+	shape.bytes_per_token_k = shape.bytes_per_token_v = 128;
+	native_total = membrane_kv_store_total_bytes(&shape);
+	shape.bytes_per_token_k = shape.bytes_per_token_v = 68;
+	q8_total = membrane_kv_store_total_bytes(&shape);
+	shape.bytes_per_token_k = shape.bytes_per_token_v = 48;
+	q5_1_total = membrane_kv_store_total_bytes(&shape);
+	shape.bytes_per_token_k = shape.bytes_per_token_v = 44;
+	q5_0_total = membrane_kv_store_total_bytes(&shape);
+	shape.bytes_per_token_k = shape.bytes_per_token_v = 36;
+	q4_total = membrane_kv_store_total_bytes(&shape);
+
+	TEST_ASSERT(q4_total < q5_0_total && q5_0_total < q5_1_total
+			&& q5_1_total < q8_total && q8_total < native_total,
+		"q4 < q5_0 < q5_1 < q8 < native for the same layer/kv_size/"
+		"head shape, no two modes accidentally alias the same bytes");
+}
