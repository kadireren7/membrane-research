+@check("Phase 12C: no absolute filesystem paths (/home/..., /tmp/..., "
+	"etc.) leaked in any promotion-prefetch .json/.jsonl artifact")
+def _c86():
+	pattern = re.compile(r'(?<![\w.\-:/])/[A-Za-z0-9_.\-]+(?:/[A-Za-z0-9_.\-]+)+')
