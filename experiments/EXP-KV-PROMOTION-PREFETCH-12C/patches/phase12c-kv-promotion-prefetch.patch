+	if len(raw_by_case) < 5:
+		bad.append(f"raw_failure_cases.jsonl has only {len(raw_by_case)} cases, need >= 5")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{n_with_result} recorded failure cases, all fail closed, backed by raw_failure_cases.jsonl"
