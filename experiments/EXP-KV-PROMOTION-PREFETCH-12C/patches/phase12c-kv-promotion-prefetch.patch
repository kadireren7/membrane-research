+V12C_DIR = REPO_ROOT / "results" / "phase12" / "promotion-prefetch"
+_V12C_CACHE = {}
+
+
+def _load_v12c(name):
+	key = name
+	if key not in _V12C_CACHE:
+		path = V12C_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V12C_CACHE[key] = rows
+		else:
+			_V12C_CACHE[key] = json.loads(path.read_text())
+	return _V12C_CACHE[key]
+
+
+@check("Phase 12C: manifest.json exists, valid JSON, schema_version 1, "
+	"lists every actual .json/.jsonl file in the directory (including "
+	"itself) and no others")
+def _c76():
+	if not (V12C_DIR / "manifest.json").exists():
+		return False, f"{V12C_DIR}/manifest.json does not exist"
+	m = _load_v12c("manifest.json")
+	bad = []
+	if m.get("schema_version") != 1:
+		bad.append(f"schema_version={m.get('schema_version')!r}")
+	listed = set(m.get("files", {}).keys())
+	actual = {p.name for p in V12C_DIR.glob("*") if p.suffix in (".json", ".jsonl")}
+	if listed != actual:
+		bad.append(f"listed-vs-actual mismatch: missing={actual - listed}, extra={listed - actual}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(listed)} files listed, exact match with directory contents"
+
+
+@check("Phase 12C: ownership_model.json's live-rebind classification is "
+	"'B' (COPY_WORKS_BUT_PLACEMENT_IS_STATIC) and is consistent with "
+	"single_layer_promotion.json / single_layer_demotion.json's own "
+	"classification fields -- no file is allowed to silently claim a "
+	"different (stronger) classification")
+def _c77():
+	om = _load_v12c("ownership_model.json")
+	slp = _load_v12c("single_layer_promotion.json")
+	sld = _load_v12c("single_layer_demotion.json")
+	bad = []
+	if om.get("live_rebind_classification") != "B":
+		bad.append(f"ownership_model.json classification={om.get('live_rebind_classification')!r} != 'B'")
+	if slp.get("classification") != "B":
+		bad.append(f"single_layer_promotion.json classification={slp.get('classification')!r} != 'B'")
+	if sld.get("classification") != "B":
+		bad.append(f"single_layer_demotion.json classification={sld.get('classification')!r} != 'B'")
+	if "duplicate" not in om.get("explicit_tiering_disclosure", "").lower():
+		bad.append("explicit_tiering_disclosure does not mention duplicate backing")
+	return len(bad) == 0, "; ".join(bad) if bad else "classification 'B' consistent across ownership_model/single_layer_promotion/single_layer_demotion"
+
+
+@check("Phase 12C: single_layer_promotion.json / single_layer_demotion."
+	"json hash_match and roundtrip_byte_equal claims are recomputed "
+	"exactly from the underlying raw promote/demote JSON files' own "
+	"src_hash_k/v and dst_hash_k/v fields")
+def _c78():
+	bad = []
+	for artifact_name, raw_names in (
+		("single_layer_promotion.json", [
+			("smollm2_135m_ctx2048_q8_layer4", "raw_promote_135m_layer4.json"),
+			("smollm2_360m_ctx2048_q8_layer4", "raw_promote_360m_layer4.json"),
+		]),
+		("single_layer_demotion.json", [
+			("smollm2_135m_ctx2048_q8_layer20", "raw_demote_135m_layer20.json"),
+			("smollm2_360m_ctx2048_q8_layer20", "raw_demote_360m_layer20.json"),
+		]),
+	):
+		art = _load_v12c(artifact_name)
+		trials = art.get("trials", {})
+		for trial_key, raw_name in raw_names:
+			raw = _load_v12c(raw_name)
+			t = trials.get(trial_key, {})
+			real_hash_match = raw.get("src_hash_k") == raw.get("dst_hash_k") and raw.get("src_hash_v") == raw.get("dst_hash_v")
+			if t.get("hash_match") != real_hash_match:
+				bad.append(f"{artifact_name}/{trial_key}: hash_match claim {t.get('hash_match')} != recomputed {real_hash_match}")
+			if t.get("roundtrip_byte_equal") != raw.get("roundtrip_byte_equal"):
+				bad.append(f"{artifact_name}/{trial_key}: roundtrip_byte_equal claim mismatches raw file")
+			if t.get("poison_had_no_effect_on_output") != raw.get("poison_had_no_effect_on_output"):
+				bad.append(f"{artifact_name}/{trial_key}: poison_had_no_effect_on_output claim mismatches raw file")
+	return len(bad) == 0, "; ".join(bad) if bad else "all hash_match/roundtrip/poison claims recomputed exactly from raw promote/demote files"
+
+
+@check("Phase 12C: copy_microbench.json's mean latency for every "
+	"(group size, direction, sync/async) combination is recomputed "
+	"exactly from raw_copybench.jsonl, and every combination has >= 10 "
+	"repetitions")
+def _c79():
+	rows = _load_v12c("raw_copybench.jsonl")
+	mb = _load_v12c("copy_microbench.json")
+	by_key = {}
+	for r in rows:
+		by_key.setdefault((r["bytes"], r["direction"], r["sync"]), []).append(r["ms"])
+	bad = []
+	for key, entry in mb.get("results", {}).items():
+		k = (entry["bytes"], entry["direction"], entry["sync"])
+		vals = by_key.get(k)
+		if not vals:
+			bad.append(f"{key}: no matching raw rows for {k}")
+			continue
+		if len(vals) < 10:
+			bad.append(f"{key}: only {len(vals)} raw repetitions, need >= 10")
+		recomputed_mean = round(sum(vals) / len(vals), 4)
+		claimed_mean = entry.get("latency_ms", {}).get("mean")
+		if abs(recomputed_mean - claimed_mean) > 1e-3:
+			bad.append(f"{key}: recomputed mean {recomputed_mean} != claimed {claimed_mean}")
+	return len(bad) == 0, "; ".join(bad[:5]) if bad else f"{len(mb.get('results', {}))} group/direction/sync combinations recomputed exactly from raw_copybench.jsonl, all >= 10 reps"
+
+
+@check("Phase 12C: cycle_stability.json's byte-identity, RSS-growth, "
+	"and VRAM-creep claims are recomputed exactly from "
+	"raw_cycle_stability.jsonl, and at least 50 cycles were run")
+def _c80():
+	rows = _load_v12c("raw_cycle_stability.jsonl")
+	cs = _load_v12c("cycle_stability.json")
+	bad = []
+	if len(rows) < 50:
+		bad.append(f"only {len(rows)} cycles recorded, need >= 50")
+	if cs.get("n_cycles") != len(rows):
+		bad.append(f"n_cycles claim {cs.get('n_cycles')} != actual raw row count {len(rows)}")
+	real_all_ok = all(r["byte_ok"] for r in rows) and all(r["alloc_ok"] for r in rows)
+	if cs.get("all_byte_identity_ok") != all(r["byte_ok"] for r in rows):
+		bad.append("all_byte_identity_ok claim mismatches raw data")
+	if cs.get("all_alloc_ok") != all(r["alloc_ok"] for r in rows):
+		bad.append("all_alloc_ok claim mismatches raw data")
+	rss = [r["rss_kb"] for r in rows]
+	if cs.get("rss_kb", {}).get("growth_kb") != rss[-1] - rss[0]:
+		bad.append("rss_kb.growth_kb does not match last-first from raw data")
+	if not real_all_ok and cs.get("crash") is False:
+		bad.append("byte/alloc failures present but crash claimed False")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(rows)} cycles, all claims recomputed exactly from raw_cycle_stability.jsonl"
+
+
+@check("Phase 12C: failure_cases.json -- every case with a recorded "
