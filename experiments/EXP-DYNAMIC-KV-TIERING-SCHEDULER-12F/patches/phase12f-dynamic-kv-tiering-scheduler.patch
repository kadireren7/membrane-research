+(R / "correctness.json").write_text(json.dumps(correctness, indent=2))
+
+# ---------- hotset_sweep.json (Section 13) + performance.json (Section 12) + pareto.json (Section 25) ----------
+hotset_sweep = {"schema_version": 1, "runs": hotset}
+(R / "hotset_sweep.json").write_text(json.dumps(hotset_sweep, indent=2))
+
+pareto = {
