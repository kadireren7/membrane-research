+#include <stddef.h>
+
+#include "scheduler_core.h"
+
+static int	layer_in_array(const int32_t *arr, int32_t n, int32_t layer)
+{
+	int32_t	i;
+
+	i = 0;
+	while (i < n)
+	{
+		if (arr[i] == layer)
+			return (1);
+		i++;
+	}
+	return (0);
+}
+
+static int	group_has_duplicate(const struct s_membrane_tiering_group *g)
+{
+	int32_t	i;
+	int32_t	j;
+
+	i = 0;
+	while (i < g->n_layers)
+	{
+		j = i + 1;
+		while (j < g->n_layers)
+		{
+			if (g->layers[i] == g->layers[j])
+				return (1);
+			j++;
+		}
+		i++;
+	}
+	return (0);
+}
+
+int	membrane_tiering_validate_config(
+		const struct s_membrane_tiering_config *config,
+		int32_t n_total_layers, const char **err_out)
+{
+	int32_t	i;
+	int32_t	j;
+
+	if (config == NULL || n_total_layers <= 0
+			|| n_total_layers > MEMBRANE_TIERING_MAX_LAYERS)
+	{
+		if (err_out)
+			*err_out = "invalid n_total_layers";
+		return (0);
+	}
+	if (config->n_total_layers != n_total_layers)
+	{
+		if (err_out)
+			*err_out = "config.n_total_layers mismatch";
+		return (0);
+	}
+	if (config->n_gpu_layers < 0
+			|| config->n_gpu_layers > MEMBRANE_TIERING_MAX_LAYERS)
+	{
+		if (err_out)
+			*err_out = "n_gpu_layers out of bounds";
+		return (0);
+	}
+	i = 0;
+	while (i < config->n_gpu_layers)
+	{
+		if (config->gpu_layers[i] < 0
+				|| config->gpu_layers[i] >= n_total_layers)
+		{
+			if (err_out)
+				*err_out = "gpu_layers contains an out-of-range layer";
+			return (0);
+		}
+		j = i + 1;
+		while (j < config->n_gpu_layers)
+		{
+			if (config->gpu_layers[i] == config->gpu_layers[j])
+			{
+				if (err_out)
+					*err_out = "gpu_layers contains a duplicate layer";
+				return (0);
+			}
+			j++;
+		}
+		i++;
+	}
+	if (config->n_promotion_groups < 0
+			|| config->n_promotion_groups > MEMBRANE_TIERING_MAX_GROUPS
+			|| config->n_demotion_groups < 0
+			|| config->n_demotion_groups > MEMBRANE_TIERING_MAX_GROUPS)
+	{
+		if (err_out)
+			*err_out = "group count out of bounds";
+		return (0);
+	}
+	i = 0;
+	while (i < config->n_promotion_groups)
+	{
+		const struct s_membrane_tiering_group	*g = &config->promotion_groups[i];
+
+		if (g->n_layers < 0 || g->n_layers > MEMBRANE_TIERING_MAX_GROUP_LAYERS)
+		{
+			if (err_out)
+				*err_out = "promotion group layer count out of bounds";
+			return (0);
+		}
+		if (group_has_duplicate(g))
+		{
+			if (err_out)
+				*err_out = "promotion group contains a duplicate layer";
+			return (0);
+		}
+		j = 0;
+		while (j < g->n_layers)
+		{
+			if (g->layers[j] < 0 || g->layers[j] >= n_total_layers)
+			{
+				if (err_out)
+					*err_out = "promotion group contains an out-of-range layer";
+				return (0);
+			}
+			j++;
+		}
+		i++;
+	}
+	i = 0;
+	while (i < config->n_demotion_groups)
+	{
+		const struct s_membrane_tiering_group	*g = &config->demotion_groups[i];
+
+		if (g->n_layers < 0 || g->n_layers > MEMBRANE_TIERING_MAX_GROUP_LAYERS)
+		{
+			if (err_out)
+				*err_out = "demotion group layer count out of bounds";
+			return (0);
+		}
+		if (group_has_duplicate(g))
+		{
+			if (err_out)
+				*err_out = "demotion group contains a duplicate layer";
+			return (0);
+		}
+		j = 0;
+		while (j < g->n_layers)
+		{
+			if (g->layers[j] < 0 || g->layers[j] >= n_total_layers)
+			{
+				if (err_out)
+					*err_out = "demotion group contains an out-of-range layer";
+				return (0);
+			}
+			j++;
+		}
+		i++;
+	}
+	return (1);
+}
+
+int	membrane_tiering_init(const struct s_membrane_tiering_config *config,
+		int32_t n_total_layers,
+		enum e_membrane_tiering_layer_state *layer_states,
+		enum e_membrane_tiering_sched_state *sched_state)
+{
+	int32_t	i;
+
+	if (!membrane_tiering_validate_config(config, n_total_layers, NULL)
+			|| layer_states == NULL || sched_state == NULL)
+		return (0);
+	i = 0;
+	while (i < n_total_layers)
+	{
+		layer_states[i] = MEMBRANE_TIERING_LAYER_CPU_RESIDENT;
+		i++;
+	}
+	i = 0;
+	while (i < config->n_gpu_layers)
+	{
+		layer_states[config->gpu_layers[i]] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+		i++;
+	}
+	*sched_state = MEMBRANE_TIERING_SCHED_IDLE;
+	return (1);
+}
+
+int32_t	membrane_tiering_plan(const struct s_membrane_tiering_config *config,
+		int32_t decode_idx,
+		const enum e_membrane_tiering_layer_state *layer_states,
+		struct s_membrane_tiering_action_entry *out_actions)
+{
+	int32_t	n_out;
+	int32_t	i;
+	int32_t	j;
+
+	if (config == NULL || layer_states == NULL || out_actions == NULL)
+		return (0);
+	n_out = 0;
+	i = 0;
+	while (i < config->n_promotion_groups)
+	{
+		const struct s_membrane_tiering_group	*g = &config->promotion_groups[i];
+
+		if (g->decode_trigger == decode_idx)
+		{
+			j = 0;
+			while (j < g->n_layers)
+			{
+				int32_t	layer = g->layers[j];
+
+				out_actions[n_out].layer = layer;
+				if (layer_states[layer] == MEMBRANE_TIERING_LAYER_GPU_RESIDENT)
+				{
+					out_actions[n_out].action = MEMBRANE_TIERING_ACTION_NONE;
+					out_actions[n_out].reason = MEMBRANE_TIERING_REASON_ALREADY_RESIDENT;
+				}
+				else
+				{
+					out_actions[n_out].action = MEMBRANE_TIERING_ACTION_PROMOTE;
+					out_actions[n_out].reason = MEMBRANE_TIERING_REASON_SCHEDULED_PROMOTION;
+				}
+				n_out++;
+				j++;
+			}
+		}
+		i++;
+	}
+	i = 0;
+	while (i < config->n_demotion_groups)
+	{
+		const struct s_membrane_tiering_group	*g = &config->demotion_groups[i];
+
+		if (g->decode_trigger == decode_idx)
+		{
+			j = 0;
+			while (j < g->n_layers)
+			{
+				int32_t	layer = g->layers[j];
+
+				out_actions[n_out].layer = layer;
+				if (layer_states[layer] == MEMBRANE_TIERING_LAYER_CPU_RESIDENT)
+				{
+					out_actions[n_out].action = MEMBRANE_TIERING_ACTION_NONE;
+					out_actions[n_out].reason = MEMBRANE_TIERING_REASON_ALREADY_RESIDENT;
+				}
+				else
+				{
+					out_actions[n_out].action = MEMBRANE_TIERING_ACTION_DEMOTE;
+					out_actions[n_out].reason = MEMBRANE_TIERING_REASON_SCHEDULED_DEMOTION;
+				}
+				n_out++;
+				j++;
+			}
+		}
+		i++;
+	}
+	return (n_out);
+}
+
+int	membrane_tiering_budget_ok(uint64_t free_vram_bytes,
+		uint64_t reserve_bytes, uint64_t runtime_margin_bytes,
+		uint64_t promotion_bytes)
+{
+	uint64_t	need;
+	uint64_t	sum;
+
+	need = reserve_bytes;
+	sum = need + promotion_bytes;
+	if (sum < need)
+		return (0);
+	need = sum;
+	sum = need + runtime_margin_bytes;
+	if (sum < need)
+		return (0);
+	return (free_vram_bytes >= sum);
+}
+
+int	membrane_tiering_begin_promote(enum e_membrane_tiering_layer_state *s)
+{
+	if (s == NULL || *s != MEMBRANE_TIERING_LAYER_CPU_RESIDENT)
+		return (0);
+	*s = MEMBRANE_TIERING_LAYER_PROMOTING;
+	return (1);
+}
+
+int	membrane_tiering_commit_promote(enum e_membrane_tiering_layer_state *s)
+{
+	if (s == NULL || *s != MEMBRANE_TIERING_LAYER_PROMOTING)
+		return (0);
+	*s = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+	return (1);
+}
+
+int	membrane_tiering_fail_promote(enum e_membrane_tiering_layer_state *s)
+{
+	if (s == NULL || *s != MEMBRANE_TIERING_LAYER_PROMOTING)
+		return (0);
+	*s = MEMBRANE_TIERING_LAYER_ERROR;
+	return (1);
+}
+
+int	membrane_tiering_begin_demote(enum e_membrane_tiering_layer_state *s)
+{
+	if (s == NULL || *s != MEMBRANE_TIERING_LAYER_GPU_RESIDENT)
+		return (0);
+	*s = MEMBRANE_TIERING_LAYER_DEMOTING;
+	return (1);
+}
+
+int	membrane_tiering_commit_demote(enum e_membrane_tiering_layer_state *s)
+{
+	if (s == NULL || *s != MEMBRANE_TIERING_LAYER_DEMOTING)
+		return (0);
+	*s = MEMBRANE_TIERING_LAYER_CPU_RESIDENT;
+	return (1);
+}
+
+int	membrane_tiering_fail_demote(enum e_membrane_tiering_layer_state *s)
+{
+	if (s == NULL || *s != MEMBRANE_TIERING_LAYER_DEMOTING)
+		return (0);
+	*s = MEMBRANE_TIERING_LAYER_ERROR;
+	return (1);
+}
diff --git a/tools/membrane-kv-tiering-scheduler/scheduler_core.h b/tools/membrane-kv-tiering-scheduler/scheduler_core.h
new file mode 100644
index 0000000..4ec05b5
--- /dev/null
+++ b/tools/membrane-kv-tiering-scheduler/scheduler_core.h
@@ -0,0 +1,167 @@
+#ifndef MEMBRANE_KV_TIERING_SCHEDULER_CORE_H
+# define MEMBRANE_KV_TIERING_SCHEDULER_CORE_H
+
+# include <stdint.h>
+
+# ifdef __cplusplus
+extern "C" {
+# endif
+
+/*
+ * Phase 12F: llama-free (no ggml/llama header) deterministic KV
+ * tiering scheduler CORE -- pure policy/decision logic, no I/O, no
+ * backend calls. A real llama-enabled driver (tiering_probe.cpp)
+ * calls the ALREADY-ESTABLISHED Phase 12B-12E primitives
+ * (llama_kv_cache_relocate_layer, llama_invalidate_graph_cache) to
+ * actually APPLY whatever this module decides. No policy logic lives
+ * inside llama.cpp -- this file is llama.cpp's only "opinion" about
+ * KV placement in this phase.
+ *
+ * Deliberately NOT adaptive: every decision is a pure function of
+ * (config, decode_idx, current per-layer state) -- no attention
+ * scores, no learned hotness, no history beyond the explicit
+ * predeclared config. RESEARCH ONLY, experiment/dynamic-kv-tiering-
+ * scheduler branch only.
+ */
+
+# define MEMBRANE_TIERING_MAX_LAYERS       64
+# define MEMBRANE_TIERING_MAX_GROUPS       8
+# define MEMBRANE_TIERING_MAX_GROUP_LAYERS 16
+
+enum e_membrane_tiering_layer_state
+{
+	MEMBRANE_TIERING_LAYER_CPU_RESIDENT = 0,
+	MEMBRANE_TIERING_LAYER_GPU_RESIDENT,
+	MEMBRANE_TIERING_LAYER_PROMOTING,
+	MEMBRANE_TIERING_LAYER_DEMOTING,
+	MEMBRANE_TIERING_LAYER_ERROR
+};
+
+enum e_membrane_tiering_sched_state
+{
+	MEMBRANE_TIERING_SCHED_IDLE = 0,
+	MEMBRANE_TIERING_SCHED_PLANNING,
+	MEMBRANE_TIERING_SCHED_APPLYING,
+	MEMBRANE_TIERING_SCHED_SYNCING,
+	MEMBRANE_TIERING_SCHED_FAILED
+};
+
+enum e_membrane_tiering_action
+{
+	MEMBRANE_TIERING_ACTION_NONE = 0,
+	MEMBRANE_TIERING_ACTION_PROMOTE,
+	MEMBRANE_TIERING_ACTION_DEMOTE
+};
+
+enum e_membrane_tiering_reason
+{
+	MEMBRANE_TIERING_REASON_SCHEDULED_PROMOTION = 0,
+	MEMBRANE_TIERING_REASON_SCHEDULED_DEMOTION,
+	MEMBRANE_TIERING_REASON_PROMOTION_SKIPPED_BUDGET,
+	MEMBRANE_TIERING_REASON_ALREADY_RESIDENT,
+	MEMBRANE_TIERING_REASON_FAILURE
+};
+
+struct s_membrane_tiering_group
+{
+	int32_t	decode_trigger; /* before_decode (promotion) or after_decode (demotion) */
+	int32_t	layers[MEMBRANE_TIERING_MAX_GROUP_LAYERS];
+	int32_t	n_layers;
+};
+
+struct s_membrane_tiering_config
+{
+	int32_t							n_total_layers;
+	int32_t							gpu_layers[MEMBRANE_TIERING_MAX_LAYERS];
+	int32_t							n_gpu_layers;
+	struct s_membrane_tiering_group	promotion_groups[MEMBRANE_TIERING_MAX_GROUPS];
+	int32_t							n_promotion_groups;
+	struct s_membrane_tiering_group	demotion_groups[MEMBRANE_TIERING_MAX_GROUPS];
+	int32_t							n_demotion_groups;
+};
+
+struct s_membrane_tiering_action_entry
+{
+	int32_t							layer;
+	enum e_membrane_tiering_action	action;
+	enum e_membrane_tiering_reason	reason;
+};
+
+/*
+ * Validates a config against n_total_layers (must match config's own
+ * n_total_layers). Checks: every layer index in gpu_layers and every
+ * group is in [0, n_total_layers); no duplicate layer within a single
+ * group; no duplicate layer within gpu_layers itself; group/array
+ * sizes within the MAX_* bounds. Returns 1 if valid, 0 (with
+ * *err_out set to a short static string, if err_out != NULL)
+ * otherwise. Never mutates config.
+ */
+int	membrane_tiering_validate_config(
+		const struct s_membrane_tiering_config *config,
+		int32_t n_total_layers, const char **err_out);
+
+/*
+ * Resets *state[0..n_total_layers) to CPU_RESIDENT or GPU_RESIDENT
+ * per config->gpu_layers, and *sched_state to IDLE. Returns 1 on
+ * success, 0 (nothing touched) if config is invalid for
+ * n_total_layers or n_total_layers exceeds MEMBRANE_TIERING_MAX_LAYERS.
+ */
+int	membrane_tiering_init(const struct s_membrane_tiering_config *config,
+		int32_t n_total_layers,
+		enum e_membrane_tiering_layer_state *layer_states,
+		enum e_membrane_tiering_sched_state *sched_state);
+
+/*
+ * Pure planning function: given the config, the CURRENT decode index,
+ * and the CURRENT per-layer state array, fills out_actions[] (sized
+ * >= n_total_layers by the caller) with exactly one entry per layer
+ * that has a non-NONE action at this decode boundary, and returns the
+ * count written (may be 0). Does NOT mutate layer_states -- callers
+ * apply the plan and then call membrane_tiering_commit_action per
+ * layer to advance state. Deterministic: identical (config,
+ * decode_idx, layer_states) always produces an identical, identically
+ * ordered action list (groups are scanned in config array order, then
+ * layers within a group in array order).
+ *
+ * A promotion_groups entry with decode_trigger == decode_idx whose
+ * layer is already GPU_RESIDENT yields reason ALREADY_RESIDENT (action
+ * NONE, still recorded so callers can log it) rather than being
+ * silently skipped. Same for demotion of an already-CPU_RESIDENT layer.
+ */
+int32_t	membrane_tiering_plan(const struct s_membrane_tiering_config *config,
+		int32_t decode_idx,
+		const enum e_membrane_tiering_layer_state *layer_states,
+		struct s_membrane_tiering_action_entry *out_actions);
+
+/*
+ * Section 17 budget guard -- identical formula/semantics to Phase
+ * 12C's membrane_kv_promo_headroom_ok (reused deliberately: this is
+ * the same real accounting lesson, not reinvented). Returns 1 (safe
+ * to attempt promotion) or 0 (refuse). Overflow of the RHS sum is
+ * detected and treated as 0 (refuse), never wraps to a false "safe".
+ */
+int	membrane_tiering_budget_ok(uint64_t free_vram_bytes,
+		uint64_t reserve_bytes, uint64_t runtime_margin_bytes,
+		uint64_t promotion_bytes);
+
+/*
+ * Explicit per-layer state transitions (Section 2/19). Returns 1 if
+ * the transition was legal and applied, 0 if illegal from the current
+ * state (state left UNCHANGED on rejection). Mirrors the
+ * CPU_RESIDENT<->PROMOTING<->GPU_RESIDENT<->DEMOTING<->CPU_RESIDENT
+ * cycle from Phase 12C/12D's own state machines, reused here at the
+ * scheduler layer. The only transitions that land in ERROR are
+ * explicit *_fail calls from PROMOTING/DEMOTING.
+ */
+int	membrane_tiering_begin_promote(enum e_membrane_tiering_layer_state *s);
+int	membrane_tiering_commit_promote(enum e_membrane_tiering_layer_state *s);
+int	membrane_tiering_fail_promote(enum e_membrane_tiering_layer_state *s);
+int	membrane_tiering_begin_demote(enum e_membrane_tiering_layer_state *s);
+int	membrane_tiering_commit_demote(enum e_membrane_tiering_layer_state *s);
+int	membrane_tiering_fail_demote(enum e_membrane_tiering_layer_state *s);
+
+# ifdef __cplusplus
+}
+# endif
+
+#endif
diff --git a/tools/membrane-kv-tiering-scheduler/test_scheduler_core.c b/tools/membrane-kv-tiering-scheduler/test_scheduler_core.c
new file mode 100644
index 0000000..48f1b86
--- /dev/null
+++ b/tools/membrane-kv-tiering-scheduler/test_scheduler_core.c
@@ -0,0 +1,331 @@
+#include "scheduler_core.h"
+#include "test_helpers.h"
+
+static void	make_simple_config(struct s_membrane_tiering_config *c,
+			int32_t n_total_layers)
+{
+	int32_t	i;
+
+	c->n_total_layers = n_total_layers;
+	c->n_gpu_layers = 0;
+	for (i = n_total_layers - 10; i < n_total_layers; i++)
+		c->gpu_layers[c->n_gpu_layers++] = i;
+	c->n_promotion_groups = 1;
+	c->promotion_groups[0].decode_trigger = 5;
+	c->promotion_groups[0].n_layers = 4;
+	c->promotion_groups[0].layers[0] = 16;
+	c->promotion_groups[0].layers[1] = 17;
+	c->promotion_groups[0].layers[2] = 18;
+	c->promotion_groups[0].layers[3] = 19;
+	c->n_demotion_groups = 1;
+	c->demotion_groups[0].decode_trigger = 10;
+	c->demotion_groups[0].n_layers = 4;
+	c->demotion_groups[0].layers[0] = 16;
+	c->demotion_groups[0].layers[1] = 17;
+	c->demotion_groups[0].layers[2] = 18;
+	c->demotion_groups[0].layers[3] = 19;
+}
+
+static void	test_config_validation_accepts_valid(void)
+{
+	struct s_membrane_tiering_config	c;
+	const char							*err = NULL;
+
+	make_simple_config(&c, 30);
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, &err) == 1,
+		"valid config accepted");
+}
+
+static void	test_config_validation_rejects_mismatched_total(void)
+{
+	struct s_membrane_tiering_config	c;
+	const char							*err = NULL;
+
+	make_simple_config(&c, 30);
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 25, &err) == 0,
+		"n_total_layers mismatch rejected");
+	TEST_ASSERT(err != NULL, "error message set on rejection");
+}
+
+static void	test_config_validation_rejects_out_of_range_layer(void)
+{
+	struct s_membrane_tiering_config	c;
+	const char							*err = NULL;
+
+	make_simple_config(&c, 30);
+	c.gpu_layers[0] = 99;
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, &err) == 0,
+		"out-of-range gpu_layers entry rejected");
+}
+
+static void	test_config_validation_rejects_duplicate_in_gpu_layers(void)
+{
+	struct s_membrane_tiering_config	c;
+
+	make_simple_config(&c, 30);
+	c.gpu_layers[1] = c.gpu_layers[0];
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, NULL) == 0,
+		"duplicate layer in gpu_layers rejected");
+}
+
+static void	test_config_validation_rejects_duplicate_in_group(void)
+{
+	struct s_membrane_tiering_config	c;
+
+	make_simple_config(&c, 30);
+	c.promotion_groups[0].layers[1] = c.promotion_groups[0].layers[0];
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, NULL) == 0,
+		"duplicate layer within one promotion group rejected");
+}
+
+static void	test_config_validation_accepts_empty_schedule(void)
+{
+	struct s_membrane_tiering_config	c;
+
+	make_simple_config(&c, 30);
+	c.n_promotion_groups = 0;
+	c.n_demotion_groups = 0;
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, NULL) == 1,
+		"config with no promotion/demotion groups (empty schedule) is valid");
+}
+
+static void	test_config_validation_accepts_full_gpu(void)
+{
+	struct s_membrane_tiering_config	c;
+	int32_t								i;
+
+	make_simple_config(&c, 30);
+	c.n_gpu_layers = 30;
+	for (i = 0; i < 30; i++)
+		c.gpu_layers[i] = i;
+	c.n_promotion_groups = 0;
+	c.n_demotion_groups = 0;
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, NULL) == 1,
+		"all-GPU config is valid");
+}
+
+static void	test_config_validation_accepts_full_cpu(void)
+{
+	struct s_membrane_tiering_config	c;
+
+	make_simple_config(&c, 30);
+	c.n_gpu_layers = 0;
+	c.n_promotion_groups = 0;
+	c.n_demotion_groups = 0;
+	TEST_ASSERT(membrane_tiering_validate_config(&c, 30, NULL) == 1,
+		"all-CPU config (n_gpu_layers == 0) is valid");
+}
+
+static void	test_init_sets_correct_initial_states(void)
+{
+	struct s_membrane_tiering_config		c;
+	enum e_membrane_tiering_layer_state	states[30];
+	enum e_membrane_tiering_sched_state	sched;
+
+	make_simple_config(&c, 30);
+	TEST_ASSERT(membrane_tiering_init(&c, 30, states, &sched) == 1,
+		"init succeeds on valid config");
+	TEST_ASSERT(sched == MEMBRANE_TIERING_SCHED_IDLE, "scheduler starts IDLE");
+	TEST_ASSERT(states[0] == MEMBRANE_TIERING_LAYER_CPU_RESIDENT,
+		"layer 0 starts CPU_RESIDENT");
+	TEST_ASSERT(states[20] == MEMBRANE_TIERING_LAYER_GPU_RESIDENT,
+		"layer 20 (in gpu_layers) starts GPU_RESIDENT");
+	TEST_ASSERT(states[29] == MEMBRANE_TIERING_LAYER_GPU_RESIDENT,
+		"layer 29 (in gpu_layers) starts GPU_RESIDENT");
+}
+
+static void	test_plan_is_empty_off_trigger_decodes(void)
+{
+	struct s_membrane_tiering_config		c;
+	enum e_membrane_tiering_layer_state	states[30];
+	enum e_membrane_tiering_sched_state	sched;
+	struct s_membrane_tiering_action_entry	actions[30];
+
+	make_simple_config(&c, 30);
+	membrane_tiering_init(&c, 30, states, &sched);
+	TEST_ASSERT(membrane_tiering_plan(&c, 0, states, actions) == 0,
+		"no actions planned at decode 0 (not a trigger)");
+	TEST_ASSERT(membrane_tiering_plan(&c, 4, states, actions) == 0,
+		"no actions planned at decode 4 (not a trigger)");
+}
+
+static void	test_plan_promotion_at_trigger_deterministic_order(void)
+{
+	struct s_membrane_tiering_config		c;
+	enum e_membrane_tiering_layer_state	states[30];
+	enum e_membrane_tiering_sched_state	sched;
+	struct s_membrane_tiering_action_entry	actions[30];
+	int32_t									n;
+
+	make_simple_config(&c, 30);
+	membrane_tiering_init(&c, 30, states, &sched);
+	n = membrane_tiering_plan(&c, 5, states, actions);
+	TEST_ASSERT(n == 4, "4 promotion actions planned at decode 5");
+	TEST_ASSERT(actions[0].layer == 16 && actions[1].layer == 17
+		&& actions[2].layer == 18 && actions[3].layer == 19,
+		"promotion actions are in config array order (deterministic)");
+	TEST_ASSERT(actions[0].action == MEMBRANE_TIERING_ACTION_PROMOTE,
+		"action is PROMOTE");
+	TEST_ASSERT(actions[0].reason == MEMBRANE_TIERING_REASON_SCHEDULED_PROMOTION,
+		"reason is SCHEDULED_PROMOTION");
+}
+
+static void	test_plan_already_resident_promotion_is_noted_not_skipped_silently(void)
+{
+	struct s_membrane_tiering_config		c;
+	enum e_membrane_tiering_layer_state	states[30];
+	enum e_membrane_tiering_sched_state	sched;
+	struct s_membrane_tiering_action_entry	actions[30];
+	int32_t									n;
+
+	make_simple_config(&c, 30);
+	membrane_tiering_init(&c, 30, states, &sched);
+	states[16] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+	n = membrane_tiering_plan(&c, 5, states, actions);
+	TEST_ASSERT(n == 4, "still 4 entries -- already-resident layers are recorded, not omitted");
+	TEST_ASSERT(actions[0].layer == 16 && actions[0].action == MEMBRANE_TIERING_ACTION_NONE
+		&& actions[0].reason == MEMBRANE_TIERING_REASON_ALREADY_RESIDENT,
+		"layer 16 (already GPU) gets action NONE / reason ALREADY_RESIDENT");
+	TEST_ASSERT(actions[1].action == MEMBRANE_TIERING_ACTION_PROMOTE,
+		"layer 17 (still CPU) still gets a real PROMOTE action");
+}
+
+static void	test_plan_demotion_at_trigger(void)
+{
+	struct s_membrane_tiering_config		c;
+	enum e_membrane_tiering_layer_state	states[30];
+	enum e_membrane_tiering_sched_state	sched;
+	struct s_membrane_tiering_action_entry	actions[30];
+	int32_t									n;
+
+	make_simple_config(&c, 30);
+	membrane_tiering_init(&c, 30, states, &sched);
+	states[16] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+	states[17] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+	states[18] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+	states[19] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+	n = membrane_tiering_plan(&c, 10, states, actions);
+	TEST_ASSERT(n == 4, "4 demotion actions planned at decode 10");
+	TEST_ASSERT(actions[0].action == MEMBRANE_TIERING_ACTION_DEMOTE
+		&& actions[0].reason == MEMBRANE_TIERING_REASON_SCHEDULED_DEMOTION,
+		"demote action + reason correct");
+}
+
+static void	test_plan_determinism_repeated_calls(void)
+{
+	struct s_membrane_tiering_config		c;
+	enum e_membrane_tiering_layer_state	states[30];
+	enum e_membrane_tiering_sched_state	sched;
+	struct s_membrane_tiering_action_entry	a1[30];
+	struct s_membrane_tiering_action_entry	a2[30];
+	int32_t									n1;
+	int32_t									n2;
+	int32_t									i;
+
+	make_simple_config(&c, 30);
+	membrane_tiering_init(&c, 30, states, &sched);
+	n1 = membrane_tiering_plan(&c, 5, states, a1);
+	n2 = membrane_tiering_plan(&c, 5, states, a2);
+	TEST_ASSERT(n1 == n2, "same decode_idx + state -> same action count");
+	i = 0;
+	while (i < n1)
+	{
+		TEST_ASSERT(a1[i].layer == a2[i].layer
+			&& a1[i].action == a2[i].action
+			&& a1[i].reason == a2[i].reason,
+			"identical action entries in identical order across repeated calls");
+		i++;
+	}
+}
+
+static void	test_budget_ok_boundary(void)
+{
+	TEST_ASSERT(membrane_tiering_budget_ok(1000, 100, 100, 800) == 1,
+		"free == exact required sum -> safe (boundary inclusive)");
+	TEST_ASSERT(membrane_tiering_budget_ok(999, 100, 100, 800) == 0,
+		"one byte short -> refuse");
+}
+
+static void	test_budget_overflow_fails_closed(void)
+{
+	uint64_t	huge = (uint64_t)-1;
+
+	TEST_ASSERT(membrane_tiering_budget_ok(huge, huge, huge, huge) == 0,
+		"RHS overflow refused, never wraps to a false safe");
+}
+
+static void	test_layer_state_full_promote_cycle(void)
+{
+	enum e_membrane_tiering_layer_state	s = MEMBRANE_TIERING_LAYER_CPU_RESIDENT;
+
+	TEST_ASSERT(membrane_tiering_begin_promote(&s) == 1, "begin_promote legal from CPU_RESIDENT");
+	TEST_ASSERT(s == MEMBRANE_TIERING_LAYER_PROMOTING, "now PROMOTING");
+	TEST_ASSERT(membrane_tiering_commit_promote(&s) == 1, "commit_promote legal from PROMOTING");
+	TEST_ASSERT(s == MEMBRANE_TIERING_LAYER_GPU_RESIDENT, "now GPU_RESIDENT");
+}
+
+static void	test_layer_state_full_demote_cycle(void)
+{
+	enum e_membrane_tiering_layer_state	s = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+
+	TEST_ASSERT(membrane_tiering_begin_demote(&s) == 1, "begin_demote legal from GPU_RESIDENT");
+	TEST_ASSERT(membrane_tiering_commit_demote(&s) == 1, "commit_demote legal from DEMOTING");
+	TEST_ASSERT(s == MEMBRANE_TIERING_LAYER_CPU_RESIDENT, "back to CPU_RESIDENT");
+}
+
+static void	test_layer_state_rollback_on_promote_failure(void)
+{
+	enum e_membrane_tiering_layer_state	s = MEMBRANE_TIERING_LAYER_CPU_RESIDENT;
+
+	membrane_tiering_begin_promote(&s);
+	TEST_ASSERT(membrane_tiering_fail_promote(&s) == 1, "fail_promote legal from PROMOTING");
+	TEST_ASSERT(s == MEMBRANE_TIERING_LAYER_ERROR, "lands in ERROR, not silently CPU_RESIDENT again");
+}
+
+static void	test_layer_state_duplicate_actions_rejected(void)
+{
+	enum e_membrane_tiering_layer_state	s = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+
+	TEST_ASSERT(membrane_tiering_begin_promote(&s) == 0,
+		"promoting an already-GPU_RESIDENT layer is illegal");
+	TEST_ASSERT(s == MEMBRANE_TIERING_LAYER_GPU_RESIDENT,
+		"rejected transition leaves state unchanged");
+}
+
+static void	test_layer_state_error_is_terminal(void)
+{
+	enum e_membrane_tiering_layer_state	s = MEMBRANE_TIERING_LAYER_CPU_RESIDENT;
+
+	membrane_tiering_begin_promote(&s);
+	membrane_tiering_fail_promote(&s);
+	TEST_ASSERT(membrane_tiering_begin_promote(&s) == 0, "no transition accepted from ERROR");
+	TEST_ASSERT(membrane_tiering_begin_demote(&s) == 0, "no transition accepted from ERROR");
+	TEST_ASSERT(s == MEMBRANE_TIERING_LAYER_ERROR, "stays ERROR");
+}
+
+int	main(void)
+{
+	test_config_validation_accepts_valid();
+	test_config_validation_rejects_mismatched_total();
+	test_config_validation_rejects_out_of_range_layer();
+	test_config_validation_rejects_duplicate_in_gpu_layers();
+	test_config_validation_rejects_duplicate_in_group();
+	test_config_validation_accepts_empty_schedule();
+	test_config_validation_accepts_full_gpu();
+	test_config_validation_accepts_full_cpu();
+	test_init_sets_correct_initial_states();
+	test_plan_is_empty_off_trigger_decodes();
+	test_plan_promotion_at_trigger_deterministic_order();
+	test_plan_already_resident_promotion_is_noted_not_skipped_silently();
+	test_plan_demotion_at_trigger();
+	test_plan_determinism_repeated_calls();
+	test_budget_ok_boundary();
+	test_budget_overflow_fails_closed();
+	test_layer_state_full_promote_cycle();
+	test_layer_state_full_demote_cycle();
+	test_layer_state_rollback_on_promote_failure();
+	test_layer_state_duplicate_actions_rejected();
+	test_layer_state_error_is_terminal();
+	printf("test_scheduler_core: all tests passed\n");
+	return (0);
+}
