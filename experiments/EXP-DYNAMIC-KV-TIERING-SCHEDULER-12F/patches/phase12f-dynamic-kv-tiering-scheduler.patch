+        "per-transition cost measured directly.",
+}
+(R / "performance.json").write_text(json.dumps(performance, indent=2))
+
+# ---------- promotion_group_sweep.json (Section 14) ----------
+promo = load_jsonl(R / "raw_promo_group_sweep.jsonl")
+(R / "promotion_group_sweep.json").write_text(json.dumps({"schema_version": 1, "runs": promo}, indent=2))
+
+# ---------- frequency_sweep.json (Section 15) ----------
+freq = load_jsonl(R / "raw_freq_sweep.jsonl")
+(R / "frequency_sweep.json").write_text(json.dumps({"schema_version": 1, "runs": freq}, indent=2))
+
+# ---------- transition_latency.json (Section 11) ----------
+promo_durations = [e["duration_us"] for e in trace if e["action"] == "PROMOTE"]
+demote_durations = [e["duration_us"] for e in trace if e["action"] == "DEMOTE"]
+transition_latency = {
+    "schema_version": 1,
+    "first_schedule_promote_us": promo_durations,
+    "first_schedule_demote_us": demote_durations,
+    "promo_group_sweep_ms_by_group_size": {str(p["group_size"]): p["promotion_ms"] for p in promo},
+    "demo_group_sweep_ms_by_group_size": {str(p["group_size"]): p["demotion_ms"] for p in promo},
+    "note": "demotion is consistently more expensive than promotion for the "
+            "same group size (established in Phase 12E as the immediate-"
+            "retirement path doing extra live-reference bookkeeping on free).",
+}
+(R / "transition_latency.json").write_text(json.dumps(transition_latency, indent=2))
+
+# ---------- budget_guard.json (Sections 17/18) ----------
+budget_ok = load_json_lines_mixed(R / "raw_budget_ok.txt")[0]
+budget_ok_trace = load_jsonl(R / "raw_budget_ok_trace.jsonl")
+budget_fail = load_json_lines_mixed(R / "raw_budget_fail.txt")[0]
+budget_fail_trace = load_jsonl(R / "raw_budget_fail_trace.jsonl")
+budget_guard = {
+    "schema_version": 1,
+    "generous_budget": {**budget_ok, "trace": budget_ok_trace},
+    "impossible_budget_fail_closed": {**budget_fail, "trace": budget_fail_trace},
+    "fail_closed_verified": (
+        budget_fail_trace[0]["reason"] == "PROMOTION_SKIPPED_BUDGET"
+        and budget_fail_trace[0]["result"] == "skipped"
+        and budget_fail["layer_still_cpu"] is True
+    ),
+}
+(R / "budget_guard.json").write_text(json.dumps(budget_guard, indent=2))
+
+# ---------- q5.json (Section 20) ----------
+q5_stderr = load_json_lines_mixed(R / "raw_q5_stderr.txt")
+q5_gen = next((l["generated_tokens"] for l in q5_stderr if "generated_tokens" in l), None)
+q5_trace = load_jsonl(R / "raw_q5_trace.jsonl")
+q5_promo = load_jsonl(R / "raw_q5_promo_group.jsonl")
+q5 = {
+    "schema_version": 1,
+    "kv_type": "Q5_1",
+    "schedule_transitions": q5_trace,
+    "generated_tokens": q5_gen,
+    "matches_q8_reference": q5_gen == reference,
+    "promotion_group_latency": q5_promo,
+}
+(R / "q5.json").write_text(json.dumps(q5, indent=2))
+
+# ---------- second_model.json (Section 21) ----------
+m360_stderr = load_json_lines_mixed(R / "raw_360m_stderr.txt")
+m360_gen = next((l["generated_tokens"] for l in m360_stderr if "generated_tokens" in l), None)
+m360_trace = load_jsonl(R / "raw_360m_trace.jsonl")
+second_model = {
+    "schema_version": 1,
+    "model": "SmolLM2-360M-Instruct-f16.gguf",
+    "n_layer": 32,
+    "schedule_transitions": m360_trace,
+    "generated_tokens": m360_gen,
+    "all_transitions_ok": all(e["result"] == "ok" for e in m360_trace),
+    "n_transitions": len(m360_trace),
+}
+(R / "second_model.json").write_text(json.dumps(second_model, indent=2))
+
+# ---------- long_context.json (Section 22) ----------
+lc_stderr = load_json_lines_mixed(R / "raw_longctx_stderr.txt")
+lc_gen = next((l["generated_tokens"] for l in lc_stderr if "generated_tokens" in l), None)
+lc_trace = load_jsonl(R / "raw_longctx_trace.jsonl")
+long_context = {
+    "schema_version": 1,
+    "n_ctx": 16384,
+    "schedule_transitions": lc_trace,
+    "generated_tokens": lc_gen,
+    "matches_ctx2048_reference": lc_gen == reference,
+    "all_transitions_ok": all(e["result"] == "ok" for e in lc_trace),
+}
+(R / "long_context.json").write_text(json.dumps(long_context, indent=2))
+
+# ---------- pressure_test.json (Section 16) ----------
+p20_stderr = load_json_lines_mixed(R / "raw_pressure_split20.txt")
+p20_json = load_json_lines_mixed(R / "raw_pressure_split20.jsonl")
+psched_stderr = load_json_lines_mixed(R / "raw_pressure_schedule_stderr.txt")
+psched_trace = load_jsonl(R / "raw_pressure_schedule_trace.jsonl")
+psched_gen = next((l["generated_tokens"] for l in psched_stderr if "generated_tokens" in l), None)
+pressure_test = {
+    "schema_version": 1,
+    "n_ctx": 65536,
+    "deviation_from_spec": "Spec suggested ctx~=200000; scaled to 65536 because "
+        "the host had only ~214 MiB free system RAM and 4.9/9.6 GiB swap "
+        "already in use from unrelated concurrent processes (2nd Claude "
+        "session, Firefox, an unrelated pytest run) at test time -- launching "
+        "the full 200000 test risked OOM-killing unrelated work rather than "
+        "just this experiment. journalctl was checked before and after both "
+        "runs; no OOM kill occurred either way.",
+    "static_split20_result": p20_json[0] if p20_json else None,
+    "dynamic_schedule_result": {
+        "transitions": psched_trace,
+        "generated_tokens": psched_gen,
+        "matches_ctx2048_reference": psched_gen == reference,
+        "all_transitions_ok": all(e["result"] == "ok" for e in psched_trace),
+    },
+    "oom_detected": False,
+}
+(R / "pressure_test.json").write_text(json.dumps(pressure_test, indent=2))
+
+# ---------- stability.json (Section 10) ----------
+stability_raw = load_jsonl(R / "raw_stability_50.jsonl")[0]
+stability = {
+    "schema_version": 1,
+    "n_relocations": stability_raw["n_relocations"],
+    "meets_50_transition_requirement": stability_raw["n_relocations"] >= 50,
+    "vram_used_mib_after": stability_raw["vram_used_mib"],
+    "vram_used_mib_steady_state_reference": 371,
+    "no_leak_detected": stability_raw["vram_used_mib"] <= 371 + 5,
+    "raw": stability_raw,
+}
+(R / "stability.json").write_text(json.dumps(stability, indent=2))
+
+# ---------- policy_comparison.json (Section 24) ----------
+policy_comparison = {
+    "schema_version": 1,
+    "static_all_gpu": {"tok_s": performance["static_all_gpu_tok_s"], "vram_peak_mib": next(h["vram_used_mib"] for h in hotset if h["split"] == 0)},
+    "static_split": {"tok_s": performance["static_split20_tok_s"], "vram_peak_mib": next(h["vram_used_mib"] for h in hotset if h["split"] == 22)},
+    "dynamic_schedule": {
+        "note": "same token output as static references (see correctness.json); "
