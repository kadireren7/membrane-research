+}
+(R / "pareto.json").write_text(json.dumps(pareto, indent=2))
+
+performance = {
+    "schema_version": 1,
+    "static_all_gpu_tok_s": next(h["generation_tok_s"] for h in hotset if h["split"] == 0),
+    "static_all_cpu_tok_s": next(h["generation_tok_s"] for h in hotset if h["split"] == 30),
+    "static_split20_tok_s": next(h["generation_tok_s"] for h in hotset if h["split"] == 22),
+    "dynamic_schedule_note": "dynamic schedule interleaves promote/demote "
