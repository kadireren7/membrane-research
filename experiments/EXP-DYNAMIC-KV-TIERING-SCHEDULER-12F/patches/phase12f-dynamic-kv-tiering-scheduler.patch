+V12F_DIR = REPO_ROOT / "results" / "phase12" / "dynamic-tiering-scheduler"
+_V12F_CACHE = {}
+
+
+def _load_v12f(name):
+	key = name
+	if key not in _V12F_CACHE:
+		path = V12F_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V12F_CACHE[key] = rows
+		elif name.endswith((".txt", ".log")):
+			_V12F_CACHE[key] = path.read_text()
+		else:
+			_V12F_CACHE[key] = json.loads(path.read_text())
+	return _V12F_CACHE[key]
+
+
+@check("Phase 12F: manifest.json exists, valid JSON, schema_version 1, "
+	"lists every actual processed .json artifact under 'artifacts' "
+	"(raw_* evidence files are listed separately under raw_evidence_files)")
+def _c110():
+	if not (V12F_DIR / "manifest.json").exists():
+		return False, f"{V12F_DIR}/manifest.json does not exist"
+	m = _load_v12f("manifest.json")
+	bad = []
+	if m.get("schema_version") != 1:
+		bad.append(f"schema_version={m.get('schema_version')!r}")
+	listed_artifacts = set(m.get("artifacts", {}).keys())
+	actual_processed = {
+		p.name for p in list(V12F_DIR.glob("*.json")) + list(V12F_DIR.glob("*.jsonl"))
+		if not p.name.startswith("raw_") and p.name != "manifest.json"
+	}
+	if listed_artifacts != actual_processed:
+		bad.append(f"artifacts listed-vs-actual mismatch: missing={actual_processed - listed_artifacts}, extra={listed_artifacts - actual_processed}")
+	listed_raw = set(m.get("raw_evidence_files", []))
+	actual_raw = {p.name for p in V12F_DIR.glob("raw_*")}
+	if listed_raw != actual_raw:
+		bad.append(f"raw_evidence_files listed-vs-actual mismatch: missing={actual_raw - listed_raw}, extra={listed_raw - actual_raw}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(listed_artifacts)} artifacts + {len(listed_raw)} raw files, exact match with directory contents"
+
+
+@check("Phase 12F: first_schedule.json's claimed transitions are exactly "
+	"reproduced by recomputing from raw_first_schedule_trace.jsonl -- every "
+	"expected (decode_idx, layer, action) actually occurred with result=ok, "
+	"and no unexpected actions were emitted")
+def _c111():
+	fs = _load_v12f("first_schedule.json")
+	raw = _load_v12f("raw_first_schedule_trace.jsonl")
+	bad = []
+	expected = {(e["decode_idx"], e["layer"], e["action"]) for e in fs.get("expected_transitions", [])}
+	actual = {(e["decode_idx"], e["layer"], e["action"]) for e in raw}
+	if expected != actual:
+		bad.append(f"expected vs raw-trace transition set mismatch: missing={expected - actual}, extra={actual - expected}")
+	non_ok = [e for e in raw if e.get("result") != "ok"]
+	if non_ok:
+		bad.append(f"raw trace has non-ok results: {non_ok[:3]}")
+	if len(raw) != 8:
+		bad.append(f"expected exactly 8 transition entries (4 promote + 4 demote), got {len(raw)}")
+	if fs.get("generated_tokens") is None or len(fs["generated_tokens"]) != 15:
+		bad.append(f"generated_tokens missing or wrong length: {fs.get('generated_tokens')}")
+	return len(bad) == 0, "; ".join(bad) if bad else "8/8 transitions match raw trace exactly, all result=ok, 15 tokens generated"
+
