+/*
+ * Phase 12F: real llama-enabled deterministic KV tiering scheduler
+ * driver. Calls the ALREADY-ESTABLISHED Phase 12B-12E primitives
+ * (kv_dev_override at construction, llama_kv_cache_relocate_layer,
+ * llama_invalidate_graph_cache) to APPLY decisions computed by the
+ * llama-free scheduler_core module -- no policy logic here duplicates
+ * scheduler_core's; this file is plumbing + measurement only.
+ * RESEARCH ONLY, experiment/dynamic-kv-tiering-scheduler branch only.
+ *
+ * Modes (all need a real model, mp.n_gpu_layers=-1, weights always
+ * fully GPU-resident, kv_dev_override sets INITIAL KV split only):
+ *   schedule_demo  MODEL n_ctx kv_type n_decodes
+ *                  (Section 6/26: the first end-to-end schedule, full
+ *                  decision trace + VRAM time series)
+ *   hotset         MODEL n_ctx kv_type gpu_split n_decodes
+ *                  (Section 13: static hot-set sweep, no movement)
+ *   promo_group    MODEL n_ctx kv_type gpu_split group_size n_decodes
+ *                  (Section 14: one promote+demote of a fixed-size
+ *                  group mid-run, latency + VRAM delta)
+ *   budget_test    MODEL n_ctx kv_type reserve_mib margin_mib
+ *                  (Section 17/18: budget guard, forced skip when
+ *                  reserve/margin make the promotion look unsafe)
+ *   determinism    MODEL n_ctx kv_type n_decodes
+ *                  (Section 28: run schedule_demo's plan twice against
+ *                  a real model's real layer states, compare)
+ */
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "ggml-backend.h"
+#include "llama.h"
+#include "scheduler_core.h"
+
+/* ---------- shared plumbing (mirrors relocate_probe.cpp) ---------- */
+
+struct capture_ctx_t
+{
+	int32_t						n_layer;
+	std::vector<ggml_tensor *>	k_leaf;
+	std::vector<ggml_tensor *>	v_leaf;
+};
+
+static bool	layer_from_name(const char *name, const char *prefix, int32_t *out)
+{
+	size_t	plen = strlen(prefix);
+	char	*end;
+	long	v;
+
+	if (strncmp(name, prefix, plen) != 0)
+		return (false);
+	v = strtol(name + plen, &end, 10);
+	if (end == name + plen || v < 0)
+		return (false);
+	*out = (int32_t)v;
+	return (true);
+}
+
+static bool	capture_cb(struct ggml_tensor *t, bool ask, void *ud)
+{
+	capture_ctx_t	*c = static_cast<capture_ctx_t *>(ud);
+	int32_t			layer;
+
+	if (ask)
+		return (true);
+	if (layer_from_name(t->name, "cache_k_l", &layer) && layer < c->n_layer)
+		c->k_leaf[layer] = t->view_src != nullptr ? t->view_src : t;
+	else if (layer_from_name(t->name, "cache_v_l", &layer) && layer < c->n_layer)
+		c->v_leaf[layer] = t->view_src != nullptr ? t->view_src : t;
+	return (true);
+}
+
+struct split_ctx_t
+{
+	int32_t	split; /* [0, split) -> CPU KV, [split, n_layer) -> GPU KV */
+};
+
+static ggml_backend_dev_t	split_kv_dev_override(int32_t il,
+				ggml_backend_dev_t default_dev, void *ud)
+{
+	split_ctx_t	*s = static_cast<split_ctx_t *>(ud);
+
+	if (il < s->split)
+		return (ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+	return (default_dev);
+}
+
+static uint64_t	read_rss_kb(void)
+{
+	std::ifstream	f("/proc/self/status");
+	std::string		line;
+
+	while (std::getline(f, line))
+		if (line.compare(0, 6, "VmRSS:") == 0)
+			return ((uint64_t)strtoull(line.c_str() + 6, nullptr, 10));
+	return (0);
+}
+
+static long	nvidia_smi_used_mib(void)
+{
+	FILE	*p = popen(
+		"nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null",
+		"r");
+	char	buf[64];
+	long	v = -1;
+
+	if (p == nullptr)
+		return (-1);
+	if (fgets(buf, sizeof(buf), p) != nullptr)
+		v = strtol(buf, nullptr, 10);
+	pclose(p);
+	return (v);
+}
+
+static long	nvidia_smi_total_mib(void)
+{
+	FILE	*p = popen(
+		"nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null",
+		"r");
+	char	buf[64];
+	long	v = -1;
+
+	if (p == nullptr)
+		return (-1);
+	if (fgets(buf, sizeof(buf), p) != nullptr)
+		v = strtol(buf, nullptr, 10);
+	pclose(p);
+	return (v);
+}
+
+static double	now_ms(void)
+{
+	auto	t = std::chrono::steady_clock::now();
+
+	return (std::chrono::duration<double, std::milli>(
+		t.time_since_epoch()).count());
+}
+
+static const char	*kv_type_name(const char *s)
+{
+	if (strcmp(s, "q8") == 0)
+		return ("Q8_0");
+	if (strcmp(s, "q5") == 0)
+		return ("Q5_1");
+	return ("F16");
+}
+
+struct loaded_t
+{
+	llama_model			*model;
+	llama_context		*ctx;
+	llama_memory_t		mem;
+	capture_ctx_t		cap;
+	int32_t				n_layer;
+	const llama_vocab	*vocab;
+};
+
+static bool	load_ctx(const char *model_path, int32_t n_ctx,
+			const char *kv_type_str, int32_t split, loaded_t *out)
+{
+	llama_model_params	mp = llama_model_default_params();
+
+	mp.n_gpu_layers = -1;
+	out->model = llama_model_load_from_file(model_path, mp);
+	if (out->model == nullptr)
+		return (false);
+	out->n_layer = llama_model_n_layer(out->model);
+	out->vocab = llama_model_get_vocab(out->model);
+	out->cap.n_layer = out->n_layer;
+	out->cap.k_leaf.assign(out->n_layer, nullptr);
+	out->cap.v_leaf.assign(out->n_layer, nullptr);
+
+	static split_ctx_t	split_ctx;
+	split_ctx.split = split;
+
+	ggml_type	kvt = strcmp(kv_type_str, "q8") == 0 ? GGML_TYPE_Q8_0
+		: strcmp(kv_type_str, "q5") == 0 ? GGML_TYPE_Q5_1 : GGML_TYPE_F16;
+
+	llama_context_params	cp = llama_context_default_params();
+	cp.n_ctx = n_ctx;
+	cp.type_k = kvt;
+	cp.type_v = kvt;
+	cp.cb_eval = capture_cb;
+	cp.cb_eval_user_data = &out->cap;
+	if (split >= 0)
+	{
+		cp.kv_dev_override = split_kv_dev_override;
+		cp.kv_dev_override_ud = &split_ctx;
+	}
+	out->ctx = llama_init_from_model(out->model, cp);
+	if (out->ctx == nullptr)
+		return (false);
+	out->mem = llama_get_memory(out->ctx);
+	return (true);
+}
+
+static void	free_loaded(loaded_t *l)
+{
+	if (l->ctx)
+		llama_free(l->ctx);
+	if (l->model)
+		llama_model_free(l->model);
+	l->ctx = nullptr;
+	l->model = nullptr;
+}
+
+static bool	decode_prompt(loaded_t *l, const char *prompt)
+{
+	std::vector<llama_token>	tokens(256);
+	int	n = llama_tokenize(l->vocab, prompt, (int32_t)strlen(prompt),
+			tokens.data(), (int32_t)tokens.size(), true, false);
+
+	if (n < 0)
+		return (false);
+	tokens.resize(n);
+	llama_batch	batch = llama_batch_get_one(tokens.data(), (int32_t)tokens.size());
+	return (llama_decode(l->ctx, batch) == 0);
+}
+
+static bool	decode_one_greedy(loaded_t *l, llama_token *out_tok)
+{
+	int32_t	n_vocab = llama_vocab_n_tokens(l->vocab);
+	const float	*logits = llama_get_logits_ith(l->ctx, -1);
+	int	best = 0;
+
+	for (int j = 1; j < n_vocab; j++)
+		if (logits[j] > logits[best])
+			best = j;
+	*out_tok = (llama_token)best;
+	llama_batch	b1 = llama_batch_get_one(out_tok, 1);
+	return (llama_decode(l->ctx, b1) == 0);
+}
+
+static bool	layer_is_cpu_now(loaded_t *l, int32_t layer)
+{
+	ggml_tensor	*k = l->cap.k_leaf[layer];
+
+	return (k && strstr(ggml_backend_buffer_name(k->buffer), "CPU") != nullptr);
+}
+
+static uint64_t	layer_kv_bytes(loaded_t *l, int32_t layer)
+{
+	ggml_tensor	*k = l->cap.k_leaf[layer];
+	ggml_tensor	*v = l->cap.v_leaf[layer];
+	uint64_t	kb = k ? ggml_nbytes(k) : 0;
+	uint64_t	vb = v ? ggml_nbytes(v) : 0;
+
+	return (kb + vb);
+}
+
+static const char	*reason_name(enum e_membrane_tiering_reason r)
+{
+	switch (r)
+	{
+	case MEMBRANE_TIERING_REASON_SCHEDULED_PROMOTION:
+		return ("SCHEDULED_PROMOTION");
+	case MEMBRANE_TIERING_REASON_SCHEDULED_DEMOTION:
+		return ("SCHEDULED_DEMOTION");
+	case MEMBRANE_TIERING_REASON_PROMOTION_SKIPPED_BUDGET:
+		return ("PROMOTION_SKIPPED_BUDGET");
+	case MEMBRANE_TIERING_REASON_ALREADY_RESIDENT:
+		return ("ALREADY_RESIDENT");
+	case MEMBRANE_TIERING_REASON_FAILURE:
+	default:
+		return ("FAILURE");
+	}
+}
+
+/* Applies one planned action for one layer against the real context,
+ * using ONLY the established Phase 12B-12E primitives:
+ * relocate_layer() (retain=false, defer=false -- the validated
+ * IMMEDIATE-retirement path from Phase 12E) followed by
+ * llama_invalidate_graph_cache(). Emits one decision-trace line. */
+static bool	apply_action(loaded_t *l, int32_t decode_idx,
+			const struct s_membrane_tiering_action_entry *a,
+			uint64_t reserve_mib, uint64_t margin_mib, FILE *trace_fp)
+{
+	if (a->action == MEMBRANE_TIERING_ACTION_NONE)
+	{
+		fprintf(trace_fp, "{\"decode_idx\":%d,\"layer\":%d,\"action\":\"NONE\","
+			"\"reason\":\"%s\",\"bytes\":0,\"before_device\":\"%s\","
+			"\"after_device\":\"%s\",\"duration_us\":0,\"result\":\"ok\"}\n",
+			decode_idx, a->layer, reason_name(a->reason),
+			layer_is_cpu_now(l, a->layer) ? "CPU" : "GPU",
+			layer_is_cpu_now(l, a->layer) ? "CPU" : "GPU");
+		return (true);
+	}
+
+	const char	*before_device = layer_is_cpu_now(l, a->layer) ? "CPU" : "GPU";
+	uint64_t	bytes = layer_kv_bytes(l, a->layer);
+
+	if (a->action == MEMBRANE_TIERING_ACTION_PROMOTE)
+	{
+		long	total = nvidia_smi_total_mib();
+		long	used = nvidia_smi_used_mib();
+		uint64_t	free_bytes = (total > 0 && used >= 0 && total > used)
+			? (uint64_t)(total - used) * 1024ULL * 1024ULL : 0;
+
+		if (!membrane_tiering_budget_ok(free_bytes, reserve_mib * 1024ULL * 1024ULL,
+				margin_mib * 1024ULL * 1024ULL, bytes))
+		{
+			fprintf(trace_fp, "{\"decode_idx\":%d,\"layer\":%d,\"action\":\"PROMOTE\","
+				"\"reason\":\"PROMOTION_SKIPPED_BUDGET\",\"bytes\":%llu,"
+				"\"before_device\":\"%s\",\"after_device\":\"%s\","
+				"\"duration_us\":0,\"result\":\"skipped\"}\n",
+				decode_idx, a->layer, (unsigned long long)bytes,
+				before_device, before_device);
+			return (true);
+		}
+	}
+
+	ggml_backend_dev_t	dst = (a->action == MEMBRANE_TIERING_ACTION_PROMOTE)
+		? ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)
+		: ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+	if (!dst)
+	{
+		fprintf(trace_fp, "{\"decode_idx\":%d,\"layer\":%d,\"action\":\"%s\","
+			"\"reason\":\"FAILURE\",\"bytes\":%llu,\"before_device\":\"%s\","
+			"\"after_device\":\"%s\",\"duration_us\":0,\"result\":\"backend_unavailable\"}\n",
+			decode_idx, a->layer,
+			a->action == MEMBRANE_TIERING_ACTION_PROMOTE ? "PROMOTE" : "DEMOTE",
+			(unsigned long long)bytes, before_device, before_device);
+		return (false);
+	}
+
+	double	t0 = now_ms();
+	llama_synchronize(l->ctx);
+	bool	ok = llama_kv_cache_relocate_layer(l->mem, a->layer, dst);
+	if (ok)
+		llama_invalidate_graph_cache(l->ctx);
+	double	t1 = now_ms();
+
+	const char	*after_device = ok
+		? (a->action == MEMBRANE_TIERING_ACTION_PROMOTE ? "GPU" : "CPU")
+		: before_device;
+
+	fprintf(trace_fp, "{\"decode_idx\":%d,\"layer\":%d,\"action\":\"%s\","
+		"\"reason\":\"%s\",\"bytes\":%llu,\"before_device\":\"%s\","
+		"\"after_device\":\"%s\",\"duration_us\":%.1f,\"result\":\"%s\"}\n",
+		decode_idx, a->layer,
+		a->action == MEMBRANE_TIERING_ACTION_PROMOTE ? "PROMOTE" : "DEMOTE",
+		reason_name(a->reason), (unsigned long long)bytes,
+		before_device, after_device, (t1 - t0) * 1000.0,
+		ok ? "ok" : "failure");
+	return (ok);
+}
+
+/* ---------- mode: schedule_demo ---------- */
+
+static int	cmd_schedule_demo(const char *model, int32_t n_ctx, const char *kvt,
+				int n_decodes)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, 20, &l)) /* [0,20) CPU, [20,n) GPU */
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+	if (!ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU))
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	struct s_membrane_tiering_config	config = {};
+	config.n_total_layers = l.n_layer;
+	config.n_gpu_layers = 0;
+	for (int32_t i = 20; i < l.n_layer && i < 30; i++)
+		config.gpu_layers[config.n_gpu_layers++] = i;
+	config.n_promotion_groups = 1;
+	config.promotion_groups[0].decode_trigger = 5;
+	config.promotion_groups[0].n_layers = 4;
+	config.promotion_groups[0].layers[0] = 16;
+	config.promotion_groups[0].layers[1] = 17;
+	config.promotion_groups[0].layers[2] = 18;
+	config.promotion_groups[0].layers[3] = 19;
+	config.n_demotion_groups = 1;
+	config.demotion_groups[0].decode_trigger = 10;
+	config.demotion_groups[0].n_layers = 4;
+	config.demotion_groups[0].layers[0] = 16;
+	config.demotion_groups[0].layers[1] = 17;
+	config.demotion_groups[0].layers[2] = 18;
+	config.demotion_groups[0].layers[3] = 19;
+
+	const char	*err = nullptr;
+	if (!membrane_tiering_validate_config(&config, l.n_layer, &err))
+	{
+		fprintf(stderr, "{\"error\":\"invalid_config\",\"detail\":\"%s\"}\n",
+			err ? err : "unknown");
+		free_loaded(&l);
+		return (21);
+	}
+
+	std::vector<enum e_membrane_tiering_layer_state>	states(l.n_layer);
+	enum e_membrane_tiering_sched_state				sched;
+	membrane_tiering_init(&config, l.n_layer, states.data(), &sched);
+
+	FILE	*trace_fp = stdout;
+	std::vector<llama_token>	gen;
+	fprintf(stderr, "{\"schema_version\":1,\"mode\":\"schedule_demo\",\"n_layer\":%d}\n",
+		l.n_layer);
+	for (int decode_idx = 0; decode_idx < n_decodes; decode_idx++)
+	{
+		std::vector<struct s_membrane_tiering_action_entry>	actions(l.n_layer);
+		int32_t	n = membrane_tiering_plan(&config, decode_idx, states.data(),
+				actions.data());
+		for (int32_t i = 0; i < n; i++)
+		{
+			bool	ok = apply_action(&l, decode_idx, &actions[i], 64, 32, trace_fp);
+			if (actions[i].action == MEMBRANE_TIERING_ACTION_PROMOTE)
+			{
+				if (ok)
+				{
+					membrane_tiering_begin_promote(&states[actions[i].layer]);
+					membrane_tiering_commit_promote(&states[actions[i].layer]);
+				}
+			}
+			else if (actions[i].action == MEMBRANE_TIERING_ACTION_DEMOTE)
+			{
+				if (ok)
+				{
+					membrane_tiering_begin_demote(&states[actions[i].layer]);
+					membrane_tiering_commit_demote(&states[actions[i].layer]);
+				}
+			}
+		}
+		llama_token	tok;
+		bool	decode_ok = decode_one_greedy(&l, &tok);
+		if (!decode_ok)
+		{
+			fprintf(stderr, "{\"error\":\"decode_failed\",\"decode_idx\":%d}\n", decode_idx);
+			free_loaded(&l);
+			return (13);
+		}
+		gen.push_back(tok);
+		fprintf(stderr, "{\"vram_step\":%d,\"decode_idx\":%d,\"vram_used_mib\":%ld,"
+			"\"rss_kb\":%llu}\n",
+			decode_idx, decode_idx, nvidia_smi_used_mib(),
+			(unsigned long long)read_rss_kb());
+	}
+
+	fprintf(stderr, "{\"generated_tokens\":[");
+	for (size_t i = 0; i < gen.size(); i++)
+		fprintf(stderr, "%s%d", i == 0 ? "" : ",", gen[i]);
+	fprintf(stderr, "]}\n");
+
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: hotset (Section 13: static split, no movement) ---------- */
+
+static int	cmd_hotset(const char *model, int32_t n_ctx, const char *kvt,
+				int32_t split, int n_decodes)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	double	t0 = now_ms();
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+	double	t1 = now_ms();
+
+	uint64_t	gpu_kv_bytes = 0, cpu_kv_bytes = 0;
+	for (int32_t i = 0; i < l.n_layer; i++)
+	{
+		uint64_t	b = layer_kv_bytes(&l, i);
+		if (layer_is_cpu_now(&l, i))
+			cpu_kv_bytes += b;
+		else
+			gpu_kv_bytes += b;
+	}
+
+	std::vector<llama_token>	gen;
+	double	t2 = now_ms();
+	for (int i = 0; i < n_decodes; i++)
+	{
+		llama_token	tok;
+		if (!decode_one_greedy(&l, &tok))
+		{
+			fprintf(stderr, "{\"error\":\"decode_failed\"}\n");
+			free_loaded(&l);
+			return (13);
+		}
+		gen.push_back(tok);
+	}
+	double	t3 = now_ms();
+
+	printf("{\"schema_version\":1,\"mode\":\"hotset\",\"split\":%d,"
+		"\"n_gpu_kv_layers\":%d,\"n_cpu_kv_layers\":%d,"
+		"\"gpu_kv_bytes\":%llu,\"cpu_kv_bytes\":%llu,"
+		"\"prompt_ms\":%.3f,\"n_decodes\":%d,\"decode_total_ms\":%.3f,"
+		"\"generation_tok_s\":%.4f,\"vram_used_mib\":%ld,\"rss_kb\":%llu,"
+		"\"generated_tokens\":[",
+		split, l.n_layer - split, split,
+		(unsigned long long)gpu_kv_bytes, (unsigned long long)cpu_kv_bytes,
+		t1 - t0, n_decodes, t3 - t2,
+		(double)n_decodes / ((t3 - t2) / 1000.0),
+		nvidia_smi_used_mib(), (unsigned long long)read_rss_kb());
+	for (size_t i = 0; i < gen.size(); i++)
+		printf("%s%d", i == 0 ? "" : ",", gen[i]);
+	printf("]}\n");
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: promo_group (Section 14) ---------- */
+
+static int	cmd_promo_group(const char *model, int32_t n_ctx, const char *kvt,
+				int32_t split, int group_size, int n_decodes)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+	if (!ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU))
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	std::vector<int32_t>	layers;
+	for (int i = 0; i < group_size && i < split; i++)
+		layers.push_back(i);
+
+	for (int i = 0; i < n_decodes / 2; i++)
+	{
+		llama_token	tok;
+		decode_one_greedy(&l, &tok);
+	}
+
+	long	vram_before = nvidia_smi_used_mib();
+	double	t0 = now_ms();
+	for (int32_t layer : layers)
+	{
+		llama_synchronize(l.ctx);
+		llama_kv_cache_relocate_layer(l.mem, layer,
+			ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU));
+	}
+	llama_invalidate_graph_cache(l.ctx);
+	double	t1 = now_ms();
+	long	vram_after_promote = nvidia_smi_used_mib();
+
+	llama_token	tok;
+	decode_one_greedy(&l, &tok);
+
+	double	t2 = now_ms();
+	for (int32_t layer : layers)
+	{
+		llama_synchronize(l.ctx);
+		llama_kv_cache_relocate_layer(l.mem, layer,
+			ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+	}
+	llama_invalidate_graph_cache(l.ctx);
+	double	t3 = now_ms();
+	long	vram_after_demote = nvidia_smi_used_mib();
+
+	decode_one_greedy(&l, &tok);
+
+	printf("{\"schema_version\":1,\"mode\":\"promo_group\",\"group_size\":%d,"
+		"\"promotion_ms\":%.3f,\"demotion_ms\":%.3f,"
+		"\"vram_before_mib\":%ld,\"vram_after_promote_mib\":%ld,"
+		"\"vram_after_demote_mib\":%ld,\"vram_delta_promote_mib\":%ld,"
+		"\"vram_reclaimed_mib\":%ld}\n",
+		group_size, t1 - t0, t3 - t2, vram_before, vram_after_promote,
+		vram_after_demote, vram_after_promote - vram_before,
+		vram_after_promote - vram_after_demote);
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: budget_test (Section 17/18) ---------- */
+
+static int	cmd_budget_test(const char *model, int32_t n_ctx, const char *kvt,
+				uint64_t reserve_mib, uint64_t margin_mib)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, 20, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+	if (!ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU))
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	struct s_membrane_tiering_action_entry	a;
+	a.layer = 0;
+	a.action = MEMBRANE_TIERING_ACTION_PROMOTE;
+	a.reason = MEMBRANE_TIERING_REASON_SCHEDULED_PROMOTION;
+
+	long	before = nvidia_smi_used_mib();
+	bool	ok = apply_action(&l, 0, &a, reserve_mib, margin_mib, stdout);
+	long	after = nvidia_smi_used_mib();
+	/* cb_eval capture only refreshes on a decode; run one so
+	 * layer_is_cpu_now reflects the post-relocate state rather than a
+	 * stale pointer from before the relocate (see Phase 12D/12E notes
+	 * on capture staleness). */
+	llama_token	refresh_tok;
+	decode_one_greedy(&l, &refresh_tok);
+	bool	layer_still_cpu = layer_is_cpu_now(&l, 0);
+
+	fprintf(stderr, "{\"schema_version\":1,\"mode\":\"budget_test\","
+		"\"reserve_mib\":%llu,\"margin_mib\":%llu,\"apply_ok\":%s,"
+		"\"vram_before_mib\":%ld,\"vram_after_mib\":%ld,"
+		"\"layer_still_cpu\":%s}\n",
+		(unsigned long long)reserve_mib, (unsigned long long)margin_mib,
+		ok ? "true" : "false", before, after,
+		layer_still_cpu ? "true" : "false");
+	free_loaded(&l);
+	return (0);
+}
+
+/* ---------- mode: determinism (Section 28) ---------- */
+
+static int	cmd_determinism(const char *model, int32_t n_ctx, const char *kvt,
+				int n_decodes)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, 20, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+
+	struct s_membrane_tiering_config	config = {};
+	config.n_total_layers = l.n_layer;
+	config.n_gpu_layers = 0;
+	for (int32_t i = 20; i < l.n_layer && i < 30; i++)
+		config.gpu_layers[config.n_gpu_layers++] = i;
+	config.n_promotion_groups = 1;
+	config.promotion_groups[0].decode_trigger = 5;
+	config.promotion_groups[0].n_layers = 4;
+	config.promotion_groups[0].layers[0] = 16;
+	config.promotion_groups[0].layers[1] = 17;
+	config.promotion_groups[0].layers[2] = 18;
+	config.promotion_groups[0].layers[3] = 19;
+	config.n_demotion_groups = 1;
+	config.demotion_groups[0].decode_trigger = 10;
+	config.demotion_groups[0].n_layers = 4;
+	config.demotion_groups[0].layers[0] = 16;
+	config.demotion_groups[0].layers[1] = 17;
+	config.demotion_groups[0].layers[2] = 18;
+	config.demotion_groups[0].layers[3] = 19;
+
+	std::vector<enum e_membrane_tiering_layer_state>	states(l.n_layer);
+	enum e_membrane_tiering_sched_state				sched;
+	membrane_tiering_init(&config, l.n_layer, states.data(), &sched);
+
+	std::string	trace1, trace2;
+	for (int run = 0; run < 2; run++)
+	{
+		std::vector<enum e_membrane_tiering_layer_state>	s2 = states;
+		std::string	*out = (run == 0) ? &trace1 : &trace2;
+		for (int decode_idx = 0; decode_idx < n_decodes; decode_idx++)
+		{
+			std::vector<struct s_membrane_tiering_action_entry>	actions(l.n_layer);
+			int32_t	n = membrane_tiering_plan(&config, decode_idx, s2.data(), actions.data());
+			for (int32_t i = 0; i < n; i++)
+			{
+				char	buf[128];
+				snprintf(buf, sizeof(buf), "%d:%d:%d:%d;", decode_idx,
+					actions[i].layer, (int)actions[i].action, (int)actions[i].reason);
+				*out += buf;
+				if (actions[i].action == MEMBRANE_TIERING_ACTION_PROMOTE)
+					s2[actions[i].layer] = MEMBRANE_TIERING_LAYER_GPU_RESIDENT;
+				else if (actions[i].action == MEMBRANE_TIERING_ACTION_DEMOTE)
+					s2[actions[i].layer] = MEMBRANE_TIERING_LAYER_CPU_RESIDENT;
+			}
+		}
+	}
+
+	printf("{\"schema_version\":1,\"mode\":\"determinism\",\"n_decodes\":%d,"
+		"\"identical\":%s,\"trace_len\":%zu}\n",
+		n_decodes, trace1 == trace2 ? "true" : "false", trace1.size());
+	free_loaded(&l);
+	return (trace1 == trace2 ? 0 : 1);
+}
+
+/* ---------- mode: freq_sweep (Section 15) ---------- */
+
+static int	cmd_freq_sweep(const char *model, int32_t n_ctx, const char *kvt,
+				int32_t split, int group_size, int interval, int n_cycles)
+{
+	loaded_t	l{};
+
+	if (!load_ctx(model, n_ctx, kvt, split, &l))
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+	decode_prompt(&l, "The quick brown fox jumps over the lazy dog");
+	if (!ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU))
+	{
+		printf("{\"error\":\"backend_unavailable\"}\n");
+		free_loaded(&l);
+		return (20);
+	}
+
+	std::vector<int32_t>	layers;
+	for (int i = 0; i < group_size && i < split; i++)
+		layers.push_back(i);
+
+	double	total_reloc_ms = 0.0;
+	int		n_relocations = 0;
+	double	t_start = now_ms();
+	for (int cycle = 0; cycle < n_cycles; cycle++)
+	{
+		for (int d = 0; d < interval; d++)
+		{
+			llama_token	tok;
+			decode_one_greedy(&l, &tok);
+		}
+		double	t0 = now_ms();
+		for (int32_t layer : layers)
+		{
+			llama_synchronize(l.ctx);
+			llama_kv_cache_relocate_layer(l.mem, layer,
+				ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU));
+		}
+		for (int32_t layer : layers)
+		{
+			llama_synchronize(l.ctx);
+			llama_kv_cache_relocate_layer(l.mem, layer,
+				ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+		}
+		llama_invalidate_graph_cache(l.ctx);
+		double	t1 = now_ms();
+		total_reloc_ms += (t1 - t0);
+		n_relocations += (int)layers.size() * 2;
+	}
+	double	t_end = now_ms();
+
+	printf("{\"schema_version\":1,\"mode\":\"freq_sweep\",\"interval_decodes\":%d,"
+		"\"group_size\":%d,\"n_cycles\":%d,\"n_relocations\":%d,"
+		"\"total_wall_ms\":%.3f,\"total_relocation_ms\":%.3f,"
+		"\"relocation_overhead_pct\":%.4f,\"vram_used_mib\":%ld}\n",
+		interval, group_size, n_cycles, n_relocations,
+		t_end - t_start, total_reloc_ms,
+		100.0 * total_reloc_ms / (t_end - t_start), nvidia_smi_used_mib());
+	free_loaded(&l);
+	return (0);
+}
+
+int	main(int argc, char **argv)
+{
+	llama_backend_init();
+	if (argc < 2)
+	{
+		fprintf(stderr, "usage: %s <mode> ...\n", argv[0]);
+		llama_backend_free();
+		return (2);
+	}
+	std::string	mode = argv[1];
+	int	rc = 2;
+
+	if (mode == "schedule_demo" && argc >= 6)
+		rc = cmd_schedule_demo(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]));
+	else if (mode == "hotset" && argc >= 7)
+		rc = cmd_hotset(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]), atoi(argv[6]));
+	else if (mode == "promo_group" && argc >= 8)
+		rc = cmd_promo_group(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]), atoi(argv[7]));
+	else if (mode == "budget_test" && argc >= 7)
+		rc = cmd_budget_test(argv[2], atoi(argv[3]), argv[4],
+			(uint64_t)strtoull(argv[5], nullptr, 10),
+			(uint64_t)strtoull(argv[6], nullptr, 10));
+	else if (mode == "determinism" && argc >= 6)
+		rc = cmd_determinism(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]));
+	else if (mode == "freq_sweep" && argc >= 9)
+		rc = cmd_freq_sweep(argv[2], atoi(argv[3]), argv[4], atoi(argv[5]),
+			atoi(argv[6]), atoi(argv[7]), atoi(argv[8]));
+	else
+	{
+		fprintf(stderr, "unknown mode or missing args: %s\n", mode.c_str());
+		rc = 2;
+	}
+	llama_backend_free();
+	return (rc);
+}
