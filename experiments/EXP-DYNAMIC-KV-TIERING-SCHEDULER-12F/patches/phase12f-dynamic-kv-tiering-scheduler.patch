+#!/usr/bin/env python3
+"""One-shot script that reads Phase 12F raw probe output and writes the
+processed results/phase12/dynamic-tiering-scheduler/*.json artifacts.
+Not part of the product; research-only, run once, kept for provenance."""
+import json
+import re
+from pathlib import Path
+
+R = Path(__file__).resolve().parent.parent / "results" / "phase12" / "dynamic-tiering-scheduler"
+
+
+def load_jsonl(path):
+    out = []
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                out.append(json.loads(line))
+    return out
+
+
+def load_json_lines_mixed(path):
+    """stderr logs mix llama.cpp text logs with JSON lines; extract only JSON lines."""
+    out = []
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if line.startswith("{"):
+                try:
+                    out.append(json.loads(line))
+                except json.JSONDecodeError:
+                    pass
+    return out
+
+
+# ---------- scheduler_config.json (Section 4) ----------
+scheduler_config = {
+    "schema_version": 1,
+    "n_total_layers_135m": 30,
+    "n_total_layers_360m": 32,
+    "initial_gpu_layers_135m": list(range(20, 30)),
+    "promotion_groups": [
+        {"decode_trigger": 5, "layers": [16, 17, 18, 19]},
+    ],
+    "demotion_groups": [
+        {"decode_trigger": 10, "layers": [16, 17, 18, 19]},
+    ],
+    "note": "Deterministic V1 policy: fixed decode-index triggers, fixed layer "
+            "groups. No learned/adaptive component. See scheduler_core.h/.c.",
+}
+(R / "scheduler_config.json").write_text(json.dumps(scheduler_config, indent=2))
+
+# ---------- state_machine.json (Section 2) ----------
+state_machine = {
+    "schema_version": 1,
+    "layer_states": ["CPU_RESIDENT", "GPU_RESIDENT", "PROMOTING", "DEMOTING", "ERROR"],
+    "sched_states": ["IDLE", "PLANNING", "APPLYING", "SYNCING", "FAILED"],
+    "transitions": {
+        "begin_promote": "CPU_RESIDENT -> PROMOTING",
+        "commit_promote": "PROMOTING -> GPU_RESIDENT",
+        "fail_promote": "PROMOTING -> ERROR",
+        "begin_demote": "GPU_RESIDENT -> DEMOTING",
+        "commit_demote": "DEMOTING -> CPU_RESIDENT",
+        "fail_demote": "DEMOTING -> ERROR",
+    },
+    "invariant": "ERROR is terminal for a layer within a run; no transition out "
+                 "of ERROR is defined in scheduler_core.c.",
+}
+(R / "state_machine.json").write_text(json.dumps(state_machine, indent=2))
+
+# ---------- first_schedule.json (Section 6) + decision_trace.jsonl (Section 26) ----------
+trace = load_jsonl(R / "raw_first_schedule_trace.jsonl")
+stderr_lines = load_json_lines_mixed(R / "raw_first_schedule_stderr.txt")
+vram_steps = [l for l in stderr_lines if "vram_step" in l]
+gen_tokens = next((l["generated_tokens"] for l in stderr_lines if "generated_tokens" in l), None)
+
+with open(R / "decision_trace.jsonl", "w") as f:
+    for entry in trace:
+        f.write(json.dumps(entry) + "\n")
+
+expected = [
+    (5, 16, "PROMOTE"), (5, 17, "PROMOTE"), (5, 18, "PROMOTE"), (5, 19, "PROMOTE"),
+    (10, 16, "DEMOTE"), (10, 17, "DEMOTE"), (10, 18, "DEMOTE"), (10, 19, "DEMOTE"),
+]
+actual = [(e["decode_idx"], e["layer"], e["action"]) for e in trace]
+all_expected_occurred = all(e in actual for e in expected)
+all_ok = all(e["result"] == "ok" for e in trace)
+
+first_schedule = {
+    "schema_version": 1,
+    "model": "SmolLM2-135M-Instruct-f16.gguf",
+    "n_ctx": 2048,
+    "kv_type": "Q8_0",
+    "n_layer": 30,
