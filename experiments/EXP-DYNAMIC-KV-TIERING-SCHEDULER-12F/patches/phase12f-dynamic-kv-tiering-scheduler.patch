+@check("Phase 12F: no llama.cpp source files were modified by this phase "
+	"-- manifest.json's llama_cpp_verification.dirty_files is recomputed "
+	"as the exact union of files touched by the 4 established patch files "
+	"on disk (read-only), the pinned commit matches the currently checked "
+	"out submodule HEAD, and the live working tree's dirty-file set matches "
+	"both exactly, with no file outside that set touched")
+def _c119():
+	m = _load_v12f("manifest.json")
+	bad = []
+	if m.get("no_llama_cpp_changes") is not True:
+		bad.append(f"manifest.json no_llama_cpp_changes={m.get('no_llama_cpp_changes')!r}, expected True")
+	v = m.get("llama_cpp_verification", {})
+	if v.get("reconstruction_byte_identical") is not True:
+		bad.append(f"llama_cpp_verification.reconstruction_byte_identical={v.get('reconstruction_byte_identical')!r}, expected True")
+	claimed_dirty = set(v.get("dirty_files", []))
+	patch_files = v.get("applied_patches_in_order", [])
+	union_from_patches = set()
+	for rel in patch_files:
+		p = REPO_ROOT / rel
+		if not p.exists():
+			bad.append(f"referenced patch file does not exist: {rel}")
+			continue
+		union_from_patches |= {
+			m2.group(1) for m2 in re.finditer(r"^diff --git a/(\S+) b/\S+$", p.read_text(), re.MULTILINE)
+		}
+	if claimed_dirty != union_from_patches:
+		bad.append(f"manifest dirty_files does not match the union of files touched by the listed patches: manifest={claimed_dirty}, recomputed={union_from_patches}")
+	llama_dir = REPO_ROOT / "third_party" / "llama.cpp"
+	res = subprocess.run(["git", "-C", str(llama_dir), "status", "--short"],
+		capture_output=True, text=True)
+	if res.returncode != 0:
+		bad.append(f"git status failed in third_party/llama.cpp: {res.stderr.strip()}")
+	else:
+		live_dirty = {line[3:].strip() for line in res.stdout.splitlines() if line.strip()}
+		if live_dirty != claimed_dirty:
+			bad.append(f"live submodule dirty-file set does not match manifest's recorded set: live={live_dirty}, manifest={claimed_dirty}")
+	head_res = subprocess.run(["git", "-C", str(llama_dir), "rev-parse", "HEAD"],
+		capture_output=True, text=True)
+	if head_res.returncode != 0 or head_res.stdout.strip() != v.get("pinned_commit"):
+		bad.append(f"submodule HEAD {head_res.stdout.strip()!r} does not match manifest pinned_commit {v.get('pinned_commit')!r}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(claimed_dirty)} dirty files match the patch-file union and the live submodule state exactly, pinned commit confirmed"
