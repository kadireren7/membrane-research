new file mode 100644
index 0000000..62e5eaa
--- /dev/null
+++ b/tools/membrane-kv-device-override/device_override_probe.cpp
@@ -0,0 +1,238 @@
+/*
+ * Phase 12B, Sections 7/8/9: minimal research integration for the new
+ * llama.cpp kv_dev_override callback (patches/llama.cpp-membrane-kv-
+ * device-override.patch). Deterministic, manual placement only -- no
+ * promotion/demotion, no scheduler, no product CLI.
+ *
+ * Sets llama_context_params.kv_dev_override to a fixed split (layers
+ * [0, split) -> CPU KV, [split, n_layer) -> GPU KV) while --gpu-layers
+ * all keeps every layer's WEIGHTS on GPU throughout (kv_dev_override
+ * has no access to weight tensors -- it can only steer llama_kv_cache's
+ * own per-layer buft resolution, see the patch itself).
+ *
+ * Proves per-layer placement two independent ways:
+ *   1. llama.cpp's own LLAMA_LOG_DEBUG lines (load_tensors: layer N
+ *      assigned to device ... for WEIGHTS; llama_kv_cache's own
+ *      "layer N: dev = ..." for KV) -- captured from real stderr.
+ *   2. cb_eval + ggml_tensor::view_src (same public-API mechanism
+ *      proven in Phase 12A) directly reading cache_k_lN/cache_v_lN's
+ *      real ggml_backend_buffer_name() -- independent of any log text.
+ */
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "llama.h"
+
+struct split_ctx_t
+{
+	int32_t	split;
+};
+
+static ggml_backend_dev_t	split_kv_dev_override(int32_t il,
+				ggml_backend_dev_t default_dev, void *ud)
+{
+	split_ctx_t	*s = static_cast<split_ctx_t *>(ud);
+
+	if (il < s->split)
+		return (ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+	return (default_dev);
+}
+
+/* Section 19 safety test: a callback that ALWAYS returns NULL must be
+ * exactly equivalent to no callback at all (default_dev used for
+ * every layer) -- the patch's own documented NULL-return contract. */
+static ggml_backend_dev_t	always_null_kv_dev_override(int32_t,
+				ggml_backend_dev_t, void *)
+{
+	return (nullptr);
+}
+
+struct capture_ctx_t
+{
+	int32_t					n_layer;
+	std::vector<ggml_tensor *>	k_leaf;
+	std::vector<ggml_tensor *>	v_leaf;
+};
+
+static bool	layer_from_name(const char *name, const char *prefix, int32_t *out)
+{
+	size_t	plen = strlen(prefix);
+	char	*end;
+	long	v;
+
+	if (strncmp(name, prefix, plen) != 0)
+		return (false);
+	v = strtol(name + plen, &end, 10);
+	if (end == name + plen || v < 0)
+		return (false);
+	*out = (int32_t)v;
+	return (true);
+}
+
+static bool	capture_cb(struct ggml_tensor *t, bool ask, void *ud)
+{
+	capture_ctx_t	*c = static_cast<capture_ctx_t *>(ud);
+	int32_t			layer;
+
+	if (ask)
+		return (true);
+	if (layer_from_name(t->name, "cache_k_l", &layer) && layer < c->n_layer
+			&& c->k_leaf[layer] == nullptr)
+		c->k_leaf[layer] = t->view_src != nullptr ? t->view_src : t;
+	else if (layer_from_name(t->name, "cache_v_l", &layer) && layer < c->n_layer
+			&& c->v_leaf[layer] == nullptr)
+		c->v_leaf[layer] = t->view_src != nullptr ? t->view_src : t;
+	return (true);
+}
+
+static const char	*kv_type_name(const char *s)
+{
+	if (strcmp(s, "q8") == 0)
+		return ("Q8_0");
+	if (strcmp(s, "q5") == 0)
+		return ("Q5_1");
+	return ("F16");
+}
+
+int	main(int argc, char **argv)
+{
+	if (argc < 3)
+	{
+		fprintf(stderr, "usage: %s MODEL.gguf split_layer [n_ctx] [kv_type:q8|q5|f16] [gen_tokens]\n", argv[0]);
+		return (2);
+	}
+	const char	*model_path = argv[1];
+	int32_t		split = atoi(argv[2]);
+	int32_t		n_ctx = argc > 3 ? atoi(argv[3]) : 2048;
+	const char	*kv_type_str = argc > 4 ? argv[4] : "q8";
+	int			gen_tokens = argc > 5 ? atoi(argv[5]) : 8;
+
+	llama_backend_init();
+	llama_model_params	mp = llama_model_default_params();
+	mp.n_gpu_layers = -1; /* all weights offloaded, unaffected by kv_dev_override */
+	llama_model	*model = llama_model_load_from_file(model_path, mp);
+	if (model == nullptr)
+	{
+		fprintf(stderr, "model load failed\n");
+		return (3);
+	}
+	int32_t		n_layer = llama_model_n_layer(model);
+	const llama_vocab	*vocab = llama_model_get_vocab(model);
+
+	capture_ctx_t	cap;
+	cap.n_layer = n_layer;
+	cap.k_leaf.assign(n_layer, nullptr);
+	cap.v_leaf.assign(n_layer, nullptr);
+
+	split_ctx_t	split_ctx = {split};
+
+	ggml_type	kvt = strcmp(kv_type_str, "q8") == 0 ? GGML_TYPE_Q8_0
+		: strcmp(kv_type_str, "q5") == 0 ? GGML_TYPE_Q5_1 : GGML_TYPE_F16;
+
+	llama_context_params	cp = llama_context_default_params();
+	cp.n_ctx = n_ctx;
+	cp.type_k = kvt;
+	cp.type_v = kvt;
+	cp.cb_eval = capture_cb;
+	cp.cb_eval_user_data = &cap;
+	/* split < 0 is a sentinel meaning "do not install any kv_dev_override
+	 * callback at all" -- Section 19/20's null-callback-equals-default
+	 * test needs the TRUE nullptr path, not merely a callback that
+	 * happens to always return default_dev (that tests a different,
+	 * also-useful thing: a well-behaved callback that chooses not to
+	 * override anything, exercised whenever split == 0). */
+	if (split == -2)
+		cp.kv_dev_override = always_null_kv_dev_override;
+	else if (split >= 0)
+	{
+		cp.kv_dev_override = split_kv_dev_override;
+		cp.kv_dev_override_ud = &split_ctx;
+	}
+
+	llama_context	*ctx = llama_init_from_model(model, cp);
+	if (ctx == nullptr)
+	{
+		fprintf(stderr, "context creation failed\n");
+		return (4);
+	}
+
+	std::vector<llama_token>	tokens(64);
+	const char	*prompt = "The quick brown fox jumps over the lazy dog";
+	int	n = llama_tokenize(vocab, prompt, (int32_t)strlen(prompt), tokens.data(),
+			(int32_t)tokens.size(), true, false);
+	if (n < 0)
+	{
+		fprintf(stderr, "tokenize failed\n");
+		return (5);
+	}
+	tokens.resize(n);
+	llama_batch	batch = llama_batch_get_one(tokens.data(), (int32_t)tokens.size());
+	auto	t_prompt0 = std::chrono::steady_clock::now();
+	if (llama_decode(ctx, batch) != 0)
+	{
+		fprintf(stderr, "prompt decode failed\n");
+		return (6);
+	}
+	auto	t_prompt1 = std::chrono::steady_clock::now();
+	double	prompt_ms = std::chrono::duration<double, std::milli>(t_prompt1 - t_prompt0).count();
+
+	int32_t		n_vocab = llama_vocab_n_tokens(vocab);
+	std::vector<llama_token>	gen;
+	auto	t_gen0 = std::chrono::steady_clock::now();
+	for (int i = 0; i < gen_tokens; i++)
+	{
+		const float	*logits = llama_get_logits_ith(ctx, -1);
+		int	best = 0;
+		for (int j = 1; j < n_vocab; j++)
+			if (logits[j] > logits[best])
+				best = j;
+		llama_token	tok = (llama_token)best;
+		gen.push_back(tok);
+		llama_batch	b1 = llama_batch_get_one(&tok, 1);
+		if (llama_decode(ctx, b1) != 0)
+		{
+			fprintf(stderr, "generation failed at step %d\n", i);
+			return (7);
+		}
+	}
+	auto	t_gen1 = std::chrono::steady_clock::now();
+	double	gen_ms = std::chrono::duration<double, std::milli>(t_gen1 - t_gen0).count();
+	double	prompt_tok_per_s = n / (prompt_ms / 1000.0);
+	double	gen_tok_per_s = gen_tokens / (gen_ms / 1000.0);
+
+	printf("{\"schema_version\":1,\"n_layer\":%d,\"split\":%d,\"n_ctx\":%d,"
+		"\"kv_type\":\"%s\",\"gen_tokens\":%d,"
+		"\"prompt_tok_per_s\":%.4f,\"generation_tok_per_s\":%.4f,"
+		"\"per_layer_kv_device\":[",
+		n_layer, split, n_ctx, kv_type_name(kv_type_str), gen_tokens,
+		prompt_tok_per_s, gen_tok_per_s);
+	int	n_cpu_kv = 0;
+	int	n_gpu_kv = 0;
+	for (int32_t i = 0; i < n_layer; i++)
+	{
+		const char	*k_buf = cap.k_leaf[i] ? ggml_backend_buffer_name(cap.k_leaf[i]->buffer) : "MISSING";
+		const char	*v_buf = cap.v_leaf[i] ? ggml_backend_buffer_name(cap.v_leaf[i]->buffer) : "MISSING";
+		bool	is_cpu = strstr(k_buf, "CPU") != nullptr;
+		if (is_cpu)
+			n_cpu_kv++;
+		else
+			n_gpu_kv++;
+		printf("%s{\"layer\":%d,\"expected\":\"%s\",\"k_buffer\":\"%s\",\"v_buffer\":\"%s\",\"k_v_agree\":%s}",
+			i == 0 ? "" : ",", i, i < split ? "CPU" : "GPU", k_buf, v_buf,
+			strcmp(k_buf, v_buf) == 0 ? "true" : "false");
+	}
+	printf("],\"n_cpu_kv_layers\":%d,\"n_gpu_kv_layers\":%d,"
+		"\"generated_tokens_list\":[", n_cpu_kv, n_gpu_kv);
+	for (size_t i = 0; i < gen.size(); i++)
+		printf("%s%d", i == 0 ? "" : ",", gen[i]);
+	printf("]}\n");
+
+	llama_free(ctx);
+	llama_model_free(model);
+	llama_backend_free();
+	return (0);
+}
diff --git a/tools/membrane-kv-device-override/split_policy.c b/tools/membrane-kv-device-override/split_policy.c
new file mode 100644
index 0000000..c10fe1b
--- /dev/null
+++ b/tools/membrane-kv-device-override/split_policy.c
@@ -0,0 +1,42 @@
+#include <stddef.h>
+
+#include "split_policy.h"
+
+int	membrane_kv_split_decide(int32_t il, int32_t n_layer, int32_t split)
+{
+	int32_t	clamped_split;
+
+	if (n_layer <= 0 || il < 0 || il >= n_layer)
+		return (-1);
+	clamped_split = split;
+	if (clamped_split < 0)
+		clamped_split = 0;
+	if (clamped_split > n_layer)
+		clamped_split = n_layer;
+	if (il < clamped_split)
+		return (MEMBRANE_KV_DEVICE_CPU);
+	return (MEMBRANE_KV_DEVICE_GPU);
+}
+
+int	membrane_kv_split_placement_map(int32_t n_layer, int32_t split,
+		int *out_device, int32_t *out_n_cpu, int32_t *out_n_gpu)
+{
+	int32_t	i;
+	int		d;
+
+	if (n_layer <= 0 || out_device == NULL || out_n_cpu == NULL
+			|| out_n_gpu == NULL)
+		return (0);
+	*out_n_cpu = 0;
+	*out_n_gpu = 0;
+	for (i = 0; i < n_layer; i++)
+	{
+		d = membrane_kv_split_decide(i, n_layer, split);
+		out_device[i] = d;
+		if (d == MEMBRANE_KV_DEVICE_CPU)
+			(*out_n_cpu)++;
+		else
+			(*out_n_gpu)++;
+	}
+	return (1);
+}
diff --git a/tools/membrane-kv-device-override/split_policy.h b/tools/membrane-kv-device-override/split_policy.h
new file mode 100644
index 0000000..1697da5
--- /dev/null
+++ b/tools/membrane-kv-device-override/split_policy.h
@@ -0,0 +1,49 @@
+#ifndef MEMBRANE_KV_DEVICE_OVERRIDE_SPLIT_POLICY_H
+# define MEMBRANE_KV_DEVICE_OVERRIDE_SPLIT_POLICY_H
+
+# include <stdint.h>
+
+# ifdef __cplusplus
+extern "C" {
+# endif
+
+/*
+ * Phase 12B, Section 20: llama-free (no ggml/llama header) pure logic
+ * mirroring device_override_probe.cpp's split_kv_dev_override exactly
+ * (layers [0, split) -> CPU KV, [split, n_layer) -> GPU KV), kept
+ * separate and testable without a model/GPU. RESEARCH ONLY,
+ * experiment/kv-device-override branch only.
+ */
+
+# define MEMBRANE_KV_DEVICE_CPU	0
+# define MEMBRANE_KV_DEVICE_GPU	1
+
+/*
+ * Returns MEMBRANE_KV_DEVICE_CPU if il < split, else
+ * MEMBRANE_KV_DEVICE_GPU -- the exact decision device_override_probe's
+ * real llama.cpp-facing callback makes. split is clamped to [0,
+ * n_layer] first (mirrors the real callback's tolerance: an
+ * out-of-range split does not crash or misbehave, it just saturates
+ * to all-CPU or all-GPU). Returns -1 (invalid) only for il out of
+ * [0, n_layer) or n_layer <= 0 -- a real llama.cpp caller never
+ * passes such an il (the constructor's own loop bounds guarantee
+ * this), but the pure function fails closed anyway rather than
+ * guessing.
+ */
+int	membrane_kv_split_decide(int32_t il, int32_t n_layer, int32_t split);
+
+/*
+ * Fills out_device[i] for i in [0, n_layer) using
+ * membrane_kv_split_decide, and returns the count of CPU-placed and
+ * GPU-placed layers via out_n_cpu/out_n_gpu (which always sum to
+ * n_layer). Returns 1 on success, 0 (fails closed, outputs untouched)
+ * for n_layer <= 0 or a NULL out_device/out_n_cpu/out_n_gpu.
+ */
+int	membrane_kv_split_placement_map(int32_t n_layer, int32_t split,
+		int *out_device, int32_t *out_n_cpu, int32_t *out_n_gpu);
+
+# ifdef __cplusplus
+}
+# endif
+
+#endif
