+V12B_DIR = REPO_ROOT / "results" / "phase12" / "kv-device-override"
+_V12B_CACHE = {}
+
+
+def _load_v12b(name):
+	key = name
+	if key not in _V12B_CACHE:
+		path = V12B_DIR / name
+		if name.endswith(".jsonl"):
+			rows = []
+			with path.open() as f:
+				for line in f:
+					line = line.strip()
+					if line:
+						rows.append(json.loads(line))
+			_V12B_CACHE[key] = rows
+		else:
+			_V12B_CACHE[key] = json.loads(path.read_text())
+	return _V12B_CACHE[key]
+
+
+@check("Phase 12B: manifest.json exists, valid JSON, schema_version 1, "
+	"lists every actual .json/.jsonl file in the directory and no "
+	"others")
+def _c64():
+	if not (V12B_DIR / "manifest.json").exists():
+		return False, f"{V12B_DIR}/manifest.json does not exist"
+	m = _load_v12b("manifest.json")
+	bad = []
+	if m.get("schema_version") != 1:
+		bad.append(f"schema_version={m.get('schema_version')!r}")
+	listed = set(m.get("files", {}).keys())
+	actual = {p.name for p in V12B_DIR.glob("*") if p.suffix in (".json", ".jsonl")}
+	if listed != actual:
+		bad.append(f"listed-vs-actual mismatch: missing={actual - listed}, extra={listed - actual}")
+	return len(bad) == 0, "; ".join(bad) if bad else f"{len(listed)} files listed, exact match with directory contents"
+
+
+@check("Phase 12B: patch provenance -- patches/llama.cpp-membrane-kv-"
+	"device-override.patch exists, and patch_scope.json's claimed line "
+	"counts are recomputed exactly from the real patch file")
+def _c65():
+	patch_path = REPO_ROOT / "patches" / "llama.cpp-membrane-kv-device-override.patch"
+	if not patch_path.exists():
+		return False, f"{patch_path} does not exist"
+	text = patch_path.read_text()
+	lines = text.splitlines()
+	ins = sum(1 for l in lines if l.startswith("+") and not l.startswith("+++"))
+	dels = sum(1 for l in lines if l.startswith("-") and not l.startswith("---"))
+	ps = _load_v12b("patch_scope.json")
+	claimed = ps.get("line_count", {})
+	bad = []
+	if ins != claimed.get("insertions"):
+		bad.append(f"recomputed insertions={ins} != claimed {claimed.get('insertions')}")
+	if dels != claimed.get("deletions"):
+		bad.append(f"recomputed deletions={dels} != claimed {claimed.get('deletions')}")
+	files_changed = set(re.findall(r"^diff --git a/(\S+) b/\S+$", text, re.MULTILINE))
+	claimed_files = set(ps.get("files_changed", []))
+	if files_changed != claimed_files:
+		bad.append(f"files changed mismatch: patch has {files_changed}, claimed {claimed_files}")
+	return len(bad) == 0, "; ".join(bad) if bad else "patch line counts and file list recomputed exactly from the real patch file"
+
+
+@check("Phase 12B: default_regression.json's null/always-null/always-"
+	"default callback equivalence claim is backed by identical "
+	"placement AND identical generated tokens across all three variants")
