+  #
+  # Idempotency is checked by a unique CONTENT marker (grep-style, via
+  # CMake's own file(READ)/string(FIND)) rather than `git apply
+  # --reverse --check`: once two (or more) layered patches touch
+  # adjacent lines in the same file (as the type-override and device-
+  # override patches below do, deliberately, for readability -- the
+  # device-override callback is threaded in right next to the existing
+  # type-override one everywhere), a patch's OWN reverse-apply check
+  # stops matching as soon as a LATER patch is also applied, because
+  # its context lines have shifted. A content marker has no such
+  # ordering/adjacency sensitivity.
+  function(membrane_apply_llama_patch patch_file marker_file marker_string label)
+    file(READ ${CMAKE_SOURCE_DIR}/third_party/llama.cpp/${marker_file} _membrane_marker_contents)
+    string(FIND "${_membrane_marker_contents}" "${marker_string}" _membrane_marker_pos)
+    if(_membrane_marker_pos EQUAL -1)
+      execute_process(
+        COMMAND git apply ${patch_file}
+        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}/third_party/llama.cpp
+        RESULT_VARIABLE _membrane_apply_result)
+      if(NOT _membrane_apply_result EQUAL 0)
+        message(FATAL_ERROR "failed to apply ${patch_file} to "
+          "third_party/llama.cpp -- see docs/phase4-runtime-policy.md and "
+          "results/phase12/kv-device-override/")
+      endif()
+      message(STATUS "applied MEMBRANE ${label} patch to llama.cpp")
     endif()
-    message(STATUS "applied MEMBRANE kv_type_override patch to llama.cpp")
-  endif()
+  endfunction()
