+#include "split_policy.h"
+#include "test_helpers.h"
+
+static void	test_basic_split(void)
+{
+	TEST_ASSERT(membrane_kv_split_decide(0, 30, 15) == MEMBRANE_KV_DEVICE_CPU,
+		"layer 0 < split(15) -> CPU");
+	TEST_ASSERT(membrane_kv_split_decide(14, 30, 15) == MEMBRANE_KV_DEVICE_CPU,
+		"layer 14 < split(15) -> CPU (last CPU layer)");
+	TEST_ASSERT(membrane_kv_split_decide(15, 30, 15) == MEMBRANE_KV_DEVICE_GPU,
+		"layer 15 == split -> GPU (first GPU layer, boundary is exclusive on split)");
+	TEST_ASSERT(membrane_kv_split_decide(29, 30, 15) == MEMBRANE_KV_DEVICE_GPU,
+		"layer 29 (last layer) -> GPU");
+}
+
+static void	test_split_zero_is_all_gpu(void)
+{
+	TEST_ASSERT(membrane_kv_split_decide(0, 30, 0) == MEMBRANE_KV_DEVICE_GPU,
+		"split=0 -> layer 0 is GPU (matches 'default_dev used for every "
+		"layer', i.e. null-callback-equivalent behavior)");
+	TEST_ASSERT(membrane_kv_split_decide(29, 30, 0) == MEMBRANE_KV_DEVICE_GPU,
+		"split=0 -> every layer is GPU");
+}
+
+static void	test_split_full_is_all_cpu(void)
+{
+	TEST_ASSERT(membrane_kv_split_decide(0, 30, 30) == MEMBRANE_KV_DEVICE_CPU,
+		"split=n_layer -> layer 0 is CPU");
+	TEST_ASSERT(membrane_kv_split_decide(29, 30, 30) == MEMBRANE_KV_DEVICE_CPU,
+		"split=n_layer -> every layer is CPU");
+}
+
+static void	test_split_clamped_negative(void)
+{
+	TEST_ASSERT(membrane_kv_split_decide(0, 30, -5) == MEMBRANE_KV_DEVICE_GPU,
+		"a negative split clamps to 0 (all-GPU), never crashes or "
+		"misbehaves");
+}
+
+static void	test_split_clamped_over_range(void)
+{
+	TEST_ASSERT(membrane_kv_split_decide(29, 30, 999) == MEMBRANE_KV_DEVICE_CPU,
+		"a split larger than n_layer clamps to n_layer (all-CPU)");
+}
+
+static void	test_layer_bounds_rejected(void)
+{
+	TEST_ASSERT(membrane_kv_split_decide(-1, 30, 15) == -1,
+		"negative layer index fails closed (-1), never silently treated "
+		"as layer 0");
+	TEST_ASSERT(membrane_kv_split_decide(30, 30, 15) == -1,
+		"il == n_layer (one past the end) fails closed");
+	TEST_ASSERT(membrane_kv_split_decide(999, 30, 15) == -1,
+		"far-out-of-range il fails closed");
+	TEST_ASSERT(membrane_kv_split_decide(0, 0, 15) == -1,
+		"n_layer <= 0 fails closed");
+}
+
+static void	test_placement_map_exact_counts(void)
+{
+	int		devices[30];
+	int32_t	n_cpu;
+	int32_t	n_gpu;
+
+	TEST_ASSERT(membrane_kv_split_placement_map(30, 15, devices, &n_cpu,
+			&n_gpu) == 1, "placement map resolves");
+	TEST_ASSERT(n_cpu == 15 && n_gpu == 15, "exactly 15/15 split");
+	TEST_ASSERT(n_cpu + n_gpu == 30,
+		"n_cpu + n_gpu == n_layer exactly, no layer double-counted or "
+		"dropped");
+	for (int32_t i = 0; i < 15; i++)
+		TEST_ASSERT(devices[i] == MEMBRANE_KV_DEVICE_CPU,
+			"first 15 layers report CPU in the map");
+	for (int32_t i = 15; i < 30; i++)
+		TEST_ASSERT(devices[i] == MEMBRANE_KV_DEVICE_GPU,
+			"last 15 layers report GPU in the map");
+}
+
+static void	test_placement_map_matches_measured_layer_counts(void)
+{
+	/* results/phase12/kv-device-override/raw_context_matrix_135m.jsonl:
+	 * split=25 on the real 30-layer SmolLM2-135M measured
+	 * n_cpu_kv_layers=25, n_gpu_kv_layers=5 -- the pure function must
+	 * reproduce this exactly. */
+	int		devices[30];
+	int32_t	n_cpu;
+	int32_t	n_gpu;
+
+	membrane_kv_split_placement_map(30, 25, devices, &n_cpu, &n_gpu);
+	TEST_ASSERT(n_cpu == 25 && n_gpu == 5,
+		"pure function reproduces the real measured 25/5 split exactly");
+}
+
+static void	test_placement_map_degenerate_inputs(void)
+{
+	int		devices[4];
+	int32_t	n_cpu = 99;
+	int32_t	n_gpu = 99;
+
+	TEST_ASSERT(membrane_kv_split_placement_map(0, 1, devices, &n_cpu, &n_gpu)
+		== 0, "n_layer<=0 fails closed");
+	TEST_ASSERT(membrane_kv_split_placement_map(4, 1, NULL, &n_cpu, &n_gpu)
+		== 0, "NULL out_device fails closed");
+}
+
+static void	test_deterministic_repeated_calls(void)
+{
+	int		devices1[30];
+	int		devices2[30];
+	int32_t	n_cpu1;
+	int32_t	n_cpu2;
+	int32_t	n_gpu1;
+	int32_t	n_gpu2;
+	int		i;
+	int		ok;
+
+	membrane_kv_split_placement_map(30, 15, devices1, &n_cpu1, &n_gpu1);
+	membrane_kv_split_placement_map(30, 15, devices2, &n_cpu2, &n_gpu2);
+	ok = (n_cpu1 == n_cpu2) && (n_gpu1 == n_gpu2);
+	for (i = 0; ok && i < 30; i++)
+		if (devices1[i] != devices2[i])
+			ok = 0;
+	TEST_ASSERT(ok, "identical inputs produce a byte-identical placement "
+		"map across calls");
+}
+
+int	main(void)
+{
+	test_basic_split();
+	test_split_zero_is_all_gpu();
+	test_split_full_is_all_cpu();
+	test_split_clamped_negative();
+	test_split_clamped_over_range();
+	test_layer_bounds_rejected();
+	test_placement_map_exact_counts();
+	test_placement_map_matches_measured_layer_counts();
+	test_placement_map_degenerate_inputs();
+	test_deterministic_repeated_calls();
+	printf("test_split_policy: all tests passed\n");
+	return (0);
+}
