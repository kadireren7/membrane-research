+	return len(bad) == 0, "; ".join(bad[:5]) if bad else f"{len(q5['points'])} Q5-vs-Q8 deltas reproduced exactly from raw_q5.jsonl"
+
+
+@check("Phase 12G: weight_compute_control.json is clearly labeled "
+	"control-only, both its rows keep KV 100%% GPU-resident (gpu_kv_pct==100 "
+	"in the raw data), and its weight_offload_slowdown_pct is recomputed "
