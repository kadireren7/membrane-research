+def _v12g_pareto(vram, tok):
+	n = len(vram)
+	is_pareto = [True] * n
+	for i in range(n):
+		for j in range(n):
+			if i == j:
+				continue
+			vram_le = vram[j] <= vram[i]
+			tok_ge = tok[j] >= tok[i]
+			strictly_better = (vram[j] < vram[i]) or (tok[j] > tok[i])
+			if vram_le and tok_ge and strictly_better:
+				is_pareto[i] = False
+				break
+	return is_pareto
