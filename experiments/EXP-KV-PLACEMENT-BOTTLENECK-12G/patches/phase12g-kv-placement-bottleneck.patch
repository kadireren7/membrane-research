diff --git a/tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.c b/tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.c
new file mode 100644
index 0000000..dab79da
--- /dev/null
+++ b/tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.c
@@ -0,0 +1,163 @@
+#include "bottleneck_analysis.h"
+
+#include <math.h>
+
+double	membrane_bottleneck_slowdown_pct(double baseline_tok_s,
+			double measured_tok_s, int *ok)
+{
+	if (baseline_tok_s <= 0.0)
+	{
+		if (ok)
+			*ok = 0;
+		return (0.0);
+	}
+	if (ok)
+		*ok = 1;
+	return (100.0 * (baseline_tok_s - measured_tok_s) / baseline_tok_s);
+}
+
+enum e_membrane_bottleneck_class	membrane_bottleneck_classify(
+			double slowdown_pct)
+{
+	if (slowdown_pct < 5.0)
+		return (MEMBRANE_BOTTLENECK_NO_BOTTLENECK);
+	if (slowdown_pct < 10.0)
+		return (MEMBRANE_BOTTLENECK_MINOR);
+	if (slowdown_pct < 20.0)
+		return (MEMBRANE_BOTTLENECK_MEANINGFUL);
+	return (MEMBRANE_BOTTLENECK_STRONG);
+}
+
+const char	*membrane_bottleneck_class_name(
+			enum e_membrane_bottleneck_class c)
+{
+	switch (c)
+	{
+	case MEMBRANE_BOTTLENECK_NO_BOTTLENECK:
+		return ("NO_BOTTLENECK");
+	case MEMBRANE_BOTTLENECK_MINOR:
+		return ("MINOR");
+	case MEMBRANE_BOTTLENECK_MEANINGFUL:
+		return ("MEANINGFUL");
+	case MEMBRANE_BOTTLENECK_STRONG:
+	default:
+		return ("STRONG");
+	}
+}
+
+double	membrane_bottleneck_cv_pct(const double *vals, size_t n)
+{
+	double	mean;
+	double	acc;
+	size_t	i;
+	double	var;
+	double	sd;
+
+	if (n == 0 || vals == NULL)
+		return (0.0);
+	if (n == 1)
+		return (0.0);
+	mean = 0.0;
+	for (i = 0; i < n; i++)
+		mean += vals[i];
+	mean /= (double)n;
+	if (mean == 0.0)
+		return (0.0);
+	acc = 0.0;
+	for (i = 0; i < n; i++)
+	{
+		double	d = vals[i] - mean;
+
+		acc += d * d;
+	}
+	var = acc / (double)(n - 1);
+	sd = sqrt(var);
+	return (100.0 * sd / mean);
+}
+
+int	membrane_bottleneck_host_batch_valid(
+			uint64_t before_mem_available_kb, uint64_t after_mem_available_kb,
+			uint64_t before_swap_used_kb, uint64_t after_swap_used_kb,
+			double after_load1, uint32_t *out_reason_mask)
+{
+	uint32_t	mask = 0;
+
+	if (before_mem_available_kb > 0)
+	{
+		double	drop_pct = 100.0
+			* (double)((int64_t)before_mem_available_kb - (int64_t)after_mem_available_kb)
+			/ (double)before_mem_available_kb;
+
+		if (drop_pct > 40.0)
+			mask |= 1u << 0;
+	}
+	{
+		double	swap_inc_mib =
+			((double)(int64_t)(after_swap_used_kb - before_swap_used_kb)) / 1024.0;
+
+		if (swap_inc_mib > 300.0)
+			mask |= 1u << 1;
+	}
+	if (after_load1 > 10.0)
+		mask |= 1u << 2;
+	if ((double)after_mem_available_kb / 1024.0 < 300.0)
+		mask |= 1u << 3;
+	if (out_reason_mask)
+		*out_reason_mask = mask;
+	return (mask == 0);
+}
+
+int	membrane_bottleneck_regime_confirmed(
+			double primary_slowdown_pct, double primary_cv_pct,
+			int primary_host_valid,
+			double secondary_slowdown_pct, int secondary_present)
+{
+	double	cv_cap;
+
+	if (primary_slowdown_pct < 10.0)
+		return (0);
+	if (!primary_host_valid)
+		return (0);
+	cv_cap = primary_slowdown_pct * 0.5;
+	if (cv_cap > 15.0)
+		cv_cap = 15.0;
+	if (primary_cv_pct >= cv_cap)
+		return (0);
+	if (!secondary_present)
+		return (0);
+	if (secondary_slowdown_pct < 10.0)
+		return (0);
+	return (1);
+}
+
+void	membrane_bottleneck_pareto(const double *vram_mib, const double *tok_s,
+			size_t n, int *out_is_pareto)
+{
+	size_t	i;
+	size_t	j;
+
+	if (out_is_pareto == NULL)
+		return ;
+	for (i = 0; i < n; i++)
+		out_is_pareto[i] = 1;
+	for (i = 0; i < n; i++)
+	{
+		for (j = 0; j < n; j++)
+		{
+			int	vram_le;
+			int	tok_ge;
+			int	strictly_better;
+
+			if (i == j)
+				continue ;
+			vram_le = vram_mib[j] <= vram_mib[i];
+			tok_ge = tok_s[j] >= tok_s[i];
+			strictly_better = (vram_mib[j] < vram_mib[i]) || (tok_s[j] > tok_s[i]);
+			if (vram_le && tok_ge && strictly_better)
+			{
+				out_is_pareto[i] = 0;
+				break ;
+			}
+		}
+	}
+}
diff --git a/tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.h b/tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.h
new file mode 100644
index 0000000..ba52509
--- /dev/null
+++ b/tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.h
@@ -0,0 +1,101 @@
+#ifndef MEMBRANE_KV_BOTTLENECK_ANALYSIS_H
+# define MEMBRANE_KV_BOTTLENECK_ANALYSIS_H
+
+# include <stdint.h>
+# include <stddef.h>
+
+# ifdef __cplusplus
+extern "C" {
+# endif
+
+/*
+ * Phase 12G: llama-free pure helper logic for the KV placement
+ * bottleneck discovery sweep -- slowdown/coefficient-of-variation
+ * math, the predeclared break-even classification (section 20), the
+ * predeclared host-noise validity rule (section 9), the bottleneck-
+ * regime criteria (section 21), and Pareto-set computation (section
+ * 24). No I/O, no ggml/llama dependency -- scripts/phase12g_run_sweep.py
+ * and scripts/verify-results.py both recompute their claims against
+ * this same logic (the Python side is a reimplementation checked by
+ * this module's unit tests, not the other way around: this C module
+ * is the single source of truth for the arithmetic itself).
+ * RESEARCH ONLY, experiment/kv-placement-bottleneck-discovery branch
+ * only. Never linked into membrane-run.
+ */
+
+# define MEMBRANE_BOTTLENECK_MAX_POINTS 256
+
+enum e_membrane_bottleneck_class
+{
+	MEMBRANE_BOTTLENECK_NO_BOTTLENECK = 0,
+	MEMBRANE_BOTTLENECK_MINOR,
+	MEMBRANE_BOTTLENECK_MEANINGFUL,
+	MEMBRANE_BOTTLENECK_STRONG
+};
+
+/* Section 20: predeclared thresholds, <5% / 5-10% / 10-20% / >20%. Baseline
+ * must be a real, positive, comfortably-measured 100%-GPU-KV throughput;
+ * returns 0.0 (and *ok = false) if baseline_tok_s <= 0. Positive return
+ * means slower (a real slowdown); negative means the CPU-KV point was
+ * FASTER than the GPU-KV baseline (a real, valid outcome -- do not clamp
+ * to zero, section 29 forbids manufacturing a bottleneck as much as it
+ * forbids hiding a beneficial result). */
+double	membrane_bottleneck_slowdown_pct(double baseline_tok_s,
+			double measured_tok_s, int *ok);
+
+/* Section 20 classification, applied to a slowdown_pct that is already
+ * known-valid (see membrane_bottleneck_regime_confirmed below for the
+ * *reproducible bottleneck regime* gate, which is stricter than just
+ * classifying one number). */
+enum e_membrane_bottleneck_class	membrane_bottleneck_classify(
+			double slowdown_pct);
+
+const char	*membrane_bottleneck_class_name(
+			enum e_membrane_bottleneck_class c);
+
+/* Coefficient of variation, as a percentage. n must be >= 1; returns 0.0
+ * for n == 1 (no variance defined for a single sample). */
+double	membrane_bottleneck_cv_pct(const double *vals, size_t n);
+
+/* Section 9 host-noise validity rule. All four *_gt / *_below thresholds
+ * are predeclared, fixed policy (mirrors HOST_NOISE_RULE in
+ * scripts/phase12g_run_sweep.py) -- callers must not adjust them per
+ * result. Returns 1 (valid) or 0 (invalid); *out_reason_mask has one bit
+ * set per violated condition (bit 0 = mem_available_drop, bit 1 =
+ * swap_used_increase, bit 2 = load1_too_high, bit 3 = mem_available_too_low)
+ * so a caller/test can distinguish "no violation" from "some violation"
+ * without string parsing. */
+int	membrane_bottleneck_host_batch_valid(
+			uint64_t before_mem_available_kb, uint64_t after_mem_available_kb,
+			uint64_t before_swap_used_kb, uint64_t after_swap_used_kb,
+			double after_load1, uint32_t *out_reason_mask);
+
+/* Section 21: declare a bottleneck regime only if ALL of these hold:
+ *  - slowdown_pct >= 10.0 (the meaningful/strong boundary)
+ *  - the measurement's coefficient of variation is low enough that the
+ *    10% claim isn't noise (cv_pct < half the observed slowdown, and
+ *    never above 15% absolute -- a very noisy run cannot support ANY
+ *    claim regardless of how large the mean gap looks)
+ *  - host_batch_valid for the batch that produced it
+ *  - persists: a second nearby point (adjacent context OR a second
+ *    model/config) also shows slowdown_pct >= 10.0
+ * Returns 1 if confirmed, 0 otherwise. */
+int	membrane_bottleneck_regime_confirmed(
+			double primary_slowdown_pct, double primary_cv_pct,
+			int primary_host_valid,
+			double secondary_slowdown_pct, int secondary_present);
+
+/* Section 24: Pareto set over (vram_mib, tok_s) points -- lower vram_mib
+ * and higher tok_s are both "better". out_is_pareto[i] is set to 1 iff
+ * point i is not dominated by any other point j (j.vram_mib <= i.vram_mib
+ * AND j.tok_s >= i.tok_s, with at least one strict inequality). Points
+ * with identical (vram_mib, tok_s) are all marked Pareto-optimal (no
+ * point strictly dominates an exact tie). */
+void	membrane_bottleneck_pareto(const double *vram_mib, const double *tok_s,
+			size_t n, int *out_is_pareto);
+
+# ifdef __cplusplus
+}
+# endif
+
+#endif
diff --git a/tools/membrane-kv-bottleneck-analysis/test_bottleneck_analysis.c b/tools/membrane-kv-bottleneck-analysis/test_bottleneck_analysis.c
new file mode 100644
index 0000000..e193533
--- /dev/null
+++ b/tools/membrane-kv-bottleneck-analysis/test_bottleneck_analysis.c
@@ -0,0 +1,230 @@
+#include "bottleneck_analysis.h"
+#include "test_helpers.h"
+
+#include <math.h>
+#include <string.h>
+
+static void	test_slowdown_basic(void)
+{
+	int		ok = 0;
+	double	s = membrane_bottleneck_slowdown_pct(100.0, 90.0, &ok);
+
+	TEST_ASSERT(ok == 1, "valid baseline reports ok");
+	TEST_ASSERT(fabs(s - 10.0) < 1e-9, "10%% slower computes to 10.0");
+}
+
+static void	test_slowdown_negative_means_faster(void)
+{
+	int		ok = 0;
+	double	s = membrane_bottleneck_slowdown_pct(100.0, 110.0, &ok);
+
+	TEST_ASSERT(ok == 1, "valid baseline reports ok");
+	TEST_ASSERT(s < 0.0, "measured faster than baseline is a negative slowdown");
+	TEST_ASSERT(fabs(s - (-10.0)) < 1e-9, "10%% faster computes to -10.0, not clamped");
+}
+
+static void	test_slowdown_rejects_nonpositive_baseline(void)
+{
+	int		ok = 1;
+	double	s = membrane_bottleneck_slowdown_pct(0.0, 50.0, &ok);
+
+	TEST_ASSERT(ok == 0, "zero baseline is rejected via ok flag");
+	TEST_ASSERT(s == 0.0, "rejected call returns 0.0, not a bogus ratio");
+
+	ok = 1;
+	s = membrane_bottleneck_slowdown_pct(-5.0, 50.0, &ok);
+	TEST_ASSERT(ok == 0, "negative baseline is rejected via ok flag");
+	(void)s;
+}
+
+static void	test_classify_boundaries(void)
+{
+	TEST_ASSERT(membrane_bottleneck_classify(0.0) == MEMBRANE_BOTTLENECK_NO_BOTTLENECK,
+		"0%% is NO_BOTTLENECK");
+	TEST_ASSERT(membrane_bottleneck_classify(4.999) == MEMBRANE_BOTTLENECK_NO_BOTTLENECK,
+		"just under 5%% is NO_BOTTLENECK");
+	TEST_ASSERT(membrane_bottleneck_classify(5.0) == MEMBRANE_BOTTLENECK_MINOR,
+		"exactly 5%% is MINOR (boundary is inclusive on the upper side)");
+	TEST_ASSERT(membrane_bottleneck_classify(9.999) == MEMBRANE_BOTTLENECK_MINOR,
+		"just under 10%% is MINOR");
+	TEST_ASSERT(membrane_bottleneck_classify(10.0) == MEMBRANE_BOTTLENECK_MEANINGFUL,
+		"exactly 10%% is MEANINGFUL");
+	TEST_ASSERT(membrane_bottleneck_classify(19.999) == MEMBRANE_BOTTLENECK_MEANINGFUL,
+		"just under 20%% is MEANINGFUL");
+	TEST_ASSERT(membrane_bottleneck_classify(20.0) == MEMBRANE_BOTTLENECK_STRONG,
+		"exactly 20%% is STRONG");
+	TEST_ASSERT(membrane_bottleneck_classify(-50.0) == MEMBRANE_BOTTLENECK_NO_BOTTLENECK,
+		"a negative slowdown (faster) is NO_BOTTLENECK, not some negative class");
+}
+
+static void	test_classify_name_matches_enum(void)
+{
+	TEST_ASSERT(strcmp(membrane_bottleneck_class_name(MEMBRANE_BOTTLENECK_NO_BOTTLENECK),
+		"NO_BOTTLENECK") == 0, "NO_BOTTLENECK name");
+	TEST_ASSERT(strcmp(membrane_bottleneck_class_name(MEMBRANE_BOTTLENECK_MINOR),
+		"MINOR") == 0, "MINOR name");
+	TEST_ASSERT(strcmp(membrane_bottleneck_class_name(MEMBRANE_BOTTLENECK_MEANINGFUL),
+		"MEANINGFUL") == 0, "MEANINGFUL name");
+	TEST_ASSERT(strcmp(membrane_bottleneck_class_name(MEMBRANE_BOTTLENECK_STRONG),
+		"STRONG") == 0, "STRONG name");
+}
+
+static void	test_cv_pct_basic(void)
+{
+	double	vals[] = {10.0, 10.0, 10.0, 10.0};
+	double	c = membrane_bottleneck_cv_pct(vals, 4);
+
+	TEST_ASSERT(fabs(c - 0.0) < 1e-9, "identical values have 0%% CV");
+}
+
+static void	test_cv_pct_single_sample_is_zero(void)
+{
+	double	vals[] = {42.0};
+	double	c = membrane_bottleneck_cv_pct(vals, 1);
+
+	TEST_ASSERT(c == 0.0, "single sample has no defined variance, returns 0");
+}
+
+static void	test_cv_pct_known_value(void)
+{
+	/* mean=10, sample stddev (n-1) = sqrt(((8)^2+(0)^2+(0)^2+(0)^2... )) --
+	 * use a simple known case: {8,9,10,11,12} -> mean=10, sample var =
+	 * (4+1+0+1+4)/4 = 2.5, sd = sqrt(2.5) ~= 1.5811, cv = 15.811%. */
+	double	vals[] = {8.0, 9.0, 10.0, 11.0, 12.0};
+	double	c = membrane_bottleneck_cv_pct(vals, 5);
+
+	TEST_ASSERT(fabs(c - 15.8113883) < 1e-4, "known CV computed correctly");
+}
+
+static void	test_host_batch_valid_clean(void)
+{
+	uint32_t	mask = 0xFFFFFFFFu;
+	int			valid = membrane_bottleneck_host_batch_valid(
+			2000000, 1900000, 1000000, 1000000, 1.0, &mask);
+
+	TEST_ASSERT(valid == 1, "small mem drop, no swap growth, low load is valid");
+	TEST_ASSERT(mask == 0, "no reason bits set");
+}
+
+static void	test_host_batch_valid_mem_drop(void)
+{
+	uint32_t	mask = 0;
+	int			valid = membrane_bottleneck_host_batch_valid(
+			2000000, 1000000, 1000000, 1000000, 1.0, &mask);
+
+	TEST_ASSERT(valid == 0, "50%% mem_available drop invalidates the batch");
+	TEST_ASSERT((mask & (1u << 0)) != 0, "mem_available_drop bit is set");
+}
+
+static void	test_host_batch_valid_swap_growth(void)
+{
+	uint32_t	mask = 0;
+	int			valid = membrane_bottleneck_host_batch_valid(
+			2000000, 1950000, 1000000, 1400000, 1.0, &mask);
+
+	TEST_ASSERT(valid == 0, "400MiB swap growth invalidates the batch");
+	TEST_ASSERT((mask & (1u << 1)) != 0, "swap_used_increase bit is set");
+}
+
+static void	test_host_batch_valid_high_load(void)
+{
+	uint32_t	mask = 0;
+	int			valid = membrane_bottleneck_host_batch_valid(
+			2000000, 1950000, 1000000, 1000000, 15.0, &mask);
+
+	TEST_ASSERT(valid == 0, "load1=15 invalidates the batch");
+	TEST_ASSERT((mask & (1u << 2)) != 0, "load1_too_high bit is set");
+}
+
+static void	test_host_batch_valid_low_mem_available(void)
+{
+	uint32_t	mask = 0;
+	int			valid = membrane_bottleneck_host_batch_valid(
+			2000000, 200000, 1000000, 1000000, 1.0, &mask);
+
+	TEST_ASSERT(valid == 0, "after mem_available under 300MiB invalidates the batch");
+	TEST_ASSERT((mask & (1u << 3)) != 0, "mem_available_too_low bit is set");
+	TEST_ASSERT((mask & (1u << 0)) != 0,
+		"a 90%% drop ALSO trips the drop-pct rule -- multiple bits can be set");
+}
+
+static void	test_regime_confirmed_requires_all_four_gates(void)
+{
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(15.0, 2.0, 1, 12.0, 1) == 1,
+		"clean 15%% primary, low CV, valid host, confirmed secondary -> CONFIRMED");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(8.0, 1.0, 1, 12.0, 1) == 0,
+		"primary under 10%% -> not confirmed even with a good secondary");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(15.0, 2.0, 0, 12.0, 1) == 0,
+		"invalid host batch -> not confirmed regardless of the numbers");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(15.0, 2.0, 1, 5.0, 1) == 0,
+		"secondary present but under 10%% -> not confirmed (no persistence)");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(15.0, 2.0, 1, 12.0, 0) == 0,
+		"no secondary point at all -> not confirmed (section 21 requires persistence)");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(11.0, 9.0, 1, 12.0, 1) == 0,
+		"CV too high relative to the slowdown itself (noise could explain it) -> not confirmed");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(80.0, 14.9, 1, 20.0, 1) == 1,
+		"even at a huge slowdown, CV is still capped at 15%% absolute, not scaled unboundedly");
+	TEST_ASSERT(membrane_bottleneck_regime_confirmed(80.0, 15.1, 1, 20.0, 1) == 0,
+		"CV above the 15%% absolute cap fails even for a huge nominal slowdown");
+}
+
+static void	test_pareto_dominated_point_excluded(void)
+{
+	/* (vram, tok/s): A=(1000,10) dominated by B=(800,12) -- less vram AND
+	 * more tok/s. C=(500,5) is not dominated (cheapest vram). */
+	double	vram[] = {1000.0, 800.0, 500.0};
+	double	tok[] = {10.0, 12.0, 5.0};
+	int		is_pareto[3] = {0, 0, 0};
+
+	membrane_bottleneck_pareto(vram, tok, 3, is_pareto);
+	TEST_ASSERT(is_pareto[0] == 0, "A is dominated by B, excluded from Pareto set");
+	TEST_ASSERT(is_pareto[1] == 1, "B dominates A, stays on the Pareto set");
+	TEST_ASSERT(is_pareto[2] == 1, "C is the cheapest-VRAM point, stays on the Pareto set");
+}
+
+static void	test_pareto_ties_both_kept(void)
+{
+	double	vram[] = {500.0, 500.0};
+	double	tok[] = {10.0, 10.0};
+	int		is_pareto[2] = {0, 0};
+
+	membrane_bottleneck_pareto(vram, tok, 2, is_pareto);
+	TEST_ASSERT(is_pareto[0] == 1, "exact tie: neither point strictly dominates the other (A)");
+	TEST_ASSERT(is_pareto[1] == 1, "exact tie: neither point strictly dominates the other (B)");
+}
+
+static void	test_pareto_all_optimal_when_no_domination(void)
+{
+	/* Classic trade-off frontier: more vram always buys more tok/s. */
+	double	vram[] = {100.0, 300.0, 900.0};
+	double	tok[] = {5.0, 12.0, 30.0};
+	int		is_pareto[3] = {0, 0, 0};
+
+	membrane_bottleneck_pareto(vram, tok, 3, is_pareto);
+	TEST_ASSERT(is_pareto[0] == 1, "low-vram/low-tok point is optimal (cheapest)");
+	TEST_ASSERT(is_pareto[1] == 1, "mid point is optimal (nothing beats it on both axes)");
+	TEST_ASSERT(is_pareto[2] == 1, "high-vram/high-tok point is optimal (fastest)");
+}
+
+int	main(void)
+{
+	test_slowdown_basic();
+	test_slowdown_negative_means_faster();
+	test_slowdown_rejects_nonpositive_baseline();
+	test_classify_boundaries();
+	test_classify_name_matches_enum();
+	test_cv_pct_basic();
+	test_cv_pct_single_sample_is_zero();
+	test_cv_pct_known_value();
+	test_host_batch_valid_clean();
+	test_host_batch_valid_mem_drop();
+	test_host_batch_valid_swap_growth();
+	test_host_batch_valid_high_load();
+	test_host_batch_valid_low_mem_available();
+	test_regime_confirmed_requires_all_four_gates();
+	test_pareto_dominated_point_excluded();
+	test_pareto_ties_both_kept();
+	test_pareto_all_optimal_when_no_domination();
+	printf("test_bottleneck_analysis: all tests passed\n");
+	return (0);
+}
