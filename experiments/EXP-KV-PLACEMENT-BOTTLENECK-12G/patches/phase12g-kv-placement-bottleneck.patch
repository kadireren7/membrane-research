+def _c132():
+	rp = _load_v12g("reproducibility.json")
+	raw = _load_v12g("raw_reproducibility.jsonl")
+	bad = []
+	worst_rows = [r["generation_tok_s"] for r in raw if r.get("_label") == "reproducibility_repro"]
+	control_rows = [r["generation_tok_s"] for r in raw if r.get("_label") == "reproducibility_control"]
+	if not worst_rows or not control_rows:
+		bad.append(f"missing raw rows: worst={len(worst_rows)}, control={len(control_rows)}")
+	else:
+		worst_mean = statistics.mean(worst_rows)
+		control_mean = statistics.mean(control_rows)
+		recomputed = 100.0 * (control_mean - worst_mean) / control_mean if control_mean else None
+		claimed = rp.get("fresh_batch_slowdown_pct")
+		if recomputed is not None and (claimed is None or abs(recomputed - claimed) > 1e-6):
+			bad.append(f"fresh_batch_slowdown_pct claimed={claimed}, recomputed={recomputed}")
+		orig = rp.get("original_slowdown_pct")
+		if orig is not None and claimed is not None:
+			expected_similar = abs(orig - claimed) <= max(5.0, 0.5 * abs(orig))
+			if rp.get("similar_relative_result") != expected_similar:
+				bad.append(f"similar_relative_result={rp.get('similar_relative_result')!r}, recomputed={expected_similar!r} from original={orig} vs fresh={claimed}")
+	return len(bad) == 0, "; ".join(bad) if bad else "fresh-batch slowdown reproduced exactly from raw data; reproducibility verdict matches the recomputed comparison"
+
+
+@check("Phase 12G: transfer_activity.json is explicitly labeled "
+	"ESTIMATED_NOT_DIRECTLY_MEASURED with a non-empty 'unresolved' "
