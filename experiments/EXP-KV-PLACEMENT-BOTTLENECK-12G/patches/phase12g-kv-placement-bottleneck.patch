+        valid, reasons = batch_valid(before, after)
+        host_baselines.append({
+            "phase": "B", "model": model_key, "n_ctx": n_ctx,
+            "before": before, "after": after, "valid": valid,
+            "invalid_reasons": reasons,
+        })
+    for pt in phase_b_points:
+        base = next((p for p in phase_b_points if p["model"] == pt["model"]
+                     and p["n_ctx"] == pt["n_ctx"] and p["gpu_kv_pct"] == 100), None)
+        base_mean = base["generation_tok_s"].get("mean") if base else None
+        this_mean = pt["generation_tok_s"].get("mean")
+        pt["slowdown_pct_vs_100gpu"] = (
+            100.0 * (base_mean - this_mean) / base_mean
+            if base_mean and this_mean is not None else None)
+
+    (R / "context_scaling.json").write_text(json.dumps(
+        {"schema_version": 1,
+         "note": "Phase B confirmed points (7 repeats) grouped by model/ratio "
+                 "across context, for the context-scaling question (section 15).",
+         "points": phase_b_points}, indent=2))
+
+    # ---------------- Larger model (1.5B) ----------------
+    print("=== Larger model (1.5B) sweep ===", file=sys.stderr)
+    raw_large = R / "raw_larger_model.jsonl"
+    if raw_large.exists():
+        raw_large.unlink()
+    large_points = []
+    large_contexts = [2048, 8192, 16384]
+    large_ratios = [100, 50, 0]
+    large_skipped = []
+    for n_ctx in large_contexts:
+        before = host_snapshot()
+        # VRAM safety check (section 27): weights ~3.3GiB, +KV; skip if the
+        # all-GPU-KV point would put us within 150MiB of the 4096MiB card.
+        est = run_probe(MODELS["1.5B"]["path"], n_ctx, "q8",
+                         split_for_ratio(MODELS["1.5B"]["n_layer"], 100), 4)
+        if "vram_used_mib" in est and est["vram_used_mib"] > 4096 - 150:
+            large_skipped.append({"n_ctx": n_ctx,
+                                   "reason": f"vram_used_mib={est['vram_used_mib']} "
+                                             f"too close to 4096MiB card limit"})
+            continue
+        for gpu_pct in large_ratios:
+            pt = run_point("1.5B", n_ctx, "q8", gpu_pct, n_repeats=5, n_decodes=32,
+                            raw_path=raw_large, label="larger_model")
+            large_points.append(pt)
+            print(f"  1.5B ctx={n_ctx} gpu%={gpu_pct} "
+                  f"tok/s(mean)={pt['generation_tok_s'].get('mean')}", file=sys.stderr)
+        after = host_snapshot()
+        valid, reasons = batch_valid(before, after)
+        host_baselines.append({"phase": "larger_model", "model": "1.5B",
+                                "n_ctx": n_ctx, "before": before, "after": after,
+                                "valid": valid, "invalid_reasons": reasons})
+    for pt in large_points:
+        base = next((p for p in large_points if p["n_ctx"] == pt["n_ctx"]
+                     and p["gpu_kv_pct"] == 100), None)
+        base_mean = base["generation_tok_s"].get("mean") if base else None
+        this_mean = pt["generation_tok_s"].get("mean")
+        pt["slowdown_pct_vs_100gpu"] = (
+            100.0 * (base_mean - this_mean) / base_mean
+            if base_mean and this_mean is not None else None)
+    (R / "larger_model.json").write_text(json.dumps(
+        {"schema_version": 1, "model": "qwen2.5-1.5b-instruct-fp16",
+         "n_layer": MODELS["1.5B"]["n_layer"], "kv_type": "Q8_0",
