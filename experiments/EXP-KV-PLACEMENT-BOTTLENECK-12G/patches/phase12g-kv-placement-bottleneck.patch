+            print(f"  B {model_key} ctx={n_ctx} gpu%={r} "
+                  f"tok/s(mean)={pt['generation_tok_s'].get('mean'):.3f} "
+                  f"cv%={pt['generation_tok_s'].get('cv_pct'):.2f}", file=sys.stderr)
