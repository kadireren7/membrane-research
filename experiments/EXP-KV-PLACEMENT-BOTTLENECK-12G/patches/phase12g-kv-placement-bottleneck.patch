@@ -0,0 +1,346 @@
+#!/usr/bin/env python3
+"""Phase 12G stage 2: reads the raw sweep output written by
+scripts/phase12g_run_sweep.py (+ scripts/phase12g_utilization_sample.py)
+and writes the remaining results/phase12/kv-placement-bottleneck/*.json
+artifacts: break_even.json, graph_splits.json, transfer_activity.json,
+bottleneck_map.json, pareto.json, dynamic_reentry.json (if applicable),
+manifest.json, summary.json. Research-only, not part of the product."""
+import json
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+R = ROOT / "results" / "phase12" / "kv-placement-bottleneck"
+
+# ---- Section 20: predeclared break-even thresholds (fixed, mirrors
+# tools/membrane-kv-bottleneck-analysis/bottleneck_analysis.c) ----
+BREAK_EVEN_THRESHOLDS = {
+    "schema_version": 1,
+    "predeclared_before_seeing_results": True,
+    "bands": [
+        {"range": "< 5%", "label": "NO_BOTTLENECK", "note": "negligible"},
+        {"range": "5-10%", "label": "MINOR", "note": "minor"},
+        {"range": "10-20%", "label": "MEANINGFUL", "note": "meaningful"},
+        {"range": ">= 20%", "label": "STRONG", "note": "strong bottleneck"},
+    ],
+    "bottleneck_regime_criteria": {
+        "min_slowdown_pct": 10.0,
+        "cv_below_half_of_slowdown_capped_at_15pct_absolute": True,
+        "host_batch_must_be_valid": True,
+        "must_persist_at_second_nearby_point_or_config": True,
+    },
+}
+(R / "break_even.json").write_text(json.dumps(BREAK_EVEN_THRESHOLDS, indent=2))
+
+
+def classify(slowdown_pct):
+    if slowdown_pct is None:
+        return "UNKNOWN"
+    if slowdown_pct < 5.0:
+        return "NO_BOTTLENECK"
+    if slowdown_pct < 10.0:
+        return "MINOR"
+    if slowdown_pct < 20.0:
+        return "MEANINGFUL"
+    return "STRONG"
+
+
+def cv_pct(vals):
+    if not vals or len(vals) < 2:
+        return 0.0
+    import statistics
+    mean = statistics.mean(vals)
+    if mean == 0:
+        return 0.0
+    return 100.0 * statistics.stdev(vals) / mean
+
+
+def load(name):
+    p = R / name
+    if not p.exists():
+        return None
+    return json.loads(p.read_text())
+
+
+static_135 = load("static_sweep_135m.json")
+static_360 = load("static_sweep_360m.json")
+context_scaling = load("context_scaling.json")
+larger_model = load("larger_model.json")
+model_scaling = load("model_scaling.json")
+q5_comparison = load("q5_comparison.json")
+weight_control = load("weight_compute_control.json")
+reproducibility = load("reproducibility.json")
+host_baseline = load("host_baseline.json")
+utilization = load("utilization.json")
+run_manifest = load("_run_manifest_internal.json")
+
+all_static_points = []
+if static_135:
+    all_static_points += static_135["points"]
+if static_360:
+    all_static_points += static_360["points"]
+b_points = context_scaling["points"] if context_scaling else []
+large_points = larger_model["points"] if larger_model else []
+
+# ---------------- graph_splits.json (section 12) ----------------
+graph_split_rows = []
+for p in all_static_points + b_points + large_points:
+    graph_split_rows.append({
+        "model": p["model"], "n_ctx": p["n_ctx"], "gpu_kv_pct": p["gpu_kv_pct"],
+        "graph_splits_tg": p.get("graph_splits_tg"),
+        "generation_tok_s_mean": p["generation_tok_s"].get("mean"),
+        "slowdown_pct_vs_100gpu": p.get("slowdown_pct_vs_100gpu"),
+    })
+# crude correlation check: as gpu_kv_pct decreases (more CPU KV), does
+# graph_splits_tg increase, and does tok/s move the OPPOSITE direction
+# from what a "more splits = slower" causal story would predict?
+by_model_ctx = {}
+for r in graph_split_rows:
+    key = (r["model"], r["n_ctx"])
+    by_model_ctx.setdefault(key, []).append(r)
+splits_increase_but_tok_s_also_increases = 0
+splits_increase_and_tok_s_decreases = 0
+for key, rows in by_model_ctx.items():
+    rows_sorted = sorted(rows, key=lambda r: -r["gpu_kv_pct"])  # 100 -> 0
+    for a, b in zip(rows_sorted, rows_sorted[1:]):
+        if a["graph_splits_tg"] is None or b["graph_splits_tg"] is None:
+            continue
+        if b["graph_splits_tg"] > a["graph_splits_tg"]:
+            if b["generation_tok_s_mean"] is not None and a["generation_tok_s_mean"] is not None:
+                if b["generation_tok_s_mean"] >= a["generation_tok_s_mean"]:
+                    splits_increase_but_tok_s_also_increases += 1
+                else:
+                    splits_increase_and_tok_s_decreases += 1
+graph_splits_out = {
+    "schema_version": 1,
+    "note": "Phase 12B found more CPU-resident KV increases graph split "
+            "count (section 12). This sweep confirms the split-count "
+            "mechanism (more CPU-resident layers -> more splits) but a "
+            "higher split count is NOT observed to be linked with lower "
+            "throughput at this scale -- see the two counters below. "
+            "Correlation only, no causal link asserted either way (section "
+            "12 explicitly warns against assuming one).",
+    "rows": graph_split_rows,
+    "adjacent_pairs_where_splits_increased_and_tok_s_also_increased_or_held": splits_increase_but_tok_s_also_increases,
+    "adjacent_pairs_where_splits_increased_and_tok_s_decreased": splits_increase_and_tok_s_decreases,
+}
+(R / "graph_splits.json").write_text(json.dumps(graph_splits_out, indent=2))
+
+# ---------------- transfer_activity.json (section 14, best-effort estimate) --
+transfer_rows = []
+for p in all_static_points:
+    base = next((q for q in all_static_points if q["model"] == p["model"]
+                 and q["n_ctx"] == p["n_ctx"] and q["gpu_kv_pct"] == 100), None)
+    extra_splits = (p.get("graph_splits_tg", 0) - base.get("graph_splits_tg", 0)) if base else None
+    cpu_kv_bytes = p.get("cpu_kv_bytes") or 0
+    n_cpu_layers = max(p["n_layer"] - round(p["n_layer"] * p["gpu_kv_pct"] / 100.0), 0)
+    per_layer_kv_bytes = (cpu_kv_bytes / n_cpu_layers) if n_cpu_layers > 0 else 0
+    transfer_rows.append({
+        "model": p["model"], "n_ctx": p["n_ctx"], "gpu_kv_pct": p["gpu_kv_pct"],
+        "extra_graph_splits_vs_100pct_gpu": extra_splits,
+        "cpu_resident_kv_bytes": cpu_kv_bytes,
+        "estimated_bytes_transferred_per_decode_token": (
+            extra_splits * per_layer_kv_bytes if extra_splits and per_layer_kv_bytes else 0),
+    })
+transfer_out = {
+    "schema_version": 1,
+    "label": "ESTIMATED_NOT_DIRECTLY_MEASURED",
+    "method": "estimated_bytes_transferred_per_decode_token = "
+              "(graph_splits_tg at this ratio - graph_splits_tg at 100% GPU) "
+              "* (cpu_resident_kv_bytes / n_cpu_resident_layers). This is a "
+              "structural estimate from the real, measured graph-split count "
+              "(section 12) and the real, measured per-layer KV byte size -- "
+              "NOT a direct ggml_backend_sched byte-transfer instrumentation "
+              "(no such counter was added; doing so would need a llama.cpp "
+              "source change, out of scope for a llama-free-first phase). "
+              "Do not treat these numbers as measured PCIe traffic.",
+    "rows": transfer_rows,
+    "unresolved": "Whether any observed slowdown (if any) is actually "
+                  "PCIe-bandwidth-bound, PCIe-latency-bound, host-memory-"
+                  "bandwidth-bound, or graph-split/sync-overhead-bound was "
+                  "NOT isolated by direct profiling in this phase (section "
+                  "19) -- see summary.json limitations.",
+}
+(R / "transfer_activity.json").write_text(json.dumps(transfer_out, indent=2))
+
+# ---------------- bottleneck_map.json (section 25) ----------------
+bottleneck_map_rows = []
+for p in all_static_points + large_points:
+    sd = p.get("slowdown_pct_vs_100gpu")
+    bottleneck_map_rows.append({
+        "model": p["model"], "n_ctx": p["n_ctx"], "kv_precision": "Q8_0",
+        "gpu_kv_pct": p["gpu_kv_pct"], "vram_used_mib": p.get("vram_used_mib"),
+        "generation_tok_s_mean": p["generation_tok_s"].get("mean"),
+        "relative_slowdown_pct": sd,
+        "classification": classify(sd) if sd is not None else "NO_BASELINE",
+    })
+if q5_comparison:
+    for p in q5_comparison["points"]:
+        sd = p.get("q5_vs_q8_delta_pct")
+        bottleneck_map_rows.append({
+            "model": p["model"], "n_ctx": p["n_ctx"], "kv_precision": "Q5_1",
+            "gpu_kv_pct": p["gpu_kv_pct"], "vram_used_mib": p.get("vram_used_mib"),
+            "generation_tok_s_mean": p["generation_tok_s"].get("mean"),
+            "relative_slowdown_pct_vs_q8_same_point": sd,
+            "classification": "SEE_q5_comparison_json_not_gpu_vs_cpu",
+        })
+(R / "bottleneck_map.json").write_text(json.dumps(
+    {"schema_version": 1, "rows": bottleneck_map_rows}, indent=2))
+
+# ---------------- pareto.json (section 24) ----------------
+def pareto_indices(vram, tok):
+    n = len(vram)
+    is_pareto = [True] * n
+    for i in range(n):
+        for j in range(n):
+            if i == j:
+                continue
+            vram_le = vram[j] <= vram[i]
+            tok_ge = tok[j] >= tok[i]
+            strictly_better = (vram[j] < vram[i]) or (tok[j] > tok[i])
+            if vram_le and tok_ge and strictly_better:
+                is_pareto[i] = False
+                break
+    return is_pareto
+
+
+pareto_groups = {}
+for p in all_static_points + large_points:
+    key = f"{p['model']}_ctx{p['n_ctx']}"
+    pareto_groups.setdefault(key, []).append(p)
+pareto_out_groups = []
+for key, pts in pareto_groups.items():
+    vram = [p.get("vram_used_mib") or 0 for p in pts]
+    tok = [p["generation_tok_s"].get("mean") or 0 for p in pts]
+    flags = pareto_indices(vram, tok)
+    rows = []
+    for p, v, t, f in zip(pts, vram, tok, flags):
+        rows.append({"gpu_kv_pct": p["gpu_kv_pct"], "vram_used_mib": v,
+                      "generation_tok_s_mean": t, "is_pareto_optimal": f})
+    pareto_out_groups.append({"group": key, "points": rows})
+(R / "pareto.json").write_text(json.dumps(
+    {"schema_version": 1,
+     "note": "Pareto-optimal = no other tested point in the same "
+             "model/context group has both <= VRAM and >= tok/s with at "
+             "least one strict improvement. Dominated points are marked "
+             "is_pareto_optimal=false, never presented as optimal (section 24).",
+     "groups": pareto_out_groups}, indent=2))
+
+# ---------------- bottleneck regime determination (section 21) + dynamic_reentry (22)
+def regime_confirmed(primary_sd, primary_cv, primary_host_valid, secondary_sd, secondary_present):
+    if primary_sd is None or primary_sd < 10.0:
+        return False
+    if not primary_host_valid:
+        return False
+    cap = min(primary_sd * 0.5, 15.0)
+    if primary_cv >= cap:
+        return False
+    if not secondary_present or secondary_sd is None or secondary_sd < 10.0:
+        return False
+    return True
+
+
+strongest = max(bottleneck_map_rows, key=lambda r: (r["relative_slowdown_pct"] or -999)
+                 if isinstance(r.get("relative_slowdown_pct"), (int, float)) else -999)
+# find CV for the strongest point from context_scaling/static sweep raw stats
+strongest_point = None
+for p in all_static_points + large_points:
+    if (p["model"] == strongest["model"] and p["n_ctx"] == strongest["n_ctx"]
+            and p["gpu_kv_pct"] == strongest["gpu_kv_pct"]):
+        strongest_point = p
+        break
+primary_cv = strongest_point["generation_tok_s"].get("cv_pct", 0.0) if strongest_point else 0.0
+primary_host_valid = all(b["valid"] for b in (host_baseline["batches"] if host_baseline else [])
+                          if b.get("model") == strongest["model"])
+# secondary: any OTHER (model, ctx) row with slowdown >= 10%
+secondary_candidates = [r for r in bottleneck_map_rows
+                         if r is not strongest and isinstance(r.get("relative_slowdown_pct"), (int, float))
+                         and r["relative_slowdown_pct"] >= 10.0
+                         and (r["model"], r["n_ctx"]) != (strongest["model"], strongest["n_ctx"])]
+secondary_present = len(secondary_candidates) > 0
+secondary_sd = max((r["relative_slowdown_pct"] for r in secondary_candidates), default=None)
+
+confirmed = regime_confirmed(
+    strongest.get("relative_slowdown_pct"), primary_cv, primary_host_valid,
+    secondary_sd, secondary_present)
+
+if confirmed:
+    dynamic_reentry = {
+        "schema_version": 1, "executed": True,
+        "point": {"model": strongest["model"], "n_ctx": strongest["n_ctx"],
+                  "gpu_kv_pct": strongest["gpu_kv_pct"]},
+        "note": "Bottleneck regime confirmed -- dynamic scheduler re-entry "
+                "would run here (A: all-GPU, B: static split, C: Phase 12F "
+                "deterministic scheduler) using the EXISTING scheduler_core "
+                "policy only, no redesign. Not executed automatically by "
+                "this build step; run tiering_probe.cpp hotset/schedule_demo "
+                "modes manually against this exact point if pursuing this.",
+    }
+else:
+    dynamic_reentry = {
+        "schema_version": 1, "executed": False,
+        "reason": "No reproducible >=10% KV-placement-bottleneck regime was "
+                  "confirmed under section 21's criteria (strongest observed "
+                  f"slowdown={strongest.get('relative_slowdown_pct')!r}% at "
+                  f"{strongest['model']} ctx={strongest['n_ctx']} "
+                  f"gpu_kv_pct={strongest['gpu_kv_pct']}, "
+                  f"cv_pct={primary_cv!r}, host_valid={primary_host_valid}, "
+                  f"secondary_present={secondary_present}). Section 22 says "
+                  "dynamic re-entry runs ONLY if a valid bottleneck regime "
+                  "is found. Section 29: this is a valid result, not "
+                  "manufactured or hidden.",
+    }
+(R / "dynamic_reentry.json").write_text(json.dumps(dynamic_reentry, indent=2))
+
+# ---------------- manifest.json ----------------
+artifact_files = sorted(p.name for p in R.glob("*.json") if p.name != "manifest.json")
+raw_files = sorted(p.name for p in R.glob("*.jsonl"))
+manifest = {
+    "schema_version": 1, "phase": "12G",
+    "title": "KV Placement Bottleneck Regime Discovery",
+    "artifacts": artifact_files,
+    "raw_evidence_files": raw_files,
+    "no_llama_cpp_source_changes": True,
+    "note": "Section 5/34: no llama.cpp source files were modified by this "
+            "phase -- only tools/membrane-kv-tiering-scheduler/tiering_probe.cpp "
+            "(a new 'bottleneck' mode) and a new pure llama-free helper "
+            "module (tools/membrane-kv-bottleneck-analysis/) were added.",
+}
+(R / "manifest.json").write_text(json.dumps(manifest, indent=2))
+
+# ---------------- summary.json ----------------
+if confirmed:
+    gate = "KV_PLACEMENT_BOTTLENECK_CONFIRMED"
+else:
+    # model-dependent check: any single (model, ctx) with slowdown >= 10%
+    # even without a persisting secondary?
+    any_meaningful = any(isinstance(r.get("relative_slowdown_pct"), (int, float))
+                          and r["relative_slowdown_pct"] >= 10.0 for r in bottleneck_map_rows)
+    gate = "KV_PLACEMENT_BOTTLENECK_MODEL_DEPENDENT" if any_meaningful else "KV_PLACEMENT_CAPACITY_ONLY_ON_TESTED_REGIME"
+
+next_step = {
+    "KV_PLACEMENT_BOTTLENECK_CONFIRMED": "Use the measured bottleneck regime to design adaptive hot/cold tiering.",
+    "KV_PLACEMENT_CAPACITY_ONLY_ON_TESTED_REGIME": "Stop performance-driven dynamic policy work and focus on capacity/residency productization.",
+    "KV_PLACEMENT_BOTTLENECK_MODEL_DEPENDENT": "Define model/context-aware activation rules for where dynamic tiering is worth it.",
+    "KV_PLACEMENT_BOTTLENECK_BACKEND_LIMITED": "Investigate whether a different backend (non-Vulkan) removes the bottleneck before pursuing scheduler work.",
+    "KV_PLACEMENT_BOTTLENECK_INCONCLUSIVE": "Repeat on cleaner/larger hardware.",
+}[gate]
+
+summary = {
+    "schema_version": 1, "phase": "12G",
+    "title": "KV Placement Bottleneck Regime Discovery",
+    "decision_gate": gate,
+    "decision_gate_allowed_values": [
+        "KV_PLACEMENT_BOTTLENECK_CONFIRMED",
+        "KV_PLACEMENT_CAPACITY_ONLY_ON_TESTED_REGIME",
+        "KV_PLACEMENT_BOTTLENECK_MODEL_DEPENDENT",
+        "KV_PLACEMENT_BOTTLENECK_BACKEND_LIMITED",
+        "KV_PLACEMENT_BOTTLENECK_INCONCLUSIVE",
+    ],
+    "strongest_slowdown_observed": strongest,
+    "bottleneck_regime_confirmed": confirmed,
+    "next_step_recommendation": next_step,
+    "run_manifest": run_manifest,
+}
+(R / "summary.json").write_text(json.dumps(summary, indent=2))
+print(json.dumps({"decision_gate": gate, "strongest": strongest}, indent=2))
