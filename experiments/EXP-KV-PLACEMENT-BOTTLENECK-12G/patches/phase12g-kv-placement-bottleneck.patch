+#!/usr/bin/env python3
+"""Phase 12G section 13: CPU/GPU utilization sampling at representative
+points (all-GPU-KV, 50/50, all-CPU-KV), not on every sweep run. Launches
+the probe as a subprocess with a longer decode run, polls nvidia-smi
+concurrently for GPU utilization, and reads CPU time from
+resource.getrusage(RUSAGE_CHILDREN) after the child exits (a /proc/<pid>/stat
+read after exit returns nothing -- the pid is already gone by then).
+Research-only, writes results/phase12/kv-placement-bottleneck/utilization.json."""
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+BIN = ROOT / "build-vulkan" / "tools" / "membrane-kv-tiering-scheduler" / "membrane-kv-tiering-scheduler-probe"
+MODELS_DIR = ROOT / "models"
+R = ROOT / "results" / "phase12" / "kv-placement-bottleneck"
+
+MODELS = {
+    "135M": {"path": str(MODELS_DIR / "SmolLM2-135M-Instruct-f16.gguf"), "n_layer": 30},
+    "360M": {"path": str(MODELS_DIR / "SmolLM2-360M-Instruct-f16.gguf"), "n_layer": 32},
+}
+
+
+def split_for_ratio(n_layer, gpu_pct):
+    return n_layer - round(n_layer * gpu_pct / 100.0)
+
+
+def gpu_util_sample():
+    try:
+        out = subprocess.run(
+            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used",
+             "--format=csv,noheader,nounits"],
+            capture_output=True, text=True, timeout=5).stdout.strip()
+        u, m = out.split(",")
+        return int(u), int(m)
+    except Exception:
+        return None, None
+
+
+def sample_run(model_key, n_ctx, gpu_pct, n_decodes=400):
+    import resource
+
+    m = MODELS[model_key]
+    split = split_for_ratio(m["n_layer"], gpu_pct)
+    args = [str(BIN), "bottleneck", m["path"], str(n_ctx), "q8", str(split),
+            str(n_decodes), "-1"]
+    p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                          text=True)
+    samples_gpu_util = []
+    samples_vram = []
+    rusage_before = resource.getrusage(resource.RUSAGE_CHILDREN)
+    t_start = time.time()
+    while p.poll() is None:
+        u, vram = gpu_util_sample()
+        if u is not None:
+            samples_gpu_util.append(u)
+            samples_vram.append(vram)
+        time.sleep(0.15)
+    t_end = time.time()
+    stdout, _ = p.communicate()
+    # RUSAGE_CHILDREN accumulates over ALL terminated children of this
+    # process, not just this one -- since phase12g_utilization_sample.py
+    # runs its probe children strictly sequentially (one sample_run() call
+    # fully completes, including this p.communicate(), before the next
+    # Popen), the delta across this single call is exactly this child's
+    # CPU time, with no cross-run contamination.
+    rusage_after = resource.getrusage(resource.RUSAGE_CHILDREN)
+    cpu_seconds_used = ((rusage_after.ru_utime + rusage_after.ru_stime)
+                         - (rusage_before.ru_utime + rusage_before.ru_stime))
+    rec = None
+    for line in stdout.splitlines():
+        if line.strip().startswith("{"):
+            try:
+                rec = json.loads(line.strip())
+            except json.JSONDecodeError:
+                pass
+    wall_s = t_end - t_start
+    cpu_pct = 100.0 * cpu_seconds_used / wall_s if wall_s > 0 else None
+    return {
+        "model": model_key, "n_ctx": n_ctx, "gpu_kv_pct": gpu_pct, "split": split,
+        "n_decodes": n_decodes, "wall_s": wall_s,
+        "gpu_util_pct_samples_n": len(samples_gpu_util),
+        "gpu_util_pct_mean": (sum(samples_gpu_util) / len(samples_gpu_util)
+                               if samples_gpu_util else None),
+        "gpu_util_pct_max": max(samples_gpu_util) if samples_gpu_util else None,
+        "vram_mib_mean": (sum(samples_vram) / len(samples_vram)
+                           if samples_vram else None),
+        "cpu_pct_of_one_core": cpu_pct,
+        "probe_result": rec,
+    }
+
+
+def main():
+    points = []
+    for model_key, n_ctx in [("135M", 65536), ("360M", 65536)]:
+        for gpu_pct in [100, 50, 0]:
+            print(f"sampling {model_key} ctx={n_ctx} gpu%={gpu_pct}", file=sys.stderr)
+            points.append(sample_run(model_key, n_ctx, gpu_pct))
+    out = {
+        "schema_version": 1,
+        "note": "Section 13: representative-point utilization sampling only "
+                "(all-GPU-KV, 50/50, all-CPU-KV), not run for every sweep "
+                "point. cpu_pct_of_one_core is the probe process's own "
+                "utime+stime over wall time (100 = one core saturated), read "
+                "via resource.getrusage(RUSAGE_CHILDREN) after the child "
+                "exits (a live /proc/<pid>/stat poll cannot observe the "
+                "final CPU time once the process has already exited); "
+                "gpu_util_pct_* comes from polling nvidia-smi at ~150ms "
+                "intervals during the run (coarse sampling, not a profiler "
+                "-- short/fast runs may have too few samples for a reliable "
+                "mean, flagged via gpu_util_pct_samples_n).",
+        "points": points,
+    }
+    (R / "utilization.json").write_text(json.dumps(out, indent=2))
+    print(json.dumps(out, indent=2))
+
+
+if __name__ == "__main__":
+    main()
