+/* ---------- mode: bottleneck (Phase 12G, sections 2/3/10/11/12/18) ---------
+ * Static GPU/CPU KV split, weight placement controlled independently via
+ * n_gpu_layers (default -1 = fully GPU, matching every other mode in this
+ * file; only the weight-compute control run in Phase 12G overrides it).
+ * Captures per-token decode latency (for percentile reporting) and the
+ * real ggml_backend_sched graph-split count via llama_log_set -- reading
+ * the EXISTING "graph splits = %d" INFO line llama-context.cpp already
+ * emits at context-init reserve time, no llama.cpp source change needed. */
+
+struct split_log_capture_t
+{
+	int	n_splits_pp = -1;
+	int	n_splits_tg = -1;
+};
+
+static void	capture_log_cb(enum ggml_log_level level, const char *text,
+				void *ud)
+{
+	(void)level;
+	split_log_capture_t	*c = static_cast<split_log_capture_t *>(ud);
+	int	a, b, c2;
+
+	if (sscanf(text, "%*[^:]: graph splits = %d (with bs=%d), %d (with bs=1)",
+			&a, &b, &c2) == 3)
+	{
+		c->n_splits_pp = a;
+		c->n_splits_tg = c2;
+	}
+	else if (sscanf(text, "%*[^:]: graph splits = %d", &a) == 1)
+	{
+		c->n_splits_pp = a;
+		c->n_splits_tg = a;
+	}
+}
+
+static bool	load_ctx_ex(const char *model_path, int32_t n_ctx,
+				const char *kv_type_str, int32_t split, int32_t n_gpu_layers,
+				loaded_t *out)
+{
+	llama_model_params	mp = llama_model_default_params();
+
+	mp.n_gpu_layers = n_gpu_layers;
+	out->model = llama_model_load_from_file(model_path, mp);
+	if (out->model == nullptr)
+		return (false);
+	out->n_layer = llama_model_n_layer(out->model);
+	out->vocab = llama_model_get_vocab(out->model);
+	out->cap.n_layer = out->n_layer;
+	out->cap.k_leaf.assign(out->n_layer, nullptr);
+	out->cap.v_leaf.assign(out->n_layer, nullptr);
+
+	static split_ctx_t	split_ctx;
+	split_ctx.split = split;
+
+	ggml_type	kvt = strcmp(kv_type_str, "q8") == 0 ? GGML_TYPE_Q8_0
+		: strcmp(kv_type_str, "q5") == 0 ? GGML_TYPE_Q5_1 : GGML_TYPE_F16;
+
+	llama_context_params	cp = llama_context_default_params();
+	cp.n_ctx = n_ctx;
+	cp.type_k = kvt;
+	cp.type_v = kvt;
+	cp.cb_eval = capture_cb;
+	cp.cb_eval_user_data = &out->cap;
+	if (split >= 0)
+	{
+		cp.kv_dev_override = split_kv_dev_override;
+		cp.kv_dev_override_ud = &split_ctx;
+	}
+	out->ctx = llama_init_from_model(out->model, cp);
+	if (out->ctx == nullptr)
+		return (false);
+	out->mem = llama_get_memory(out->ctx);
+	return (true);
+}
+
+static double	percentile(std::vector<double> sorted_vals, double pct)
+{
+	if (sorted_vals.empty())
+		return (0.0);
+	double	idx = pct / 100.0 * (double)(sorted_vals.size() - 1);
+	size_t	lo = (size_t)idx;
+	size_t	hi = lo + 1 < sorted_vals.size() ? lo + 1 : lo;
+	double	frac = idx - (double)lo;
+
+	return (sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * frac);
+}
+
+static int	cmd_bottleneck(const char *model, int32_t n_ctx, const char *kvt,
+				int32_t split, int n_decodes, int32_t n_gpu_layers)
+{
+	split_log_capture_t	log_cap;
+	ggml_log_callback		prev_cb = nullptr;
+	void					*prev_ud = nullptr;
+
+	llama_log_get(&prev_cb, &prev_ud);
+	llama_log_set(capture_log_cb, &log_cap);
+
+	loaded_t	l{};
+	bool		loaded = load_ctx_ex(model, n_ctx, kvt, split, n_gpu_layers, &l);
+
+	llama_log_set(prev_cb, prev_ud);
+
+	if (!loaded)
+	{
+		fprintf(stderr, "{\"error\":\"load_failed\"}\n");
+		return (3);
+	}
+
+	long	vram_baseline = nvidia_smi_used_mib();
+	double	t0 = now_ms();
+	if (!decode_prompt(&l, "The quick brown fox jumps over the lazy dog "
+			"and then returns to its den before the sun sets over the "
+			"quiet hills of the valley"))
+	{
+		fprintf(stderr, "{\"error\":\"prompt_decode_failed\"}\n");
+		free_loaded(&l);
+		return (13);
+	}
+	double	t1 = now_ms();
+
+	uint64_t	gpu_kv_bytes = 0, cpu_kv_bytes = 0;
+	for (int32_t i = 0; i < l.n_layer; i++)
+	{
+		uint64_t	b = layer_kv_bytes(&l, i);
+		if (layer_is_cpu_now(&l, i))
+			cpu_kv_bytes += b;
+		else
+			gpu_kv_bytes += b;
+	}
+
+	std::vector<llama_token>	gen;
+	std::vector<double>		latencies_ms;
+	latencies_ms.reserve(n_decodes);
+	double	t2 = now_ms();
+	for (int i = 0; i < n_decodes; i++)
+	{
+		llama_token	tok;
+		double	d0 = now_ms();
+		if (!decode_one_greedy(&l, &tok))
+		{
+			fprintf(stderr, "{\"error\":\"decode_failed\"}\n");
+			free_loaded(&l);
+			return (13);
+		}
+		double	d1 = now_ms();
+		latencies_ms.push_back(d1 - d0);
+		gen.push_back(tok);
+	}
+	double	t3 = now_ms();
+
+	std::vector<double>	sorted_lat = latencies_ms;
+	std::sort(sorted_lat.begin(), sorted_lat.end());
+	double	p50 = percentile(sorted_lat, 50.0);
+	double	p90 = percentile(sorted_lat, 90.0);
+	double	p95 = percentile(sorted_lat, 95.0);
+	double	p99 = percentile(sorted_lat, 99.0);
+
+	long	vram_final = nvidia_smi_used_mib();
+
+	printf("{\"schema_version\":1,\"mode\":\"bottleneck\",\"n_ctx\":%d,"
+		"\"kv_type\":\"%s\",\"split\":%d,\"n_gpu_layers_weights\":%d,"
+		"\"n_gpu_kv_layers\":%d,\"n_cpu_kv_layers\":%d,"
+		"\"gpu_kv_bytes\":%llu,\"cpu_kv_bytes\":%llu,"
+		"\"prompt_ms\":%.3f,\"n_decodes\":%d,\"decode_total_ms\":%.3f,"
+		"\"generation_tok_s\":%.4f,"
+		"\"p50_ms\":%.4f,\"p90_ms\":%.4f,\"p95_ms\":%.4f,\"p99_ms\":%.4f,"
+		"\"min_ms\":%.4f,\"max_ms\":%.4f,"
+		"\"vram_baseline_mib\":%ld,\"vram_used_mib\":%ld,\"rss_kb\":%llu,"
+		"\"graph_splits_pp\":%d,\"graph_splits_tg\":%d}\n",
+		n_ctx, kv_type_name(kvt), split, n_gpu_layers,
+		l.n_layer - split, split,
+		(unsigned long long)gpu_kv_bytes, (unsigned long long)cpu_kv_bytes,
+		t1 - t0, n_decodes, t3 - t2,
+		(double)n_decodes / ((t3 - t2) / 1000.0),
+		p50, p90, p95, p99,
+		sorted_lat.empty() ? 0.0 : sorted_lat.front(),
+		sorted_lat.empty() ? 0.0 : sorted_lat.back(),
+		vram_baseline, vram_final, (unsigned long long)read_rss_kb(),
+		log_cap.n_splits_pp, log_cap.n_splits_tg);
+	free_loaded(&l);
+	return (0);
+}
