+#!/usr/bin/env python3
+"""Phase 12G: KV placement bottleneck regime discovery.
+
+Runs the real-hardware static-KV-split sweep via the llama-enabled
+membrane-kv-tiering-scheduler-probe "bottleneck" mode (weights always
+placed independently of KV -- see tools/membrane-kv-tiering-scheduler/
+tiering_probe.cpp cmd_bottleneck / load_ctx_ex) and writes raw JSONL +
+processed results/phase12/kv-placement-bottleneck/*.json artifacts.
+Research-only, experiment/kv-placement-bottleneck-discovery branch
+only; not part of the product; no product CLI touched.
+"""
+import json
+import statistics
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+BIN = ROOT / "build-vulkan" / "tools" / "membrane-kv-tiering-scheduler" / "membrane-kv-tiering-scheduler-probe"
+MODELS_DIR = ROOT / "models"
+R = ROOT / "results" / "phase12" / "kv-placement-bottleneck"
+R.mkdir(parents=True, exist_ok=True)
+
+MODELS = {
+    "135M": {"path": str(MODELS_DIR / "SmolLM2-135M-Instruct-f16.gguf"), "n_layer": 30},
+    "360M": {"path": str(MODELS_DIR / "SmolLM2-360M-Instruct-f16.gguf"), "n_layer": 32},
+    "1.5B": {"path": str(MODELS_DIR / "qwen2.5-1.5b-instruct-fp16.gguf"), "n_layer": 28},
+}
+
+# Section 20: predeclared, not moved after seeing results.
+BREAK_EVEN_THRESHOLDS = [
+    {"max_pct": 5.0, "label": "NO_BOTTLENECK", "note": "negligible"},
+    {"max_pct": 10.0, "label": "MINOR", "note": "minor"},
+    {"max_pct": 20.0, "label": "MEANINGFUL", "note": "meaningful"},
+    {"max_pct": None, "label": "STRONG", "note": "strong bottleneck"},
+]
+
+# Section 9: host-noise validity rule, predeclared.
+HOST_NOISE_RULE = {
+    "reject_if_mem_available_drop_pct_gt": 40.0,
+    "reject_if_swap_used_increase_mib_gt": 300.0,
+    "reject_if_load1_gt": 10.0,
+    "reject_if_mem_available_below_mib": 300.0,
+    "note": "Any one condition true over a batch (one model/context's full "
+            "ratio sweep, host snapshot taken immediately before and after) "
+            "marks every run in that batch host_noise_flagged=true. Flagged "
+            "runs are still recorded (section 9: do not hide noisy runs) but "
+            "excluded from bottleneck-regime claims (section 21).",
+}
+
+
+def host_snapshot():
+    mem = {}
+    with open("/proc/meminfo") as f:
+        for line in f:
+            k, v = line.split(":", 1)
+            parts = v.strip().split()
+            if parts:
+                mem[k] = int(parts[0])
+    load1, load5, load15 = open("/proc/loadavg").read().split()[:3]
+    try:
+        gpu = subprocess.run(
+            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total",
+             "--format=csv,noheader,nounits"],
+            capture_output=True, text=True, timeout=10).stdout.strip()
+        gpu_util, gpu_used, gpu_total = [int(x) for x in gpu.split(",")]
+    except Exception:
+        gpu_util, gpu_used, gpu_total = -1, -1, -1
+    return {
+        "mem_total_kb": mem.get("MemTotal", 0),
+        "mem_available_kb": mem.get("MemAvailable", 0),
+        "swap_total_kb": mem.get("SwapTotal", 0),
+        "swap_free_kb": mem.get("SwapFree", 0),
+        "swap_used_kb": mem.get("SwapTotal", 0) - mem.get("SwapFree", 0),
+        "load1": float(load1), "load5": float(load5), "load15": float(load15),
+        "gpu_util_pct": gpu_util, "gpu_mem_used_mib": gpu_used,
+        "gpu_mem_total_mib": gpu_total,
+        "ts": time.time(),
+    }
+
+
+def batch_valid(before, after):
+    reasons = []
+    if before["mem_available_kb"] > 0:
+        drop_pct = 100.0 * (before["mem_available_kb"] - after["mem_available_kb"]) / before["mem_available_kb"]
+        if drop_pct > HOST_NOISE_RULE["reject_if_mem_available_drop_pct_gt"]:
+            reasons.append(f"mem_available_drop_pct={drop_pct:.1f}")
+    swap_inc_mib = (after["swap_used_kb"] - before["swap_used_kb"]) / 1024.0
+    if swap_inc_mib > HOST_NOISE_RULE["reject_if_swap_used_increase_mib_gt"]:
+        reasons.append(f"swap_used_increase_mib={swap_inc_mib:.1f}")
+    if after["load1"] > HOST_NOISE_RULE["reject_if_load1_gt"]:
+        reasons.append(f"load1={after['load1']:.2f}")
+    if after["mem_available_kb"] / 1024.0 < HOST_NOISE_RULE["reject_if_mem_available_below_mib"]:
+        reasons.append(f"mem_available_mib={after['mem_available_kb']/1024.0:.1f}")
+    return (len(reasons) == 0, reasons)
+
+
+def run_probe(model_path, n_ctx, kv_type, split, n_decodes, n_gpu_layers=-1, timeout=180):
+    args = [str(BIN), "bottleneck", model_path, str(n_ctx), kv_type, str(split),
+            str(n_decodes), str(n_gpu_layers)]
+    try:
+        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return {"error": "timeout"}
+    for line in p.stdout.splitlines():
+        line = line.strip()
+        if line.startswith("{"):
+            try:
+                d = json.loads(line)
+                d["_returncode"] = p.returncode
+                return d
+            except json.JSONDecodeError:
+                pass
+    return {"error": "no_json_output", "returncode": p.returncode,
+            "stderr_tail": p.stderr[-800:]}
+
+
+def split_for_ratio(n_layer, gpu_pct):
+    n_gpu = round(n_layer * gpu_pct / 100.0)
+    return n_layer - n_gpu
+
+
+def stats(vals):
+    if not vals:
+        return {"n": 0}
+    mean = statistics.mean(vals)
+    return {
+        "n": len(vals),
+        "mean": mean,
+        "median": statistics.median(vals),
+        "min": min(vals),
+        "max": max(vals),
+        "stddev": statistics.stdev(vals) if len(vals) > 1 else 0.0,
+        "cv_pct": (statistics.stdev(vals) / mean * 100.0) if len(vals) > 1 and mean != 0 else 0.0,
+    }
+
+
+def jsonl_append(path, record):
+    with open(path, "a") as f:
+        f.write(json.dumps(record) + "\n")
+
+
+def run_point(model_key, n_ctx, kv_type, gpu_pct, n_repeats, n_decodes=32,
+              n_gpu_layers=-1, raw_path=None, label="", weight_control=False):
+    m = MODELS[model_key]
+    split = split_for_ratio(m["n_layer"], gpu_pct)
+    runs = []
+    for rep in range(n_repeats):
+        rec = run_probe(m["path"], n_ctx, kv_type, split, n_decodes, n_gpu_layers)
+        rec["_model"] = model_key
+        rec["_gpu_kv_pct"] = gpu_pct
+        rec["_split"] = split
+        rec["_repeat"] = rep
+        rec["_label"] = label
+        rec["_weight_control"] = weight_control
+        if raw_path:
+            jsonl_append(raw_path, rec)
+        runs.append(rec)
+    ok_runs = [r for r in runs if "generation_tok_s" in r]
+    tok_s_vals = [r["generation_tok_s"] for r in ok_runs]
+    p95_vals = [r["p95_ms"] for r in ok_runs]
+    return {
+        "model": model_key, "n_ctx": n_ctx, "kv_type": kv_type,
+        "gpu_kv_pct": gpu_pct, "split": split,
+        "n_layer": m["n_layer"], "n_gpu_layers_weights": n_gpu_layers,
+        "n_repeats_requested": n_repeats, "n_repeats_ok": len(ok_runs),
+        "generation_tok_s": stats(tok_s_vals),
+        "p95_ms": stats(p95_vals),
+        "vram_used_mib": ok_runs[-1]["vram_used_mib"] if ok_runs else None,
+        "graph_splits_tg": ok_runs[-1]["graph_splits_tg"] if ok_runs else None,
+        "gpu_kv_bytes": ok_runs[-1]["gpu_kv_bytes"] if ok_runs else None,
+        "cpu_kv_bytes": ok_runs[-1]["cpu_kv_bytes"] if ok_runs else None,
+    }
+
+
+def main():
+    manifest = {"schema_version": 1, "phase": "12G", "sections": {}}
+    t_start = time.time()
+
+    # ---------------- Phase A: broad discovery, Q8_0, 3 repeats ----------------
+    print("=== Phase A: discovery sweep ===", file=sys.stderr)
+    raw_a = R / "raw_phase_a.jsonl"
+    if raw_a.exists():
+        raw_a.unlink()
+    contexts = {
+        "135M": [2048, 8192, 16384, 32768, 65536],
+        "360M": [2048, 8192, 16384, 32768, 65536],
+    }
+    ratios = [100, 75, 50, 25, 0]
+    phase_a_points = []
+    host_baselines = []
+    for model_key, ctx_list in contexts.items():
+        for n_ctx in ctx_list:
+            before = host_snapshot()
+            for gpu_pct in ratios:
+                pt = run_point(model_key, n_ctx, "q8", gpu_pct, n_repeats=3,
+                                n_decodes=32, raw_path=raw_a, label="phase_a")
+                phase_a_points.append(pt)
+                print(f"  A {model_key} ctx={n_ctx} gpu%={gpu_pct} "
+                      f"tok/s(mean)={pt['generation_tok_s'].get('mean')}",
+                      file=sys.stderr)
+            after = host_snapshot()
+            valid, reasons = batch_valid(before, after)
+            host_baselines.append({
+                "phase": "A", "model": model_key, "n_ctx": n_ctx,
+                "before": before, "after": after,
+                "valid": valid, "invalid_reasons": reasons,
+            })
+    manifest["sections"]["phase_a_n_points"] = len(phase_a_points)
+
+    # Compute relative slowdown vs 100% GPU baseline per (model, ctx)
+    for pt in phase_a_points:
+        base = next(p for p in phase_a_points
+                    if p["model"] == pt["model"] and p["n_ctx"] == pt["n_ctx"]
+                    and p["gpu_kv_pct"] == 100)
