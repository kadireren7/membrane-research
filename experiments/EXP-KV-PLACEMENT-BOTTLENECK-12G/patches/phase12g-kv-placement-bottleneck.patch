+        this_mean = pt["generation_tok_s"].get("mean")
+        pt["q5_vs_q8_delta_pct"] = (100.0 * (this_mean - b) / b) if b and this_mean is not None else None
+    (R / "q5_comparison.json").write_text(json.dumps(
+        {"schema_version": 1, "worst_q8_point": {
+            "model": worst["model"], "n_ctx": worst["n_ctx"],
+            "gpu_kv_pct": worst["gpu_kv_pct"],
