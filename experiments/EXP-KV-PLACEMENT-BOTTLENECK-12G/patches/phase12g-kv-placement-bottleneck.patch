+def _c131():
+	wc = _load_v12g("weight_compute_control.json")
+	raw = _load_v12g("raw_weight_control.jsonl")
+	bad = []
+	if wc.get("label") != "CONTROL_ONLY_not_part_of_primary_sweep":
+		bad.append(f"label={wc.get('label')!r}, expected the explicit control-only label")
+	full_rows = [r["_gpu_kv_pct"] for r in raw if r.get("_label") == "control_full_gpu_weights"]
+	partial_rows = [r["_gpu_kv_pct"] for r in raw if r.get("_label") == "control_partial_gpu_weights"]
+	if not full_rows or any(p != 100 for p in full_rows):
+		bad.append(f"control_full_gpu_weights rows are not all gpu_kv_pct=100: {full_rows}")
+	if not partial_rows or any(p != 100 for p in partial_rows):
+		bad.append(f"control_partial_gpu_weights rows are not all gpu_kv_pct=100: {partial_rows}")
+	full_mean = wc.get("full_gpu_weights", {}).get("generation_tok_s", {}).get("mean")
+	partial_mean = wc.get("partial_gpu_weights", {}).get("generation_tok_s", {}).get("mean")
+	if full_mean and partial_mean:
+		recomputed = 100.0 * (full_mean - partial_mean) / full_mean
+		claimed = wc.get("weight_offload_slowdown_pct")
+		if claimed is None or abs(recomputed - claimed) > 1e-6:
+			bad.append(f"weight_offload_slowdown_pct claimed={claimed}, recomputed={recomputed}")
+	return len(bad) == 0, "; ".join(bad) if bad else "control-only label present, KV fixed at 100%% GPU in both rows, slowdown reproduced exactly"
+
+
+@check("Phase 12G: reproducibility.json's fresh_batch_slowdown_pct is "
+	"recomputed exactly from raw_reproducibility.jsonl's worst-point and "
+	"control-point generation_tok_s means, and similar_relative_result is "
+	"only true when the fresh figure is actually close to the original "
+	"(section 28: a disappearing result must be classified inconclusive, "
