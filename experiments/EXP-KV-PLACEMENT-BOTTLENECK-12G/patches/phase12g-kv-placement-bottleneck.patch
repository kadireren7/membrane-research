+def _v12g_classify(slowdown_pct):
+	if slowdown_pct is None:
+		return "UNKNOWN"
+	if slowdown_pct < 5.0:
+		return "NO_BOTTLENECK"
+	if slowdown_pct < 10.0:
+		return "MINOR"
+	if slowdown_pct < 20.0:
+		return "MEANINGFUL"
+	return "STRONG"
+
