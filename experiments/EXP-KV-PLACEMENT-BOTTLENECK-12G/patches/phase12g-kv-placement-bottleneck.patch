+        key=lambda p: -(p["slowdown_pct_vs_100gpu"] if p["slowdown_pct_vs_100gpu"] is not None else 0))
+    manifest["sections"]["phase_a_candidates"] = [
+        {"model": c["model"], "n_ctx": c["n_ctx"], "gpu_kv_pct": c["gpu_kv_pct"],
