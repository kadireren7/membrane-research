+#!/usr/bin/env python3
+"""
+Phase 11D Section 5: calibration-set-size analysis. Pure reanalysis of
+Phase 11C's existing raw ablation data (results/phase11/generalization/
+rankings.json) against the PRE-REGISTERED calibration subsets written by
+build_calibration_sizes.py (must be run first, unmodified since).
+
+For each model and each calibration size, builds a rel_l2_delta_mean
+ranking from exactly that subset of prompts (same method as
+build_model_profile.py) and reports, against the size-31 (data-ceiling)
+ranking and against the size-21 (operational train) ranking:
+  - Spearman rho, Kendall tau-b (full-ranking rank correlation)
+  - top-5 / top-10 overlap (set overlap of the K most-sensitive layers)
+
+This produces the STABILITY signal only. It says nothing about held-out
+quality on its own -- that requires actually applying a small-calibration
+ranking's layer selection and measuring real MEMBRANE quality on held-out
+prompts, which is Task #97 (new inference, not reanalysis).
+"""
+import json
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+GEN = REPO / "results" / "phase11" / "generalization"
+OUT = REPO / "results" / "phase11" / "model-specific-policy"
+
+
+def spearman_rho(a, b):
+    n = len(a)
+    rank_a = {v: i for i, v in enumerate(a)}
+    rank_b = {v: i for i, v in enumerate(b)}
+    d2sum = sum((rank_a[k] - rank_b[k]) ** 2 for k in rank_a)
+    return 1.0 - (6.0 * d2sum) / (n * (n * n - 1))
+
+
+def kendall_tau(a, b):
+    n = len(a)
+    rank_a = {v: i for i, v in enumerate(a)}
+    rank_b = {v: i for i, v in enumerate(b)}
+    items = list(rank_a.keys())
+    concordant = 0
+    discordant = 0
+    for i in range(n):
+        for j in range(i + 1, n):
+            xi, xj = rank_a[items[i]], rank_a[items[j]]
+            yi, yj = rank_b[items[i]], rank_b[items[j]]
+            s = (xi - xj) * (yi - yj)
+            if s > 0:
+                concordant += 1
+            elif s < 0:
+                discordant += 1
+    total = n * (n - 1) // 2
+    return (concordant - discordant) / total
+
+
+def topk_overlap(a, b, k):
+    return len(set(a[:k]) & set(b[:k])) / k
+
+
+def build_ranking(model_key, per_prompt, n_layer, calib_prompts):
+    sums = [0.0] * n_layer
+    for pname in calib_prompts:
+        by_layer = per_prompt[pname]["raw_by_layer"]
+        for i in range(n_layer):
+            sums[i] += by_layer[str(i)]["rel_l2_delta"]
+    means = [s / len(calib_prompts) for s in sums]
+    order = sorted(range(n_layer), key=lambda i: means[i], reverse=True)
+    return order
+
+
+def main():
+    calib = json.loads((OUT / "calibration_sizes.json").read_text())
+    if not calib.get("fixed_before_any_phase11d_ranking_or_quality_result"):
+        raise SystemExit("calibration_sizes.json missing pre-registration flag")
+    rankings = json.loads((GEN / "rankings.json").read_text())
+
+    n_layers = {"135m": 30, "360m": 32}
+    sizes = ["5", "10", "15", "21", "31"]
+
+    report = {
+        "schema_version": 1,
+        "phase": "11D",
+        "note": "Calibration-set-size stability analysis, pure reanalysis of Phase 11C raw data, no new inference.",
+        "pre_registration_file": "results/phase11/model-specific-policy/calibration_sizes.json",
+        "results": {},
+    }
+
+    for model_key in ("135m", "360m"):
+        n_layer = n_layers[model_key]
+        per_prompt = rankings[f"{model_key}_ctx2048"]["per_prompt_rankings"]
+        rankings_by_size = {}
+        for size in sizes:
+            prompts = calib["sizes"][size]
+            rankings_by_size[size] = build_ranking(model_key, per_prompt, n_layer, prompts)
+
+        ref31 = rankings_by_size["31"]
+        ref21 = rankings_by_size["21"]
+
+        per_size = {}
+        for size in sizes:
+            r = rankings_by_size[size]
+            per_size[size] = {
+                "ranking_most_sensitive_first": r,
+                "vs_size31": {
+                    "spearman_rho": spearman_rho(r, ref31),
+                    "kendall_tau": kendall_tau(r, ref31),
+                    "top5_overlap": topk_overlap(r, ref31, 5),
+                    "top10_overlap": topk_overlap(r, ref31, 10),
+                },
+                "vs_size21_train": {
+                    "spearman_rho": spearman_rho(r, ref21),
+                    "kendall_tau": kendall_tau(r, ref21),
+                    "top5_overlap": topk_overlap(r, ref21, 5),
+                    "top10_overlap": topk_overlap(r, ref21, 10),
+                },
+            }
+
+        report["results"][model_key] = per_size
+
+    out_path = OUT / "calibration_size_analysis.json"
+    out_path.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"wrote {out_path}")
+
+    for model_key in ("135m", "360m"):
+        print(f"\n{model_key}:")
+        for size in sizes:
+            v = report["results"][model_key][size]["vs_size31"]
+            print(f"  size={size:>2}  vs31: rho={v['spearman_rho']:.3f} tau={v['kendall_tau']:.3f} "
+                  f"top5={v['top5_overlap']:.2f} top10={v['top10_overlap']:.2f}")
+
+
+if __name__ == "__main__":
+    main()
