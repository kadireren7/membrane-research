@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""
+Phase 11D Task #97: held-out quality comparison across calibration sizes.
+Combines:
+  - NEW real membrane-kv-mixed-layer runs (135M, CPU, ctx=2048, gen=32,
+    10 held-out prompts never used in any ranking construction) for
+    calibration sizes 5 and 10, at Q8 budgets 8 and 15
+  - REUSED Phase 11C results for calibration size 21 (train) at the same
+    two budgets, taken directly from holdout_policy.json's
+    budget8_A_sensitivity / budget15_A_sensitivity records (A_sensitivity
+    IS the size-21 train ranking -- no rerun needed, exact same config)
+
+All three sizes' Q8-layer sets and mean_logit_rel_l2/top1/delta_nll on the
+identical 10 held-out prompts are reported side by side.
+"""
+import json
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+GEN = REPO / "results" / "phase11" / "generalization"
+OUT = REPO / "results" / "phase11" / "model-specific-policy"
+
+NEW_RUNS = {
+    ("5", 8): "/tmp/cal_size5_budget8.json",
+    ("5", 15): "/tmp/cal_size5_budget15.json",
+    ("10", 8): "/tmp/cal_size10_budget8.json",
+    ("10", 15): "/tmp/cal_size10_budget15.json",
+}
+
+
+def main():
+    cal = json.loads((OUT / "calibration_size_analysis.json").read_text())
+    hp = json.loads((GEN / "holdout_policy.json").read_text())
+    hp_by_config = {r["config_name"]: r for r in hp["results"]}
+
+    entries = []
+    for size in ("5", "10", "21"):
+        ranking = cal["results"]["135m"][size]["ranking_most_sensitive_first"]
+        for budget in (8, 15):
+            q8_layers = sorted(ranking[:budget])
+            if size == "21":
+                src = hp_by_config[f"budget{budget}_A_sensitivity"]
+                entries.append({
+                    "calibration_size": 21,
+                    "q8_budget": budget,
+                    "q8_layers": q8_layers,
+                    "mean_top1_preservation": src["mean_top1_preservation"],
+                    "mean_logit_rel_l2": src["mean_logit_rel_l2"],
+                    "mean_delta_nll": src["mean_delta_nll"],
+                    "n_holdout_prompts": src["n_holdout_prompts"],
+                    "source": "reused Phase 11C holdout_policy.json (budget{}_A_sensitivity, identical config, no rerun)".format(budget),
+                })
+            else:
+                data = json.loads(Path(NEW_RUNS[(size, budget)]).read_text())
+                agg = data["aggregate"]
+                entries.append({
+                    "calibration_size": int(size),
+                    "q8_budget": budget,
+                    "q8_layers": q8_layers,
+                    "mean_top1_preservation": agg["mean_top1_preservation"],
+                    "mean_logit_rel_l2": agg["mean_logit_rel_l2"],
+                    "mean_delta_nll": agg["mean_delta_nll"],
+                    "n_holdout_prompts": agg["n_prompts"],
+                    "source": "new membrane-kv-mixed-layer run, build-cpu-rc1, CPU, ctx=2048, gen_tokens=32",
+                })
+
+    report = {
+        "schema_version": 1,
+        "phase": "11D",
+        "model": "135m",
+        "note": (
+            "Held-out quality (10 held-out prompts, never touched during any "
+            "ranking construction) for calibration-set-size rankings at Q8 "
+            "budgets 8 and 15. Sizes 5 and 10 are new real inference; size 21 "
+            "is reused directly from Phase 11C's holdout_policy.json since "
+            "A_sensitivity there IS the size-21 train ranking at identical "
+            "config -- rerunning it would be redundant duplicate compute."
+        ),
+        "entries": entries,
+        "naive_layout_reference_at_budget8": {
+            "B_early_contiguous": hp_by_config["budget8_B_early_contiguous"]["mean_logit_rel_l2"],
+            "C_late_contiguous": hp_by_config["budget8_C_late_contiguous"]["mean_logit_rel_l2"],
+            "D_alternating": hp_by_config["budget8_D_alternating"]["mean_logit_rel_l2"],
+            "E_random": hp_by_config["budget8_E_random"]["mean_logit_rel_l2"],
+        },
+        "naive_layout_reference_at_budget15": {
+            "B_early_contiguous": hp_by_config["budget15_B_early_contiguous"]["mean_logit_rel_l2"],
+            "C_late_contiguous": hp_by_config["budget15_C_late_contiguous"]["mean_logit_rel_l2"],
+            "D_alternating": hp_by_config["budget15_D_alternating"]["mean_logit_rel_l2"],
+            "E_random": hp_by_config["budget15_E_random"]["mean_logit_rel_l2"],
+        },
+    }
+
+    out_path = OUT / "calibration_size_holdout_quality.json"
+    out_path.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"wrote {out_path}")
+    for e in entries:
+        print(f"  size={e['calibration_size']:>2} budget={e['q8_budget']:>2} "
+              f"rel_l2={e['mean_logit_rel_l2']:.4f} top1={e['mean_top1_preservation']:.4f}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/build_calibration_sizes.py b/scripts/build_calibration_sizes.py
new file mode 100644
index 0000000..fb7cfb2
--- /dev/null
+++ b/scripts/build_calibration_sizes.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""
+Phase 11D Section 5: PRE-REGISTER the calibration-prompt-subsets used for
+the calibration-set-size investigation, BEFORE any ranking, correlation, or
+quality metric is computed from them. This file must be run (and its output
+committed / inspected) before calibration_size_analysis.py is ever run.
+
+Selection rule (fixed by prompt LABELS and the category order already fixed
+in prompts.json since Phase 10C -- never by any Phase 11C/11D measurement):
+round-robin across the 11 categories in their prompts.json order, taking
+each category's train prompts in numeric-suffix order (_1 before _2).
+code_reasoning has only one train prompt (code_reasoning_1) and simply drops
+out of the second round. This produces a category-diverse prefix at every
+size instead of exhausting one category before touching the next.
+
+Sizes: 5, 10, 15, 21 (= the full pre-registered train set, Phase 11C's own
+train/holdout split) are prefixes of this round-robin train order. Size 31
+is the full 31-prompt set (all 21 train + all 10 holdout, appended in the
+holdout list's own prompts.json order) -- used ONLY as a data-ceiling
+reference ranking, never as a held-out-validated operational profile
+(there is no held-out data left once 31 prompts are used for calibration).
+"""
+import json
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+GEN = REPO / "results" / "phase11" / "generalization"
+OUT = REPO / "results" / "phase11" / "model-specific-policy"
+
+
+def main():
+    prompts = json.loads((GEN / "prompts.json").read_text())
+    categories = list(prompts["categories"].keys())
+    train = set(prompts["train_holdout_split"]["train"])
+    holdout_order = prompts["train_holdout_split"]["holdout"]
+
+    # round 1: each category's train prompt suffix _1 (in category order)
+    round1 = []
+    for cat in categories:
+        for name in prompts["categories"][cat]:
+            if name in train and name.endswith("_1"):
+                round1.append(name)
+                break
+    # round 2: each category's train prompt suffix _2 (in category order),
+    # skipping categories with no _2 train prompt (code_reasoning)
+    round2 = []
+    for cat in categories:
+        for name in prompts["categories"][cat]:
+            if name in train and name.endswith("_2"):
+                round2.append(name)
+                break
+
+    train_round_robin = round1 + round2
+    assert set(train_round_robin) == train, (set(train_round_robin), train)
+    assert len(train_round_robin) == 21, len(train_round_robin)
+
+    sizes = {
+        "5": train_round_robin[:5],
+        "10": train_round_robin[:10],
+        "15": train_round_robin[:15],
+        "21": train_round_robin[:21],
+        "31": train_round_robin + holdout_order,
+    }
+    assert len(sizes["31"]) == 31
+
+    doc = {
+        "schema_version": 1,
+        "phase": "11D",
+        "note": __doc__.strip(),
+        "selection_rule": (
+            "Round-robin across the 11 categories in prompts.json's own "
+            "fixed category order, train prompts only, numeric suffix _1 "
+            "before _2 within each category; code_reasoning (1 train "
+            "prompt) drops out after round 1. Sizes 5/10/15/21 are prefixes "
+            "of this 21-element order; size 31 appends the 10 holdout "
+            "prompts (in prompts.json's fixed holdout order) after all 21 "
+            "train prompts."
+        ),
+        "fixed_before_any_phase11d_ranking_or_quality_result": True,
+        "train_round_robin_order": train_round_robin,
+        "sizes": sizes,
+    }
+    OUT.mkdir(parents=True, exist_ok=True)
+    out_path = OUT / "calibration_sizes.json"
+    out_path.write_text(json.dumps(doc, indent=2) + "\n")
+    print(f"wrote {out_path}")
+    for k, v in sizes.items():
+        print(f"  size {k}: {v}")
+
+
+if __name__ == "__main__":
+    main()
