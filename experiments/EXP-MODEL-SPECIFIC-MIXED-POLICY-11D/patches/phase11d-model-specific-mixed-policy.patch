+#!/usr/bin/env python3
+"""
+Phase 11D Task #98: held-out naive-layout comparison for 360M, the exact
+same methodology Phase 11C ran for 135M (results/phase11/generalization/
+holdout_policy.json), just never run for 360M there. Consumes the raw
+per-config JSON emitted by run_360m_holdout_sweep.sh (10 held-out prompts,
+never touched by the train21 ranking construction).
+"""
+import json
+import subprocess
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+OUT = REPO / "results" / "phase11" / "model-specific-policy"
+RAW_PATH = Path("/tmp/claude-1000/-home-kadirerenaltintas-membrane/"
+                 "c73a6507-4d97-4c38-9698-232cbf51aef5/scratchpad/holdout_360m_raw.jsonl")
+
+
+def git_commit():
+    return subprocess.check_output(["git", "-C", str(REPO), "rev-parse", "HEAD"], text=True).strip()
+
+
+def main():
+    rows = [json.loads(l) for l in RAW_PATH.read_text().splitlines() if l.strip()]
+    assert len(rows) == 32, f"expected 32 configs, got {len(rows)}"
+
+    results = []
+    by_config = {}
+    for row in rows:
+        cfg = row["config_name"]
+        agg = row["raw"]["aggregate"]
+        entry = {
+            "config_name": cfg,
+            "q8_layer_count": row["raw"]["q8_layer_count"],
+            "kv_bytes": row["raw"]["theoretical_mixed_bytes"],
+            "mean_top1_preservation": agg["mean_top1_preservation"],
+            "mean_logit_rel_l2": agg["mean_logit_rel_l2"],
+            "mean_delta_nll": agg["mean_delta_nll"],
+            "n_holdout_prompts": agg["n_prompts"],
+        }
+        results.append(entry)
+        by_config[cfg] = entry
+
+    budgets = [4, 9, 13, 16, 21, 26]
+    sensitivity_vs_naive = {}
+    for b in budgets:
+        sens = by_config[f"budget{b}_A_sensitivity"]["mean_logit_rel_l2"]
+        naive_vals = [by_config[f"budget{b}_{tag}"]["mean_logit_rel_l2"]
+                      for tag in ("B_early_contiguous", "C_late_contiguous", "D_alternating", "E_random")]
+        best_naive = min(naive_vals)
+        sensitivity_vs_naive[str(b)] = {
+            "sensitivity_rel_l2": sens,
+            "best_naive_rel_l2": best_naive,
+            "sensitivity_beats_all_naive": sens < best_naive,
+        }
+
+    all_beat = all(v["sensitivity_beats_all_naive"] for v in sensitivity_vs_naive.values())
+
+    doc = {
+        "schema_version": 1,
+        "phase": "11D",
+        "note": ("Task #98: 360M held-out naive-layout comparison, same methodology as Phase 11C's "
+                 "holdout_policy.json (135M) -- A_sensitivity uses the real train21 ranking "
+                 "(profile_360m_train21.json), B/C/D/E are naive comparison layouts, all evaluated "
+                 "on the same 10 held-out prompts never touched during ranking construction."),
+        "provenance": {
+            "membrane_commit": git_commit(),
+            "model_identity": "SmolLM2-360M-Instruct-f16",
+            "backend": "CPU",
+            "context_size": 2048,
+            "random_seed": 42,
+            "q8_type": "Q8_0",
+            "q5_type": "Q5_1",
+        },
+        "train_ranking_used": {
+            "source": "results/phase11/model-specific-policy/profile_360m_train21.json",
+            "n_train_prompts": 21,
+            "metric": "rel_l2_delta_mean",
+        },
+        "layouts_evaluated": {
+            "A_sensitivity": "top-N most sensitive layers (by profile_360m_train21.json) stay Q8",
+            "B_early_contiguous": "layers [0, N) stay Q8",
+            "C_late_contiguous": "last N layers stay Q8",
+            "D_alternating": "every other layer, starting at 0",
+            "E_random": "deterministic seeded random (seed=42)",
+            "budget0_all_q5": "budget=0 endpoint",
+            "budget32_all_q8": "budget=32 endpoint",
+        },
+        "results": results,
+        "sensitivity_vs_naive_by_budget_rel_l2": sensitivity_vs_naive,
+        "headline_finding": (
+            f"On logit_rel_l2, the sensitivity-based (train21) policy beat every naive layout at "
+            f"{'every' if all_beat else 'most'} intermediate Q8-layer budget tested "
+            f"({', '.join(str(b) for b in budgets)}) on 360M, on prompts never used to build the ranking."
+        ),
+        "all_budgets_sensitivity_beats_all_naive": all_beat,
+    }
+
+    out_path = OUT / "holdout_policy_360m.json"
+    out_path.write_text(json.dumps(doc, indent=2) + "\n")
+    print(f"wrote {out_path}")
+    for b in budgets:
+        v = sensitivity_vs_naive[str(b)]
+        print(f"  budget={b:>2} sens={v['sensitivity_rel_l2']:.4f} best_naive={v['best_naive_rel_l2']:.4f} "
+              f"beats_all_naive={v['sensitivity_beats_all_naive']}")
+    print(f"all_budgets_sensitivity_beats_all_naive={all_beat}")
+
+
+if __name__ == "__main__":
+    main()
