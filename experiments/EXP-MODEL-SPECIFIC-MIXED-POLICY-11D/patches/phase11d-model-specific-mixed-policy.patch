index 0000000..0e6059b
--- /dev/null
+++ b/scripts/build_model_profile.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+"""
+Phase 11D Section 6/7: build a versioned model-specific offline sensitivity
+profile from Phase 11C's existing raw ablation data. No new inference --
+this is pure reanalysis of results/phase11/generalization/rankings.json
+(per-prompt, per-layer rel_l2/delta_nll/top1 deltas vs the all-Q8 baseline),
+restricted to the pre-registered TRAIN prompt subset only, so the profile
+can later be scored honestly against the untouched HOLDOUT prompts.
+
+Ranking metric: rel_l2_delta_mean, most-sensitive-first (highest mean
+degradation when that single layer is flipped to Q5 first). This is the
+same metric Phase 11C's summary.json identifies as the one with a clear,
+consistent held-out win ("YES, clearly on rel_l2") -- delta_nll and top1
+are computed and stored independently alongside it (never discarded), but
+are not combined into rel_l2 via any formula. There is no combined score
+in this profile: rank order is rel_l2_delta_mean alone.
+"""
+import json
+import hashlib
+import subprocess
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+GEN = REPO / "results" / "phase11" / "generalization"
+OUT = REPO / "results" / "phase11" / "model-specific-policy"
+
+FINGERPRINTS = {
+    "135m": {
+        "architecture": "llama",
+        "n_layer": 30,
+        "n_embd": 576,
+        "n_head": 9,
+        "n_head_kv": 3,
+        "n_embd_head": 64,
+    },
+    "360m": {
+        "architecture": "llama",
+        "n_layer": 32,
+        "n_embd": 960,
+        "n_head": 15,
+        "n_head_kv": 5,
+        "n_embd_head": 64,
+    },
+}
+
+MODEL_IDENTITY = {
+    "135m": "SmolLM2-135M-Instruct-f16",
+    "360m": "SmolLM2-360M-Instruct-f16",
+}
+
+
+def git_commit():
+    return subprocess.check_output(
+        ["git", "-C", str(REPO), "rev-parse", "HEAD"], text=True
+    ).strip()
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    h.update(p.read_bytes())
+    return h.hexdigest()
+
+
+def build_profile(model_key: str, prompts: dict, rankings: dict, calib_prompts, calib_label):
+    fp = FINGERPRINTS[model_key]
+    n_layer = fp["n_layer"]
+    ranking_key = f"{model_key}_ctx2048"
+    per_prompt = rankings[ranking_key]["per_prompt_rankings"]
+
+    covered = set(rankings[ranking_key]["prompts_covered"])
+    missing = set(calib_prompts) - covered
+    if missing:
+        raise SystemExit(f"{model_key}: calibration prompts not covered by raw data: {missing}")
+
+    sums = {i: {"rel_l2_delta": 0.0, "delta_nll_delta": 0.0, "top1_loss": 0.0} for i in range(n_layer)}
+    n = len(calib_prompts)
+    for pname in calib_prompts:
+        by_layer = per_prompt[pname]["raw_by_layer"]
+        for i in range(n_layer):
+            rec = by_layer[str(i)]
+            sums[i]["rel_l2_delta"] += rec["rel_l2_delta"]
+            sums[i]["delta_nll_delta"] += rec["delta_nll_delta"]
+            sums[i]["top1_loss"] += rec["top1_loss"]
+
+    per_layer = []
+    for i in range(n_layer):
+        per_layer.append({
+            "layer": i,
+            "rel_l2_delta_mean": sums[i]["rel_l2_delta"] / n,
+            "delta_nll_delta_mean": sums[i]["delta_nll_delta"] / n,
+            "top1_loss_mean": sums[i]["top1_loss"] / n,
+        })
+
+    ranking_most_sensitive_first = [
+        rec["layer"] for rec in sorted(per_layer, key=lambda r: r["rel_l2_delta_mean"], reverse=True)
+    ]
+
+    profile = {
+        "schema_version": 1,
+        "phase": "11D",
+        "note": (
+            "Model-specific offline sensitivity profile. RESEARCH ARTIFACT ONLY "
+            "-- not consumed by any product CLI, --kv mixed does not exist as a "
+            "public flag. Built by pure reanalysis of Phase 11C raw ablation "
+            "data (results/phase11/generalization/), zero new inference. "
+            "Ranking metric is rel_l2_delta_mean alone (most-sensitive-first); "
+            "delta_nll_delta_mean and top1_loss_mean are independent raw "
+            "metrics preserved alongside it, not combined into any formula."
+        ),
+        "model_identity": MODEL_IDENTITY[model_key],
+        "model_fingerprint": fp,
+        "calibration": {
+            "label": calib_label,
+            "n_prompts": n,
+            "prompts": calib_prompts,
+            "source": "results/phase11/generalization/prompts.json train_holdout_split"
+                      if calib_label == "train21" else
+                      "results/phase11/generalization/prompts.json (pre-registered subset selection, see calibration_size_analysis.json)",
+        },
+        "ranking_metric": "rel_l2_delta_mean",
+        "ranking_most_sensitive_first": ranking_most_sensitive_first,
+        "per_layer_raw_metrics": per_layer,
+        "provenance": {
+            "membrane_commit": git_commit(),
+            "source_rankings_file": "results/phase11/generalization/rankings.json",
+            "source_rankings_sha256": sha256_file(GEN / "rankings.json"),
+            "source_prompts_file": "results/phase11/generalization/prompts.json",
+            "generated_by": "scripts/build_model_profile.py",
+        },
+    }
+    return profile
+
+
+def main():
+    prompts = json.loads((GEN / "prompts.json").read_text())
+    rankings = json.loads((GEN / "rankings.json").read_text())
+    train = prompts["train_holdout_split"]["train"]
+
+    OUT.mkdir(parents=True, exist_ok=True)
+    for model_key in ("135m", "360m"):
+        profile = build_profile(model_key, prompts, rankings, train, "train21")
+        out_path = OUT / f"profile_{model_key}_train21.json"
+        out_path.write_text(json.dumps(profile, indent=2) + "\n")
+        print(f"wrote {out_path} ({len(profile['ranking_most_sensitive_first'])} layers)")
+
+    # cross-check against Phase 11C's existing 135M train-derived ranking
+    # (holdout_policy.json), which was computed independently at the time.
+    hp = json.loads((GEN / "holdout_policy.json").read_text())
+    existing = hp["train_ranking_used"]["ranking_most_sensitive_first"]
+    fresh = json.loads((OUT / "profile_135m_train21.json").read_text())["ranking_most_sensitive_first"]
+    if existing == fresh:
